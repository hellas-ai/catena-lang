# The wr barrier requires own, but this call supplies read.
(def program sync-that-uses-the-wrong-precondition : {[
  grid-topology block-name.
]
  ({[.block-name] ({[.grid-topology block-name]} gpu.block)} :)
  ({
    [.grid-topology]
    ({
      ({
        gpu.tiled.wr
        ({[.grid-topology block-name block-name]} gpu.shared.owns |-)
        ({[.grid-topology block-name]} gpu.shared.reads |-)
      }
        gpu.barrier.step)
      gpu.barrier.trace.end
    } gpu.barrier.trace.sync)
  } gpu.barrier.cursor |-)
  ({[.grid-topology block-name]} gpu.shared.reads |-)
} -> {[grid-topology block-name.]
  ({[.block-name] ({[.grid-topology block-name]} gpu.block)} :)
  ({[.grid-topology] gpu.barrier.trace.end} gpu.barrier.cursor |-)
  ({[.grid-topology block-name]} gpu.shared.reads |-)
} = gpu.sync)
