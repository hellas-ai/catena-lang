# Shapes describe coordinate bounds and preserve their logical rank.
(theory type nat {
  (arr shape.1d : 1 -> 1)
  (arr shape.2d : 2 -> 1)
  (arr shape.3d : 3 -> 1)
  (arr ix : 1 -> 1)
})

(theory program type {
  # Reveal the bound carried by a one-dimensional shape. This is type-level
  # information and is erased before code generation.
  (arr shape.1d.size : {[size.]
    ({[.size]} shape.1d)
  } -> {[size.]
    [.size]
  })

  (arr ix.copies2 : {[index-shape.]
    ([.index-shape] ix val)
  } -> {[index-shape.]
    ([.index-shape] ix val)
    ([.index-shape] ix val)
  })

  (arr ix.forget : {[index-shape.]
    ([.index-shape] ix val)
  } -> ([index-shape.] []))

  (arr ix.2d.from-components : {[first-size second-size.]
    ({({[.first-size]} shape.1d)} ix val)
    ({({[.second-size]} shape.1d)} ix val)
  } -> {[first-size second-size.]
    ({({[.first-size second-size]} shape.2d)} ix val)
  })

  (arr ix.2d.split : {[first-size second-size.]
    ({({[.first-size second-size]} shape.2d)} ix val)
  } -> {[first-size second-size.]
    ({({[.first-size]} shape.1d)} ix val)
    ({({[.second-size]} shape.1d)} ix val)
  })

  # A one-dimensional index is already a scalar coordinate. Higher-rank
  # indices require an explicit layout operation before becoming an offset.
  (arr ix.1d.value : {[index-size.]
    ({({[.index-size]} shape.1d)} ix val)
  } -> {[index-size.]
    (u64 val)
  })

  # Refine a scalar into a bounded one-dimensional index.
  (arr u64.to-ix : {[index bound.]
    ({[.index] u64} :)
    ({[.bound] u64} :)
    ([.index bound] u64.lt |-)
  } -> {[index bound.]
    ({[.index] ({({[.bound]} shape.1d)} ix)} :)
  })
})
