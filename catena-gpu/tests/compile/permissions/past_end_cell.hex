# The first index past the buffer is its length. A raw u64 carrying that value
# cannot be used as the bounded buffer index required by can-own.

(def program permission-for-past-end-cell-kernel : {[
  buffer-id buffer-size grid-shape block-shape global-shape global-size
  schedule-id.
]
  ({[.buffer-size] u64} :)
  [.buffer-id]
  [.grid-shape]
  [.block-shape]
  [.global-shape]
  [.global-size]
  [.schedule-id]
  ({[.buffer-id] ({cap.own [.buffer-size] u64} gpu.global)} :)
  ({({[.grid-shape block-shape global-shape global-size]} gpu.grid)}
    gpu.thread val)
  ({
    [.buffer-id buffer-size]
    ({[.grid-shape block-shape global-shape global-size]} gpu.grid)
    [.schedule-id]
  } gpu.scheduling val)
} -> {[
  buffer-id buffer-size grid-shape block-shape global-shape global-size
  schedule-id.
]
  ({
    [.buffer-id buffer-size]
    ({[.grid-shape block-shape global-shape global-size]} gpu.grid)
    [.schedule-id]
  } gpu.scheduling val)
} = ([buffer-length buffer-id grid-shape block-shape global-shape global-size
  schedule-id buffer thread scheduling.]
  ([.buffer-length] :.forget [past-end-cell.])
  ({[.scheduling thread past-end-cell]}
    gpu.scheduling.can-own
    [scheduling-after _thread-after _cell-after _decision _owns _not-owns.])
  ([.buffer] gpu.global.forget)
  [.scheduling-after]
))
