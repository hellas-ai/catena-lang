# Parallel runners
(theory type nat {
  # A host submits work to a worker population. A worker runs inside one.
  # A worker additionally carries the type of its topology-shaped index.
  (arr host : 3 -> 1)
  (arr worker : 4 -> 1)
})

(theory program type {
  # Build a host runner from topology-specific metadata and runtime
  # parameters. The metadata is type-level and erases before codegen.
  (arr parallel.host : {[
    level workers groups parameters.
  ]
    [.level]
    [.workers]
    [.groups]
    [.parameters]
  }
  ->
  ([level workers groups parameters.]
    ({[.level workers groups]} host)))

  # Expose this worker's topology-shaped index while preserving the worker.
  # The index object may be a product, such as Ix n * Ix m for a 2D level.
  (arr parallel.worker.index : {[level workers groups index.]
    ({[.level workers groups index]} worker)
  }
  ->
  ([level workers groups index.] {
    ({[.level workers groups index]} worker)
    [.index]
  }))

  # Re-scope a parent worker around a child-topology index. The child topology
  # metadata is explicit, so constructing a worker cannot invent an
  # unconstrained level.
  (arr parallel.worker : {[parent level workers groups index.]
    [.parent]
    [.level]
    [.workers]
    [.groups]
    [.index]
  }
  ->
  ([parent level workers groups index.]
    ({[.level workers groups index]} worker)))

  # Allocate an owned f32 buffer through a host or worker runner.
  (arr parallel.allocate : {[runner n.]
    [.runner]
    ({[.n] u64} :)
  }
  ->
  ([runner n.] {
    [.runner]
    ({
      [.runner]
      ({cap.own [.n] f32} buf)
    } writable val)
  }))

  # Synchronize after writes to two buffers, making both visible to this
  # runner's workers with one synchronization event. The bare buffers lose
  # their runner associations together.
  (arr parallel.await : {[runner a-cap a-n b-cap b-n.]
    [.runner]
    ({
      [.runner]
      ({[.a-cap a-n] f32} buf)
    } pending val)
    ({
      [.runner]
      ({[.b-cap b-n] f32} buf)
    } pending val)
  }
  ->
  ([runner a-cap a-n b-cap b-n.] {
    [.runner]
    ({[.a-cap a-n] f32} buf val)
    ({[.b-cap b-n] f32} buf val)
  }))

  # Single-buffer form used when only one pending result must become visible.
  (arr parallel.await-one : {[runner cap n.]
    [.runner]
    ({
      [.runner]
      ({[.cap n] f32} buf)
    } pending val)
  }
  ->
  ([runner cap n.] {
    [.runner]
    ({[.cap n] f32} buf val)
  }))

  # Synchronize after reads. This must wait for slower readers before another
  # iteration writes into shared storage. TODO: track the released buffers in
  # the type once buffer ownership is threaded back out of reader closures.
  (arr parallel.release :
    ([runner.] [.runner]) -> ([runner.] [.runner]))

  # Synchronize workers through one runner without changing buffer state.
  (arr parallel.barrier :
    ([runner.] [.runner]) -> ([runner.] [.runner]))

  # Materialize a logical output space through a runner. The worker count
  # and output count are intentionally independent; the scheduling policy maps
  # logical work items to physical workers. task-worker makes the worker passed
  # to the producer explicit for both host launches and worker cooperation.
  (arr parallel.materialize : {[
    runner task-worker output-count.
  ]
    [.runner]
    ({
      [.runner]
      ({cap.own [.output-count] f32} buf)
    } writable val)
    ({
      ({
        [.task-worker]
        ([.output-count] ix val)
      } *)
      (f32 val)
    } =>)
  }
  ->
  ([runner task-worker output-count.] {
    [.runner]
    ({
      [.runner]
      ({cap.own [.output-count] f32} buf)
    } pending val)
  }))

  # Closure-converted form of parallel.materialize. The producer's captured
  # environment and function pointer replace its source-level closure value.
  (arr parallel.materializec : {[
    environment runner task-worker output-count.
  ]
    [.runner]
    ({
      [.runner]
      ({cap.own [.output-count] f32} buf)
    } writable val)
    ([.environment])
    ({
      ({
        ([.environment])
        ({
          [.task-worker]
          ([.output-count] ix val)
        } *)
      } *)
      (f32 val)
    } -> val)
  }
  ->
  ([environment runner task-worker output-count.] {
    [.runner]
    ({
      [.runner]
      ({cap.own [.output-count] f32} buf)
    } pending val)
  }))
})
