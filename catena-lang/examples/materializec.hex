# create a buffer from an index function
(def program materialize-index-producer :
  ([n.] {1 ([.n] ix val)})
  ->
  ([n.] (u64 val))
= ([env i.] u64.one))

(def program materialize-indexes :
  ({[n] u64} :)
  ->
  ([n.] (cap.own mem))
= ([len.]
  {
    [.len]
    ({[.len] unit.intro (([.len] :.param) name.materialize-index-producer)}
      materializec)
  }
  buf.to-mem
))

# Copy a u64 buffer 
(def program materialize-copy-u64-producer :
  ([n.] {({cap.ref [.n] u64} buf val) ([.n] ix val)})
  ->
  ([n.] (u64 val))
= ([input i.]
  {[.i input]} ix
))

(def program materialize-copy-u64 :
  (cap.ref mem)
  ->
  (cap.own mem)
= (
  mem.cast.u64
  [len input.]
    {
      [.len]
      ({[.len] [.input] (([.len] :.param) name.materialize-copy-u64-producer)}
        materializec)
    }
    buf.to-mem
))

# Fill a selected range of an existing owned F32 buffer with its local index.
(def program materialize-into-f32-producer :
  ([n.] {(u64 val) ([.n] ix val)})
  ->
  ([n.] (f32 val))
= ([_offset i.]
  ([.i] ix.to-u64 u64.to-f32)
))

(def program materialize-into-f32 :
  {(cap.own mem) (u64 val) (u64 val)}
  ->
  (cap.own mem)
= ([memory offset len.]
  ([.memory] mem.cast.f32 [capacity buffer.])
  ([.len] u64.name [named-len.])
  {
    [.buffer]
    [.capacity]
    [.offset]
    [.named-len]
    [.offset]
    (([.named-len] :.param) name.materialize-into-f32-producer)
  } materializec.into [filled.]
  ({[.capacity] [.filled]} buf.to-mem)
))

# Copy a prefix while returning the owner of the source allocation. The source
# reference exists only inside the materialization primitive.
(def program materialize-borrow-f32-producer :
  ([capacity n.] {
    ({cap.ref [.capacity] f32} buf val)
    ({({[.capacity] u64} :) ([.n] ix val)} *)
  })
  ->
  ([capacity n.] (f32 val))
= ([input env.]
  ([.env] *.elim [capacity-value i.])
  ([.i] ix.to-u64 [raw-index.])
  ([.raw-index] u64.name [named-index.])
  ([.capacity-value named-index] u64.gt [in-bounds if-in-bounds _if-out-of-bounds.])
  ([.in-bounds if-in-bounds] assert-then [proof.])
  ([.named-index capacity-value proof] u64.to-ix [index.])
  ({[.index input]} ix)
))

(def program materialize-borrow-f32 :
  {(cap.own mem) (u64 val)}
  ->
  {(cap.own mem) (cap.own mem)}
= ([memory len.]
  ([.memory] mem.cast.f32 [capacity buffer.])
  ([.len] u64.name [named-len.])
  {
    [.buffer]
    [.capacity]
    [.named-len]
    [.capacity]
    ({
      ([.capacity] :.param)
      ([.named-len] :.param)
    } name.materialize-borrow-f32-producer)
  } materializec.borrow [buffer-after copied.]
  {
    ({[.capacity] [.buffer-after]} buf.to-mem)
    ({[.named-len] [.copied]} buf.to-mem)
  }
))

(def program materialize-reduce-f32-term :
  ([n k.] {
    ({({(cap.ref mem) (u64 val)} *) ({([.n] ix val) ([.k] ix val)} *)} *)
  })
  ->
  ([n k.] (f32 val))
= ([env.]
  ([.env] *.elim [inputs indices.])
  ([.inputs] *.elim [memory columns.])
  ([.indices] *.elim [row-index column-index.])
  ([.row-index] ix.to-u64 [row.])
  ([.column-index] ix.to-u64 [column.])
  ([.row columns] u64.mul [row-offset.])
  ([.row-offset column] u64.add [flat-index.])
  ([.memory] mem.cast.f32 [element-count buffer.])
  ([.flat-index] u64.name [named-index.])
  ([.element-count named-index] u64.gt [in-bounds if-in-bounds _if-out-of-bounds.])
  ([.in-bounds if-in-bounds] assert-then [proof.])
  ([.named-index element-count proof] u64.to-ix [index.])
  ({[.index buffer]} ix)
))

(def program materialize-reduce-f32-identity-epilogue :
  ([n.] {({({(cap.ref mem) (u64 val)} *) ({([.n] ix val) (f32 val)} *)} *)})
  ->
  ([n.] (f32 val))
= ([env.]
  ([.env] *.elim [_inputs index-and-sum.])
  ([.index-and-sum] *.elim [_index sum.])
  [.sum]
))

(def program materialize-reduce-f32-rows :
  {(cap.ref mem) (u64 val) (u64 val)}
  ->
  (cap.own mem)
= ([memory rows columns.]
  ([.rows] u64.name [named-rows.])
  ([.columns] u64.name [named-columns.])
  ({[.memory] [.columns]} *.intro [env.])
  {
    [.named-rows]
    [.named-columns]
    [.env]
    ({
      ([.named-rows] :.param)
      ([.named-columns] :.param)
    } name.materialize-reduce-f32-term)
    (([.named-rows] :.param) name.materialize-reduce-f32-identity-epilogue)
  } materializec.reduce-f32 [output.]
  ({[.named-rows] [.output]} buf.to-mem)
))

(def program materialize-reduce-f32-pair-term :
  ([n k.] {
    ({({(cap.ref mem) (u64 val)} *) ({([.n] ix val) ([.k] ix val)} *)} *)
  })
  ->
  ([n k.] ({(f32 val) (f32 val)} *))
= ([arguments.]
  ([.arguments] materialize-reduce-f32-term [value.])
  ({[.value] [.value]} *.intro)
))

(def program materialize-reduce-f32-pair-epilogue :
  ([n.] {
    ({
      ({(cap.ref mem) (u64 val)} *)
      ({([.n] ix val) ({(f32 val) (f32 val)} *)} *)
    } *)
  })
  ->
  ([n.] ({(f32 val) (f32 val)} *))
= ([arguments.]
  ([.arguments] *.elim [_inputs index-and-sums.])
  ([.index-and-sums] *.elim [_index sums.])
  [.sums]
))

(def program materialize-reduce-f32-pair-rows :
  {(cap.ref mem) (u64 val) (u64 val)}
  ->
  {(cap.own mem) (cap.own mem)}
= ([memory rows columns.]
  ([.rows] u64.name [named-rows.])
  ([.columns] u64.name [named-columns.])
  ({[.memory] [.columns]} *.intro [env.])
  {
    [.named-rows]
    [.named-columns]
    [.env]
    ({
      ([.named-rows] :.param)
      ([.named-columns] :.param)
    } name.materialize-reduce-f32-pair-term)
    (([.named-rows] :.param) name.materialize-reduce-f32-pair-epilogue)
  } materializec.reduce-f32-pair [left right.]
  {
    ({[.named-rows] [.left]} buf.to-mem)
    ({[.named-rows] [.right]} buf.to-mem)
  }
))

# A deliberately simple stand-in for exp used to test the softmax primitive:
# shifted + 2 maps row [0, 1, 2] to numerators [0, 1, 2].
(def program materialize-softmax-f32-exp : (f32 val) -> (f32 val)
= ([shifted.]
  (const.u32.0x40000000 u32.bitcast-f32 [two.])
  ([.shifted two] f32.add)
))

(def program materialize-softmax-f32-rows :
  {(cap.own mem) (u64 val)}
  ->
  (cap.own mem)
= ([memory columns.]
  ([.memory] mem.cast.f32 [element-count buffer.])
  {
    [.buffer]
    [.element-count]
    [.columns]
    name.materialize-softmax-f32-exp
  } materializec.softmax-f32 [output.]
  ({[.element-count] [.output]} buf.to-mem)
))

(def program materialize-borrow-reduce-f32-term :
  ([capacity n k.] {
    ({cap.ref [.capacity] f32} buf val)
    ({
      ({({[.capacity] u64} :) (u64 val)} *)
      ({([.n] ix val) ([.k] ix val)} *)
    } *)
  })
  ->
  ([capacity n k.] (f32 val))
= ([input env.]
  ([.env] *.elim [inputs indices.])
  ([.inputs] *.elim [capacity-value columns.])
  ([.indices] *.elim [row-index column-index.])
  ([.row-index] ix.to-u64 [row.])
  ([.column-index] ix.to-u64 [column.])
  ([.row columns] u64.mul [row-offset.])
  ([.row-offset column] u64.add [flat-index.])
  ([.flat-index] u64.name [named-index.])
  ([.capacity-value named-index] u64.gt [in-bounds if-in-bounds _if-out-of-bounds.])
  ([.in-bounds if-in-bounds] assert-then [proof.])
  ([.named-index capacity-value proof] u64.to-ix [index.])
  ({[.index input]} ix)
))

(def program materialize-borrow-reduce-f32-epilogue :
  ([capacity n.] {
    ({cap.ref [.capacity] f32} buf val)
    ({
      ({({[.capacity] u64} :) (u64 val)} *)
      ({([.n] ix val) (f32 val)} *)
    } *)
  })
  ->
  ([capacity n.] (f32 val))
= ([_input env.]
  ([.env] *.elim [_inputs index-and-sum.])
  ([.index-and-sum] *.elim [_index sum.])
  [.sum]
))

(def program materialize-borrow-reduce-f32-rows :
  {(cap.own mem) (u64 val) (u64 val)}
  ->
  {(cap.own mem) (cap.own mem)}
= ([memory rows columns.]
  ([.memory] mem.cast.f32 [capacity buffer.])
  ([.rows] u64.name [named-rows.])
  ([.columns] u64.name [named-columns.])
  ({[.capacity] [.columns]} *.intro [env.])
  {
    [.buffer]
    [.capacity]
    [.named-rows]
    [.named-columns]
    [.env]
    ({
      ([.capacity] :.param)
      ([.named-rows] :.param)
      ([.named-columns] :.param)
    } name.materialize-borrow-reduce-f32-term)
    ({
      ([.capacity] :.param)
      ([.named-rows] :.param)
    } name.materialize-borrow-reduce-f32-epilogue)
  } materializec.borrow-reduce-f32 [buffer-after output.]
  {
    ({[.capacity] [.buffer-after]} buf.to-mem)
    ({[.named-rows] [.output]} buf.to-mem)
  }
))

(def program materialize-borrow-argmax-f32 :
  (cap.own mem)
  ->
  {(cap.own mem) (cap.own mem)}
= ([memory.]
  ([.memory] mem.cast.f32 [element-count buffer.])
  (const.u64.0x0000000000000001 u64.name [one.])
  {
    [.buffer]
    [.element-count]
    [.one]
  } materializec.borrow-argmax-f32 [buffer-after index.]
  {
    ({[.element-count] [.buffer-after]} buf.to-mem)
    ({[.one] [.index]} buf.to-mem)
  }
))

(def program materialize-borrow-topk-f32 :
  (cap.own mem)
  ->
  {(cap.own mem) (cap.own mem)}
= ([memory.]
  ([.memory] mem.cast.f32 [element-count buffer.])
  (const.u64.0x0000000000000002 u64.name [rows.])
  (const.u64.0x0000000000000010 u64.name [output-count.])
  (const.u64.0x0000000000000008 [columns.])
  (const.u64.0x0000000000000008 [k.])
  {
    [.buffer]
    [.element-count]
    [.rows]
    [.output-count]
    [.columns]
    [.k]
  } materializec.borrow-topk-f32 [buffer-after indices.]
  {
    ({[.element-count] [.buffer-after]} buf.to-mem)
    ({[.output-count] [.indices]} buf.to-mem)
  }
))

(def program materialize-borrow-topk-f32-dynamic :
  {(cap.own mem) (u64 val) (u64 val) (u64 val)}
  ->
  {(cap.own mem) (cap.own mem)}
= ([memory rows columns k.]
  ([.memory] mem.cast.f32 [element-count buffer.])
  ([.rows] u64.name [named-rows.])
  ([.rows k] u64.mul [output-count-value.])
  ([.output-count-value] u64.name [output-count.])
  {
    [.buffer]
    [.element-count]
    [.named-rows]
    [.output-count]
    [.columns]
    [.k]
  } materializec.borrow-topk-f32 [buffer-after indices.]
  {
    ({[.element-count] [.buffer-after]} buf.to-mem)
    ({[.output-count] [.indices]} buf.to-mem)
  }
))

(def program materialize-borrow-routed-bf16-gemv-pair :
  {(cap.own mem) (cap.ref mem) (cap.ref mem) (cap.own mem)}
  ->
  {(cap.own mem) (cap.own mem) (cap.own mem) (cap.own mem)}
= ([input gate-weight up-weight selected.]
  ([.input] mem.cast.f32 [input-count input-buffer.])
  ([.gate-weight] mem.cast.bf16 [gate-count gate-buffer.])
  ([.up-weight] mem.cast.bf16 [up-count up-buffer.])
  ([.selected] mem.cast.u64 [selected-count selected-buffer.])
  (const.u64.0x0000000000000004 u64.name [output-count.])
  (const.u64.0x0000000000000004 u64.name [reduction-count.])
  (const.u64.0x0000000000000001 [slots.])
  (const.u64.0x0000000000000002 [output-features.])
  {
    [.input-buffer]
    [.input-count]
    [.gate-buffer]
    [.gate-count]
    [.up-buffer]
    [.up-count]
    [.selected-buffer]
    [.selected-count]
    [.output-count]
    [.reduction-count]
    [.slots]
    [.output-features]
  } materializec.borrow-routed-bf16-gemv-pair
    [input-after selected-after gate-output up-output.]
  {
    ({[.input-count] [.input-after]} buf.to-mem)
    ({[.selected-count] [.selected-after]} buf.to-mem)
    ({[.output-count] [.gate-output]} buf.to-mem)
    ({[.output-count] [.up-output]} buf.to-mem)
  }
))
