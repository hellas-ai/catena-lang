# Minimal end-to-end CapturedClosure dependency. Each partially applied helper
# produces a closure which captures two other closure values. Those producer
# regions must be converted before the capturing region builds its environment.

(def program choose-closure :
  {
    ({(bool val) (bool val)} =>)
    ({(bool val) (bool val)} =>)
    (bool val)
    (bool val)
  }
  ->
  (bool val)
= ([left right flag argument.]
  {[.left] [.right] [.flag] [.argument]}
  bool.if
))

(def program closure-capture-order :
  {(bool val) (bool val) (bool val) (bool val)}
  ->
  (bool val)
= ([left-flag right-flag argument choice-flag.]
  {
    ({
      (name.bool.id lift)
      (name.bool.not lift)
      [.left-flag]
    } partial.choose-closure.3)
    ({
      (name.bool.not lift)
      (name.bool.id lift)
      [.right-flag]
    } partial.choose-closure.3)
    [.choice-flag]
    [.argument]
  }
  bool.if
))
