################################################################################
# Indices
(theory type nat {
  # indices
  # `ix n` is a valid index into any `buf m n t`.
  (arr ix : 1 -> 1)

  # Numerics (TODO!)
  (arr 0 : 0 -> 1)
  (arr > : 2 -> 1)
})

(theory program type {
  # indexing buffers
  # val(ix n) ● val(buf m n t) -> val(t)
  (arr ix : {[m n t.] ([.n] ix val) ([.m n t] buf val)} -> ([m n t . t] val))

  # Forget the index wrapper and expose the underlying runtime u64.
  (arr ix.to-u64 : ([n.] ([.n] ix val)) -> ([n.] (u64 val)))

  # Refine an already-proven in-bounds u64 into an index for a buffer of
  # length n.
  (arr u64.to-ix : {[x n.]
    ({[.x] u64} :)
    ({[.n] u64} :)
    ([.n x] > |-)
  } -> ([x n.] ([.n] ix val)))

  # the zero index
  # ix.zero : (|- n > 0) -> val(ix n)
  (arr ix.zero : ({[n] 0} > |-) -> (ix val))

  (def ix.copy :
    ([n.] ([.n] ix val))
    ->
    ([n.] {([.n] ix val) ([.n] ix val)})
    =
    ([i.] {[.i] [.i]})
  )

  # Reduce an index modulo n and retain the resulting Ix n bound.
  (def ix.rem :
    ([x n.] {
      ({[.n] u64} :)
      ([.x] ix val)
    })
    ->
    ([x n.] ([.n] ix val))
  = {[modulus index.]
    ([.modulus] u64.copies2 [rem-modulus bound.]
      ([.index] ix.to-u64 [coordinate.]
        ({[.coordinate] ([.rem-modulus] :.forget)} u64.rem [remainder.]
          ([.remainder] u64.name [named-remainder.]
            ({[.bound] [.named-remainder]} u64.gt
              [within-bound if-within-bound _if-out-of-bound.]
              ([.within-bound if-within-bound] assert-then [bound-proof.]
                ({[.named-remainder] [.bound] [.bound-proof]} u64.to-ix)
              )
            )
          )
        )
      )
    )
  })

  # Row-major layout helpers for flattened matrix buffers.
  # These operations are common enough that we define them as primitives instead
  # of proving their arithmetic with inline certificates at each use site.
  # row-major-index(cols, row, col) -> flat
  (arr row-major-index :
    ([n k.] {
      ({[.k] u64} :)
      ({([.n] ix val) ([.k] ix val)} *)
    })
    ->
    ([n k.] (({[.n] [.k]} *) ix val)))

  # row-major-row(cols, flat) -> row
  (arr row-major-row :
    ([n m.] {
      ({[.m] u64} :)
      (({[.n] [.m]} *) ix val)
    })
    ->
    ([n m.] ([.n] ix val)))

  # row-major-col(cols, flat) -> col
  (arr row-major-col :
    ([n m.] {
      ({[.m] u64} :)
      (({[.n] [.m]} *) ix val)
    })
    ->
    ([n m.] ([.m] ix val)))

  # Replace the position within the tile containing `coordinate`:
  # (coordinate / tile-size) * tile-size + local.
  (arr ix.same-tile-coordinate : {[n tile-size.]
    ({[.tile-size] u64} :)
    ([.n] ix val)
    ([.tile-size] ix val)
  } -> ([n tile-size.] ([.n] ix val)))

  # Select a position within a numbered tile:
  # tile-index * tile-size + local. Perfect tiling guarantees the result is
  # within n.
  (arr ix.tile-offset-coordinate : {[n tile-size.]
    ({[.n] u64} :)
    ({[.tile-size] u64} :)
    (u64 val)
    ([.tile-size] ix val)
  } -> ([n tile-size.] ([.n] ix val)))

})
