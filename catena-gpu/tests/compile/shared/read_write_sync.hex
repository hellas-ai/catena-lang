(def program guarded-shared-write-preserves-cell-ownership : {[
  grid-topology block-name shared-name slot-name buffer-size phase schedule-name
  thread-name cell-index.
]
  ({[.thread-name] ([.grid-topology] gpu.thread)} :)
  ({[.block-name]
    ({[.grid-topology block-name]} gpu.block)} :)
  ({[.shared-name]
    ({[.shared-name block-name slot-name buffer-size] u64} gpu.shared)} :)
  ({[.cell-index] ({({[.buffer-size]} shape.1d)} ix)} :)
  (u64 val)
  ({[.schedule-name thread-name cell-index shared-name]}
    gpu.shared.assigned |-)
  ({[.phase thread-name cell-index shared-name]} gpu.shared.owns |-)
} -> {[
  grid-topology block-name shared-name slot-name buffer-size phase schedule-name
  thread-name cell-index.
]
  ({[.thread-name] ([.grid-topology] gpu.thread)} :)
  ({[.block-name]
    ({[.grid-topology block-name]} gpu.block)} :)
  ({[.shared-name]
    ({[.shared-name block-name slot-name buffer-size] u64} gpu.shared)} :)
  ({[.cell-index] ({({[.buffer-size]} shape.1d)} ix)} :)
  ({[.schedule-name thread-name cell-index shared-name]}
    gpu.shared.assigned |-)
  ({[.phase thread-name cell-index shared-name]} gpu.shared.owns |-)
} = gpu.shared.write)

(def program guarded-shared-read-preserves-whole-buffer-read-permission : {[
  grid-topology block-name shared-name slot-name buffer-size phase thread-name cell-index.
]
  ({[.thread-name] ([.grid-topology] gpu.thread)} :)
  ({[.block-name]
    ({[.grid-topology block-name]} gpu.block)} :)
  ({[.shared-name]
    ({[.shared-name block-name slot-name buffer-size] u64} gpu.shared)} :)
  ({[.cell-index] ({({[.buffer-size]} shape.1d)} ix)} :)
  ({[.phase thread-name shared-name]} gpu.shared.reads |-)
} -> {[
  grid-topology block-name shared-name slot-name buffer-size phase thread-name cell-index.
]
  ({[.thread-name] ([.grid-topology] gpu.thread)} :)
  ({[.block-name]
    ({[.grid-topology block-name]} gpu.block)} :)
  ({[.shared-name]
    ({[.shared-name block-name slot-name buffer-size] u64} gpu.shared)} :)
  ({[.cell-index] ({({[.buffer-size]} shape.1d)} ix)} :)
  ({[.phase thread-name shared-name]} gpu.shared.reads |-)
  (u64 val)
} = gpu.shared.read)

(def program shared-sync-consumes-one-barrier-event : {[grid-topology block-name.]
  ({[.block-name]
    ({[.grid-topology block-name]} gpu.block)} :)
  ({
    [.grid-topology]
    ({
      ({
        gpu.tiled.wr
        ({gpu.tiled.write [.grid-topology block-name block-name]}
          gpu.shared.owns |-)
        ({gpu.tiled.read [.grid-topology block-name]} gpu.shared.reads |-)
      }
        gpu.barrier.step)
      gpu.barrier.trace.end
    } gpu.barrier.trace.sync)
  } gpu.barrier.cursor |-)
  ({gpu.tiled.write [.grid-topology block-name block-name]}
    gpu.shared.owns |-)
} -> {[grid-topology block-name.]
  ({[.block-name]
    ({[.grid-topology block-name]} gpu.block)} :)
  ({[.grid-topology] gpu.barrier.trace.end} gpu.barrier.cursor |-)
  ({gpu.tiled.read [.grid-topology block-name]} gpu.shared.reads |-)
} = gpu.sync)

(def program shared-layout-f32 :
  ([n.] ({[.n] u64} :))
  ->
  ([n.] ({gpu.tiled.a [.n f32] gpu.shared.empty}
    gpu.shared.slot gpu.shared.layout val))
= ([elements.]
  gpu.numeric.f32 [numeric-proof.]
  gpu.tiled.a.slot-name [slot-name.]
  (gpu.shared.layout.empty [empty-layout.])
  ({[.elements numeric-proof empty-layout slot-name]} gpu.shared.layout.add)
))
