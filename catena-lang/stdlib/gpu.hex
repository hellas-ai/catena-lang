# GPU memory and kernel interfaces.
#
# Buffers captured by kernels use managed global storage. Shared memory remains
# block-local, and logical layouts are expressed by views.

(theory type nat {
  # Ranked launch dimensions. These describe execution geometry, not memory.
  (arr 1d : 1 -> 1)
  (arr 2d : 2 -> 1)
  (arr 3d : 3 -> 1)

  # Type-level multiplication used to relate execution extents.
  (arr nat.mul : 2 -> 1)

  # Linear shared memory: length × element type. It is block-local and has no
  # host-visible ownership capability because it never escapes a launch.
  (arr gpu.shared : 2 -> 1)

  # An allocated shared-memory slot: identity × length × element type.
  (arr gpu.shared.slot : 3 -> 1)

  # Generate a fresh identity for a persistent GPU resource.
  (arr gpu.id : 0 -> 1)

  # Events form a trace by retaining the preceding event.
  (arr gpu.shared.allocated : 2 -> 1)
  (arr gpu.shared.loaded : 2 -> 1)
  (arr gpu.shared.materialized : 2 -> 1)
  (arr gpu.synchronized : 1 -> 1)
  (arr gpu.keyed : 2 -> 1)

  # Proofs about a particular slot at a particular input state.
  (arr gpu.shared.allocated-at : 3 -> 1)
  (arr gpu.shared.ready-at : 3 -> 1)

  # The physical execution grid: grid shape × block shape.
  (arr gpu.grid : 2 -> 1)

  # Read-only information supplied implicitly to a running kernel. Indexing the
  # environment by its grid contract ties kernel coordinates to the launch.
  (arr gpu.env : 1 -> 1)

  # Erased linear proof of block state: last completed event × idempotency key.
  # Event names describe executed instructions with past participles.
  (arr gpu.state : 2 -> 1)

  # Fixed initialization tag used at a kernel boundary.
  (arr gpu.initial : 0 -> 1)

  # Runtime dimension vectors and coordinates indexed by their rank/extent.
  # CUDA/HIP lowers each supported rank to dim3, filling absent axes with one.
  (arr gpu.dimensions : 1 -> 1)
  (arr gpu.coordinate : 1 -> 1)
  (arr gpu.launch_params : 1 -> 1)
})

(theory program type {
  # Preserve the concrete state supplied at a kernel boundary.
  (def gpu.state.initial.forward :
    ({gpu.initial gpu.initial} gpu.state)
    ->
    ({gpu.initial gpu.initial} gpu.state)
  = ([state.] [.state]))

  # Allocate one block-local f32 shared-memory slot.
  (arr gpu.shared.alloc : {[
    n last-event key.
  ]
    ({[.last-event] [.key]} gpu.state)
    ({[.n] u64} :)
  } -> ([n last-event key.] {
    (gpu.id [slot-id.])
    [.slot-id]
    ({
      ({[.slot-id] [.last-event]} gpu.shared.allocated)
      [.key]
    } gpu.state)
    ({[.slot-id] [.n] f32} gpu.shared.slot val)
  }))

  # Cooperatively load a logical 2D view into an allocated row-major slot.
  (arr gpu.shared.cooperative-load.row-major : {[
    rows cols t slot last-event key.
  ]
    ({[.last-event] [.key]} gpu.state)
    ({[.slot] [.last-event] [.key]} gpu.shared.allocated-at |-)
    ({[.slot] ({[.rows] [.cols]} *) [.t]} gpu.shared.slot val)
    ({[.rows] u64} :)
    ({[.cols] u64} :)
    ({({([.rows] ix val) ([.cols] ix val)} *) ([.t] val)} =>)
  } -> ([rows cols t slot last-event key.] {
    ({
      ({[.slot] [.last-event]} gpu.shared.loaded)
      [.key]
    } gpu.state)
    ({[.slot] ({[.rows] [.cols]} *) [.t]} gpu.shared.slot val)
  }))

  # Expose a ready slot as initialized shared storage.
  (arr gpu.shared.materialize : {[
    n t slot last-event key.
  ]
    ({[.last-event] [.key]} gpu.state)
    ({[.slot] [.last-event] [.key]} gpu.shared.ready-at |-)
    ({[.slot] [.n] [.t]} gpu.shared.slot val)
  } -> ([n t slot last-event key.] {
    ({
      ({[.slot] [.last-event]} gpu.shared.materialized)
      [.key]
    } gpu.state)
    ({[.n] [.t]} gpu.shared val)
  }))

  # Synchronize all threads in the block.
  (arr gpu.sync : {[last-event key.]
    ({[.last-event] [.key]} gpu.state)
  } -> ([last-event key.] {
    ({
      ([.last-event] gpu.synchronized)
      [.key]
    } gpu.state)
  }))

  # Temporary proof axioms. These will eventually be derived from execution
  # facts rather than assumed.
  # Admit that the current trace contains the allocation of this slot.
  (arr gpu.shared.admit-allocated-at : {[
    slot n t last-event key.
  ]
    ({[.last-event] [.key]} gpu.state)
    ({[.slot] [.n] [.t]} gpu.shared.slot val)
  } -> ([slot n t last-event key.] {
    ({[.last-event] [.key]} gpu.state)
    ({[.slot] [.last-event] [.key]} gpu.shared.allocated-at |-)
    ({[.slot] [.n] [.t]} gpu.shared.slot val)
  }))

  # Admit that synchronization made every entry in this slot ready.
  (arr gpu.shared.admit-ready-at : {[
    slot n t last-event key.
  ]
    ({[.last-event] [.key]} gpu.state)
    ({[.slot] [.n] [.t]} gpu.shared.slot val)
  } -> ([slot n t last-event key.] {
    ({[.last-event] [.key]} gpu.state)
    ({[.slot] [.last-event] [.key]} gpu.shared.ready-at |-)
    ({[.slot] [.n] [.t]} gpu.shared.slot val)
  }))

  # Temporary state axioms used while the reduction interface is pure.
  # Admit weakening the proof state independently of runtime values.
  (arr gpu.state.admit-discard : {[last-event key.]
    ({[.last-event] [.key]} gpu.state)
  } -> ([last-event key.] []))

  # Temporarily admit a trace continued under a new idempotency key.
  (arr gpu.state.admit-keyed : {[
    last-event current-key next-key.
  ]
    ({[.last-event] [.current-key]} gpu.state)
    ([.next-key])
  } -> ([last-event current-key next-key.] {
    ({
      ({
        [.next-key]
        [.last-event]
      } gpu.keyed)
      [.next-key]
    } gpu.state)
  }))

  # Index linear block-local shared storage.
  (arr gpu.shared.ix : {[n t.]
    ([.n] ix val)
    ({[.n t]} gpu.shared val)
  } -> ([n t . t] val))

  # Construct ranked runtime dimensions.
  (arr gpu.dimensions.1d.intro : {[x.]
    ({[.x] u64} :)
  } -> ([x.] (([.x] 1d) gpu.dimensions val)))

  (arr gpu.dimensions.2d.intro : {[x y.]
    ({[.x] u64} :)
    ({[.y] u64} :)
  } -> ([x y.] (({[.x] [.y]} 2d) gpu.dimensions val)))

  (arr gpu.dimensions.3d.intro : {[x y z.]
    ({[.x] u64} :)
    ({[.y] u64} :)
    ({[.z] u64} :)
  } -> ([x y z.] (({[.x] [.y] [.z]} 3d) gpu.dimensions val)))

  # Grid and block dimensions are constructed independently, so their ranks do
  # not need to match: for example, a 2D grid may launch 1D blocks.
  (arr gpu.launch_params.intro : {[grid-shape block-shape.]
    ([.grid-shape] gpu.dimensions val)
    ([.block-shape] gpu.dimensions val)
  } -> {[grid-shape block-shape.]
    ({[.grid-shape] [.block-shape]} gpu.grid [grid.])
    ([.grid] gpu.launch_params val)
  })

  # Preserve 2D launch parameters while exposing their erased extents for
  # specializing a named kernel.
  (arr gpu.launch_params.2d-2d.params : {[grid-x grid-y block-x block-y.]
    ({
      ({[.grid-x] [.grid-y]} 2d)
      ({[.block-x] [.block-y]} 2d)
    } gpu.grid [grid.])
    ([.grid] gpu.launch_params val)
  } -> {[grid-x grid-y block-x block-y.]
    ({
      ({[.grid-x] [.grid-y]} 2d)
      ({[.block-x] [.block-y]} 2d)
    } gpu.grid [grid.])
    ([.grid] gpu.launch_params val)
    [.grid-x]
    [.grid-y]
    [.block-x]
    [.block-y]
  })

  # Inspect the hardware coordinates of the current kernel invocation.
  #
  # The returned environment preserves this read-only resource for subsequent
  # queries without requiring contraction.
  (arr gpu.env.coordinates : {[grid-shape block-shape.]
    ({[.grid-shape] [.block-shape]} gpu.grid [grid.])
    ([.grid] gpu.env)
  } -> {[grid-shape block-shape.]
    ([.grid] gpu.env)
    ([.grid-shape] gpu.coordinate val)  # block index
    ([.block-shape] gpu.coordinate val) # thread index
    ([.grid-shape] gpu.dimensions val)
    ([.block-shape] gpu.dimensions val)
  })

  (arr gpu.coordinate.1d.elim :
    (([x] 1d) gpu.coordinate val)
    ->
    ([x.] (u64 val)))

  (arr gpu.coordinate.2d.elim :
    (({[x] [y]} 2d) gpu.coordinate val)
    ->
    ([x y.] {(u64 val) (u64 val)}))

  (arr gpu.coordinate.3d.elim :
    (({[x] [y] [z]} 3d) gpu.coordinate val)
    ->
    ([x y z.] {(u64 val) (u64 val) (u64 val)}))

  # General kernel launch.
  #
  #   S is the shared environment found in the kernel signature.
  #   Codegen creates S independently for every block. S is present in the
  #   kernel function but absent from gpu.launch's runtime inputs and outputs.
  #
  #   gpu.launch :
  #     launch_params
  #       × X
  #       × val(env × state × (X × S)
  #             -> state × (Y × S))
  #       -> Y
  (arr gpu.launch : {[
    grid x y s
    last-event key
    next-last-event next-key.
  ]
    ({[.x] [.s]} * [resources.])
    ({
      ({[.last-event] [.key]} gpu.state)
      [.resources]
    } * [state-and-resources.])
    ({([.grid] gpu.env) [.state-and-resources]} * [kernel-args.])

    ({[.y] [.s]} * [next-resources.])
    ({
      ({[.next-last-event] [.next-key]} gpu.state)
      [.next-resources]
    } * [kernel-coargs.])

    ([.grid] gpu.launch_params val)
    ([.x])
    ({[.kernel-args kernel-coargs]} -> val)
  } -> ([
    grid x y s
    last-event key
    next-last-event next-key
    .y
  ]))

  # Materialize one buffer element per logical thread index.
  #
  #   gpu.materialize :
  #     launch-params
  #       × (n : u64)
  #       × (state(initial, initial) × Ix n => T) # kernel
  #       -> buf(cap.own, n, T)
  (arr gpu.materialize : {[grid n t.]
    ([.grid] gpu.launch_params val)
    ({[.n] u64} :)
    ({
      ({
        ({gpu.initial gpu.initial} gpu.state)
        ([.n] ix val)
      } *)
      ([.t] val)
    } =>)
  } -> ([grid n t.]
    ({cap.own [.n t]} buf val)))
})
