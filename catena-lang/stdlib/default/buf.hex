# basic datatypes
(theory type nat {
  # ownership modes
  (arr cap.own : 0 -> 1)
  (arr cap.ref : 0 -> 1)

  # Memory: untyped, sized bytes, with ownership mode
  (arr mem : 1 -> 1)

  # Buffers
  # `buf m n t` is a buffer with ownership mode m of length n with elements of type t.
  (arr buf : 3 -> 1)

  # Sized types
  # sizeof(t, s) "the representation size of type t is s bytes"
  #(arr sizeof : 2 -> 1)
})


(theory program type {
  ################################################################################
  # Only owned typed buffers can be deallocated. Borrowed buffers and untyped
  # memory handles deliberately have no free operation.
  (arr buf.free : ([n t.] ({cap.own [.n t]} buf val)) -> ([n t.] []))

  ################################################################################
  # Casting mem to buf and back
  # TODO: this can lose bytes of mem if sizeof(u64) doesn't cleanly divide num bytes!
  # buf.to-mem : (n : u64) ● val(buf m n t) -> mem m
  (arr buf.to-mem : {[m n t.]
      ({[.n] u64} :)   # n : u64
      ([.m n t] buf val) # val(buf m n t)
    } -> ([m n t.m] mem)
  )

  # mem.cast.u64 : mem m -> (n : u64) ● val(buf m n u64)
  (arr mem.cast.u64 : ([m n.m] mem) -> {[m n.]
    ({[.n] u64} :)   # n : u64
    ({[.m n] u64} buf val) # val(buf m n u64)
  })

  # mem.cast.f32 : mem m -> (n : u64) ● val(buf m n f32)
  (arr mem.cast.f32 : ([m n.m] mem) -> {[m n.]
    ({[.n] u64} :)   # n : u64
    ({[.m n] f32} buf val) # val(buf m n f32)
  })

  # mem.cast.bf16 : mem m -> (n : u64) ● val(buf m n bf16)
  (arr mem.cast.bf16 : ([m n.m] mem) -> {[m n.]
    ({[.n] u64} :)   # n : u64
    ({[.m n] bf16} buf val) # val(buf m n bf16)
  })

  # Transport a u64 buffer across a proven length equality.
  (arr buf.u64.cast-same-length : {[m n p.]
    ({[.m p] u64} buf val) # val(buf m p u64)
    ([.n p] = |-)           # n = p
  } -> ([m n p.] ({[.m n] u64} buf val)))

  # Transport a f32 buffer across a proven length equality.
  (arr buf.f32.cast-same-length : {[m n p.]
    ({[.m p] f32} buf val) # val(buf m p f32)
    ([.n p] = |-)           # n = p
  } -> ([m n p.] ({[.m n] f32} buf val)))

  # Transport a bf16 buffer across a proven length equality.
  (arr buf.bf16.cast-same-length : {[m n p.]
    ({[.m p] bf16} buf val) # val(buf m p bf16)
    ([.n p] = |-)            # n = p
  } -> ([m n p.] ({[.m n] bf16} buf val)))

  # Materialize an owned buffer from an indexed producer.
  #
  #   materialize : (n : u64) ● (val(ix n) => val(t)) -> val(buf cap.own n t)
  (arr materialize : {[n t.]
    ({[.n] u64} :)
    ({([.n] ix val) ([.t] val)} =>)
  } -> {[n t.] ({cap.own [.n t]} buf val)})

  # Materialize an owned buffer from a converted indexed producer.
  #
  #   materializec : (n : u64) ● X ● val(X * val(ix n) -> val(t)) -> val(buf cap.own n t)
  (arr materializec : {[x n t.]
    ({[.n] u64} :)
    ([.x])
    ({({[.x] ([.n] ix val)} *) ([.t] val)} -> val)
  } -> {[x n t.] ({cap.own [.n t]} buf val)})

  # Fill a contiguous range of an existing owned buffer. The capacity witness
  # ties the runtime bounds check to the buffer's type-level capacity. The
  # operation consumes and returns the owned buffer, so it cannot alias a live
  # owner while the producer kernel writes it.
  (arr materializec.into : {[x capacity n t.]
    ({cap.own [.capacity t]} buf val)
    ({[.capacity] u64} :)
    (u64 val)
    ({[.n] u64} :)
    ([.x])
    ({({[.x] ([.n] ix val)} *) ([.t] val)} -> val)
  } -> {[x capacity n t.] ({cap.own [.capacity t]} buf val)})

  # Scope a read-only borrow of an owned buffer to one materialization. Both
  # the original owner and the newly materialized buffer are returned only
  # after the reading kernel has been enqueued, preserving linear ownership
  # without exposing a freely-copyable reference outside the operation.
  (arr materializec.borrow : {[x capacity n a b.]
    ({cap.own [.capacity a]} buf val)
    ({[.capacity] u64} :)
    ({[.n] u64} :)
    ([.x])
    ({({({cap.ref [.capacity a]} buf val) ({[.x] ([.n] ix val)} *)} *) ([.b] val)} -> val)
  } -> {[x capacity n a b.] {
    ({cap.own [.capacity a]} buf val)
    ({cap.own [.n b]} buf val)
  }})

  # Scope a read-only borrow while cooperatively reducing one independent F32
  # domain per output. Reduction and epilogue semantics match
  # materializec.reduce-f32; the source owner is returned with the result.
  (arr materializec.borrow-reduce-f32 : {[x capacity n k a.]
    ({cap.own [.capacity a]} buf val)
    ({[.capacity] u64} :)
    ({[.n] u64} :)
    ({[.k] u64} :)
    ([.x])
    ({({({cap.ref [.capacity a]} buf val) ({[.x] ({([.n] ix val) ([.k] ix val)} *)} *)} *) (f32 val)} -> val)
    ({({({cap.ref [.capacity a]} buf val) ({[.x] ({([.n] ix val) (f32 val)} *)} *)} *) (f32 val)} -> val)
  } -> {[x capacity n k a.] {
    ({cap.own [.capacity a]} buf val)
    ({cap.own [.n] f32} buf val)
  }})

  # Compute paired routed BF16 matrix-vector products while returning the
  # owned input and expert-index buffers. For each output, both F32 sums use
  # the exact adjacent-pair tree specified by materializec.reduce-f32. The
  # weight layout is [expert, output-feature, reduction-feature], selected is
  # [row, slot], and output is [row, slot, output-feature].
  (arr materializec.borrow-routed-bf16-gemv-pair :
    {[input-cap gate-cap up-cap selected-cap n k.]
      ({cap.own [.input-cap] f32} buf val)
      ({[.input-cap] u64} :)
      ({cap.ref [.gate-cap] bf16} buf val)
      ({[.gate-cap] u64} :)
      ({cap.ref [.up-cap] bf16} buf val)
      ({[.up-cap] u64} :)
      ({cap.own [.selected-cap] u64} buf val)
      ({[.selected-cap] u64} :)
      ({[.n] u64} :)
      ({[.k] u64} :)
      (u64 val)
      (u64 val)
    }
    ->
    {[input-cap gate-cap up-cap selected-cap n k.] {
      ({cap.own [.input-cap] f32} buf val)
      ({cap.own [.selected-cap] u64} buf val)
      ({cap.own [.n] f32} buf val)
      ({cap.own [.n] f32} buf val)
    }})

  # Find the greatest F32 element while returning the source owner. Comparison
  # uses IEEE-bit total order (negative NaNs through positive NaNs); equal bit
  # patterns select the greatest index. The input must be non-empty. The index
  # is returned as a one-element owned U64 buffer.
  (arr materializec.borrow-argmax-f32 : {[n one.]
    ({cap.own [.n] f32} buf val)
    ({[.n] u64} :)
    ({[.one] u64} :)
  } -> {[n one.] {
    ({cap.own [.n] f32} buf val)
    ({cap.own [.one] u64} buf val)
  }})

  # Select stable descending top-k indices independently from contiguous F32
  # rows while returning the source owner. Equal numeric values keep the lower
  # column index. The GPU implementation supports 1 <= k <= 8 and emits a
  # row-major [rows, k] U64 buffer without changing any F32 bits.
  (arr materializec.borrow-topk-f32 : {[n rows out.]
    ({cap.own [.n] f32} buf val)
    ({[.n] u64} :)
    ({[.rows] u64} :)
    ({[.out] u64} :)
    (u64 val)
    (u64 val)
  } -> {[n rows out.] {
    ({cap.own [.n] f32} buf val)
    ({cap.own [.out] u64} buf val)
  }})

  # Materialize F32 outputs by cooperatively reducing one independent domain
  # per output. The reduction order is part of this operation's semantics:
  # first materialize term(0)..term(k-1) as F32, then add adjacent logical
  # indices (0+1, 2+3, ...), carry an unmatched final value unchanged, and
  # repeat that rule over the surviving values until one remains. The empty
  # reduction is +0.0. Thread scheduling and block width must not change this
  # tree. The current GPU implementation supports k <= 4096.
  #
  # A GPU block computes one output, then applies the epilogue to the exactly
  # specified reduced sum. This is the Catena-native building block for
  # GEMV-style kernels without baking matrix semantics into the runtime.
  (arr materializec.reduce-f32 : {[x n k.]
    ({[.n] u64} :)
    ({[.k] u64} :)
    ([.x])
    ({({[.x] ({([.n] ix val) ([.k] ix val)} *)} *) (f32 val)} -> val)
    ({({[.x] ({([.n] ix val) (f32 val)} *)} *) (f32 val)} -> val)
  } -> {[x n k.] ({cap.own [.n] f32} buf val)})

  # Materialize a pair of F32 reductions in one kernel. The shared term and
  # epilogue functions each return two F32 values. Each result uses the exact
  # adjacent-pair tree specified by materializec.reduce-f32; only term setup
  # and synchronization barriers are shared between the two trees.
  (arr materializec.reduce-f32-pair : {[x n k.]
    ({[.n] u64} :)
    ({[.k] u64} :)
    ([.x])
    ({({[.x] ({([.n] ix val) ([.k] ix val)} *)} *) ({(f32 val) (f32 val)} *)} -> val)
    ({({[.x] ({([.n] ix val) ({(f32 val) (f32 val)} *)} *)} *) ({(f32 val) (f32 val)} *)} -> val)
  } -> {[x n k.] {
    ({cap.own [.n] f32} buf val)
    ({cap.own [.n] f32} buf val)
  }})

  # Normalize contiguous F32 rows in place. The operation consumes and
  # returns the owner; `columns` must be non-zero and divide n exactly.
  #
  # For each row, maximum and denominator reductions use the same adjacent-
  # pair tree specified by materializec.reduce-f32. Maximum selection keeps
  # the left operand unless the right operand is strictly greater. A
  # 0xFF800000 (-infinity) input maps directly to a +0 numerator; all other
  # numerators are exponential(value - maximum). If the denominator is zero,
  # the entire row is +0. The current GPU implementation supports columns <=
  # 8192.
  (arr materializec.softmax-f32 : {[n.]
    ({cap.own [.n] f32} buf val)
    ({[.n] u64} :)
    (u64 val)
    ({(f32 val) (f32 val)} -> val)
  } -> {[n.] ({cap.own [.n] f32} buf val)})

  # TODO: make all mem.cast.* into definitions, using the below:
  #   mem.cast : mem ● (s : u64) ● sizeof(t, s) -> (n : u64) ● val(buf n t)
  # and introduce
  #   u64.sizeof : I -> (s : u64) ● sizeof(u64, s)
  #   u32.sizeof : I -> (s : u64) ● sizeof(u32, s)
  #   ... etc.
})
