# Plain-value, checked execution adapters. Memory accesses and launches are explicit.
(theory program type {
(arr stdlib.numeric.raw.add : ([t.] {([.t] val) ([.t] val)}) -> ([t.] ([.t] val)))
(arr stdlib.numeric.raw.sub : ([t.] {([.t] val) ([.t] val)}) -> ([t.] ([.t] val)))
(arr stdlib.numeric.raw.mul : ([t.] {([.t] val) ([.t] val)}) -> ([t.] ([.t] val)))
(arr stdlib.numeric.raw.div : ([t.] {([.t] val) ([.t] val)}) -> ([t.] ([.t] val)))
(arr stdlib.numeric.raw.rem : ([t.] {([.t] val) ([.t] val)}) -> ([t.] ([.t] val)))
(arr stdlib.numeric.raw.max : ([t.] {([.t] val) ([.t] val)}) -> ([t.] ([.t] val)))
(arr stdlib.numeric.raw.less : ([t.] {([.t] val) ([.t] val)}) -> ([t.] (bool val)))
(arr stdlib.numeric.raw.less_equal : ([t.] {([.t] val) ([.t] val)}) -> ([t.] (bool val)))
(arr stdlib.numeric.raw.equal : ([t.] {([.t] val) ([.t] val)}) -> ([t.] (bool val)))
(arr stdlib.numeric.raw.select : ([t.] {(bool val) ([.t] val) ([.t] val)}) -> ([t.] ([.t] val)))
(arr stdlib.numeric.raw.negate : (f32 val) -> (f32 val))
(arr stdlib.numeric.raw.to_f32 : ([t.] ([.t] val)) -> ([t.] (f32 val)))
(arr stdlib.numeric.raw.to_u32 : (u64 val) -> (u32 val))
(arr stdlib.numeric.raw.to_u64 : (u32 val) -> (u64 val))
(arr stdlib.numeric.raw.bits_u32 : (f32 val) -> (u32 val))
(arr stdlib.numeric.raw.round_u32 : (f32 val) -> (u32 val))
(arr stdlib.numeric.raw.shr : {(u32 val) (u32 val)} -> (u32 val))
(arr stdlib.runtime.raw.alloc_f32 : (u32 val) -> ((cap.own mem) val))
(arr stdlib.runtime.raw.free : ((cap.own mem) val) -> 1)
(arr stdlib.runtime.raw.bytes : ([cap.] (([.cap] mem) val)) -> ([cap.] (u64 val)))
(arr stdlib.runtime.raw.borrow : ((cap.own mem) val) -> {((cap.own mem) val) ((cap.ref mem) val)})
(arr stdlib.runtime.raw.read_f32 : ([cap.] {(([.cap] mem) val) (u32 val)}) -> ([cap.] (f32 val)))
(arr stdlib.runtime.raw.read_u64 : ([cap.] {(([.cap] mem) val) (u32 val)}) -> ([cap.] (u64 val)))
(arr stdlib.runtime.raw.write_f32 : {((cap.own mem) val) (u32 val) (f32 val)} -> 1)
(arr unsafe.launch_linear : {(u32 val) ({(u32 val) 1} =>)} -> 1)
(arr core.fold.values : ([s.] {(u32 val) [.s] ({({(u32 val) [.s]} *) [.s]} =>)}) -> ([s.] [.s]))
})
