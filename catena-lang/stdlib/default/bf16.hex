 (arr wmma.mma-bf16-f32 : {(wmma.bf16x16 val) (wmma.bf16x16 val) (wmma.f32x8 val)} -> (wmma.f32x8 val))
 (arr bf16x2.dot-f32 : {(bf16x2 val) (bf16x2 val) (f32 val)} -> (f32 val))

