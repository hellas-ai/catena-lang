# Perfectly tiled f32 matrix multiplication.
#
# The physical grid shape is independent of the logical n x m output shape.
# Each block has shape tile-size x tile-size and therefore
# tile-size*tile-size workers.

# Map a local row-inner tile coordinate to its source matrix coordinate.
(def program tiled-matmul.row-inner-tile-reindex :
  ([rows inner tile-size.] {
    ({[.inner] u64} :)
    ({[.tile-size] u64} :)
    ([.rows] ix val)
    (u64 val)
    ({([.tile-size] ix val) ([.tile-size] ix val)} *)
  })
  ->
  ([rows inner tile-size.] {([.rows] ix val) ([.inner] ix val)} *)
= {[inner tile-size output-row inner-tile-index local-index.]
  ([.tile-size] u64.copies2 [row-tile-size inner-tile-size.])
  ([.local-index] *.elim [local-row local-col.])
  ({[.row-tile-size] [.output-row] [.local-row]}
    ix.same-tile-coordinate [matrix-row.])
  ({[.inner] [.inner-tile-size] [.inner-tile-index] [.local-col]}
    ix.tile-offset-coordinate [matrix-inner.])
  ({[.matrix-row] [.matrix-inner]} *.intro)
})

# Map a local inner-column tile coordinate to its source matrix coordinate.
(def program tiled-matmul.inner-col-tile-reindex :
  ([inner cols tile-size.] {
    ({[.inner] u64} :)
    ({[.tile-size] u64} :)
    ([.cols] ix val)
    (u64 val)
    ({([.tile-size] ix val) ([.tile-size] ix val)} *)
  })
  ->
  ([inner cols tile-size.] {([.inner] ix val) ([.cols] ix val)} *)
= {[inner tile-size output-col inner-tile-index local-index.]
  ([.tile-size] u64.copies2 [inner-tile-size col-tile-size.])
  ([.local-index] *.elim [local-row local-col.])
  ({[.inner] [.inner-tile-size] [.inner-tile-index] [.local-row]}
    ix.tile-offset-coordinate [matrix-inner.])
  ({[.col-tile-size] [.output-col] [.local-col]}
    ix.same-tile-coordinate [matrix-col.])
  ({[.matrix-inner] [.matrix-col]} *.intro)
})

# Evaluate the row-inner source view at one flat local tile index.
(def program f32.tiled-matmul.row-inner-tile-load :
  ([rows inner tile-size.] {
    ({({([.rows] ix val) ([.inner] ix val)} *) (f32 val)} =>)
    ({[.inner] u64} :)
    ({[.tile-size] u64} :)
    ([.rows] ix val)
    (u64 val)
    ({({[.tile-size tile-size]} gpu.block.2d) ({[.tile-size tile-size]} *) 1} worker)
    (({[.tile-size tile-size]} *) ix val)
  })
  ->
  ([rows inner tile-size.] (f32 val))
= {[view inner tile-size output-row inner-tile-index worker flat-index.]
  # materialize owns the worker; this loader only needs its logical index.
  ({[.tile-size] [.flat-index]} f32.row-major.indices [local-index.])
  ({[.inner] [.tile-size] [.output-row] [.inner-tile-index] [.local-index]}
    tiled-matmul.row-inner-tile-reindex [matrix-index.])
  ({[.matrix-index] [.view]} evaluate)
})

# Evaluate the inner-column source view at one flat local tile index.
(def program f32.tiled-matmul.inner-col-tile-load :
  ([inner cols tile-size.] {
    ({({([.inner] ix val) ([.cols] ix val)} *) (f32 val)} =>)
    ({[.inner] u64} :)
    ({[.tile-size] u64} :)
    ([.cols] ix val)
    (u64 val)
    ({({[.tile-size tile-size]} gpu.block.2d) ({[.tile-size tile-size]} *) 1} worker)
    (({[.tile-size tile-size]} *) ix val)
  })
  ->
  ([inner cols tile-size.] (f32 val))
= {[view inner tile-size output-col inner-tile-index worker flat-index.]
  # materialize owns the worker; this loader only needs its logical index.
  ({[.tile-size] [.flat-index]} f32.row-major.indices [local-index.])
  ({[.inner] [.tile-size] [.output-col] [.inner-tile-index] [.local-index]}
    tiled-matmul.inner-col-tile-reindex [matrix-index.])
  ({[.matrix-index] [.view]} evaluate)
})

# Produce one k-tile contribution. The writable tiles are captured by the
# surrounding reduction and reused for every k-tile.
(def program gpu.f32.tiled-matmul.tile-step :
  ([n k m k-tiles tile-size.] {
    [.n]
    [.m]
    ({({([.n] ix val) ([.k] ix val)} *) (f32 val)} =>)
    ({({([.k] ix val) ([.m] ix val)} *) (f32 val)} =>)
    ({([.n] ix val) ([.m] ix val)} *)
    ({[.tile-size] u64} :)
    ({[.k] u64} :)
    ({[.k-tiles] u64} :)
    ({({[.tile-size tile-size]} gpu.block.2d) ({[.tile-size tile-size]} *) 1} context)
    ({({[.tile-size tile-size]} gpu.block.2d) ({[.tile-size tile-size]} *) 1} worker)
    ({
      ({({[.tile-size tile-size]} gpu.block.2d) ({[.tile-size tile-size]} *) 1} context)
      ({cap.own ({[.tile-size tile-size]} *) f32} buf)
    } writable val)
    ({
      ({({[.tile-size tile-size]} gpu.block.2d) ({[.tile-size tile-size]} *) 1} context)
      ({cap.own ({[.tile-size tile-size]} *) f32} buf)
    } writable val)
    ([.k-tiles] ix val)
  })
  ->
  ([n k m k-tiles tile-size.] (f32 val))
= {[n-param m-param a b c-index tile-size inner _k-tiles block-context block-worker a-tile b-tile k-tile.]
  ([.c-index] *.elim [output-row-0 output-col-0.])
  ([.output-row-0] ix.copy [c-row output-row.])
  ([.output-col-0] ix.copy [c-col output-col.])
  ([.k-tile] ix.to-u64 [k-tile-u64.])
  ([.inner] u64.copy-param [inner-value inner-param.])
  ([.tile-size] u64.copy-param [tile-size-value tile-size-param.])

  # Convert the logical C index to its position inside a tile. c-index is
  # already 2D, so both coordinates need their independent remainder:
  # (c-row % tile-size, c-col % tile-size).
  ([.tile-size] u64.copies2 [row-width col-width.])
  ({[.row-width] [.c-row]} ix.rem [in-tile-c-row.])
  ({[.col-width] [.c-col]} ix.rem [in-tile-c-col.])
  ({[.in-tile-c-row] [.in-tile-c-col]} *.intro [in-tile-c-index.])

  ({
    [.block-context]
    [.a-tile]
    ({
      [.n-param]
      [.inner-param]
      [.tile-size-param]
      [.a]
      [.inner-value]
      [.tile-size-value]
      [.output-row]
      [.k-tile-u64]
    } partial.f32.tiled-matmul.row-inner-tile-load.5)
  } parallel.materialize [block-context-1 pending-a.])
  ({
    [.block-context-1]
    [.b-tile]
    ({
      [.inner-param]
      [.m-param]
      [.tile-size-param]
      [.b]
      [.inner-value]
      [.tile-size-value]
      [.output-col]
      [.k-tile-u64]
    } partial.f32.tiled-matmul.inner-col-tile-load.5)
  } parallel.materialize [block-context-2 pending-b.])

  ({[.block-context-2] [.pending-a]}
    parallel.await [block-context-3 a-ready.])
  ({[.block-context-3] [.pending-b]}
    parallel.await [block-context-4 b-ready.])

  ([.a-ready] buf.f32.view [a-flat-view.])
  ([.b-ready] buf.f32.view [b-flat-view.])
  ({[.tile-size] [.tile-size] [.a-flat-view]}
    f32.row-major.matrix-view [a-tile-view.])
  ({[.tile-size] [.tile-size] [.b-flat-view]}
    f32.row-major.matrix-view [b-tile-view.])
  ([.tile-size] u64.params3 [tile-n tile-m _tile-unused.])
  ({
    [.tile-n]
    [.tile-m]
    [.tile-size]
    [.a-tile-view]
    [.b-tile-view]
    [.in-tile-c-index]
  } f32.matmul.cell-dot [tile-result.])

  # This second synchronization restores both captured tiles to writable, but
  # standard reduce does not currently enforce that invariant in its types.
  ({[.block-context-4] [.a-ready]}
    parallel.release [block-context-5 _next-a-tile.])
  ({[.block-context-5] [.b-ready]}
    parallel.release [_block-context _next-b-tile.])
  [.tile-result]
})

# Evaluate one logical C cell selected independently of the physical worker.
(def program gpu.f32.tiled-matmul.cell.kernel :
  ([grid-x grid-y n k m tile-size.] {
    [.n]
    [.m]
    ({({([.n] ix val) ([.k] ix val)} *) (f32 val)} =>)
    ({({([.k] ix val) ([.m] ix val)} *) (f32 val)} =>)
    ({[.k] u64} :)
    ({[.tile-size] u64} :)
    ({({[.tile-size tile-size]} *) u64} :)
    ({[.grid-x] u64} :)
    ({[.grid-y] u64} :)
    ({
      ({
        ({[.grid-x grid-y tile-size tile-size]} gpu.grid.2d)
        ({({[.grid-x grid-y]} *) ({[.tile-size tile-size]} *)} *)
        ({[.grid-x grid-y]} *)
      } worker)
      ({([.n] ix val) ([.m] ix val)} *)
    } *)
  })
  ->
  ([grid-x grid-y n k m tile-size.] (f32 val))
= {[n-param m-param a b k tile-size tile-element-count _grid-x _grid-y work-item.]
  ([.work-item] *.elim [grid-worker c-index.])
  # c-index is the logical 2D index of C. The physical worker index is
  # represented independently by grid-worker.
  ([.grid-worker]
    gpu.scope-worker-to-block [block-worker-0.])
  ([.block-worker-0]
    parallel.worker-context [block-context-0 block-worker.])

  ([.k] u64.copies2-param [k-value step-inner k-param.])
  ([.tile-size] u64.copies2-param
    [k-tile-size step-tile-size tile-size-param.])
  ({([.k-value] :.forget) ([.k-tile-size] :.forget)}
    u64.div u64.name [k-tile-count.])

  ({[.block-context-0] [.tile-element-count]}
    parallel.allocate [block-context-1 a-tile.])
  ({[.block-context-1] [.tile-element-count]}
    parallel.allocate [block-context-2 b-tile.])

  ([.k-tile-count] u64.copies2-param
    [step-count reduce-count k-tiles-param.])
  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    (name.f32.add lift)
    ({
      [.n-param]
      [.k-param]
      [.m-param]
      [.k-tiles-param]
      [.tile-size-param]
      [.n-param]
      [.m-param]
      [.a]
      [.b]
      [.c-index]
      [.step-tile-size]
      [.step-inner]
      [.step-count]
      [.block-context-2]
      [.block-worker]
      [.a-tile]
      [.b-tile]
    } partial.gpu.f32.tiled-matmul.tile-step.12)
    [.reduce-count]
  } reduce [result.])
  [.result]
})

# Materialize C in row-major order. Row-major layout is handled only by the
# first producer in the composition; the tiled kernel receives a logical 2D
# C index and is independent of the output layout.
(def program gpu.f32.tiled-matmul.row-major.materialize :
  ([n m k tile-size.] {
    ({[.n] u64} :)
    ({[.m] u64} :)
    ({[.k] u64} :)
    ({({[.n m]} *) u64} :)
    ({[.tile-size] u64} :)
    ({({[.tile-size tile-size]} *) u64} :)
    ({({([.n] ix val) ([.k] ix val)} *) (f32 val)} =>)
    ({({([.k] ix val) ([.m] ix val)} *) (f32 val)} =>)
  })
  ->
  ([n m k tile-size.] ({cap.own ({[.n m]} *) f32} buf val))
= {[n m k output-len tile-size tile-element-count a b.]
  ([.n] u64.copy-params3 [grid-n indices-n kernel-n _n-unused.])
  ([.m] u64.copy-params3 [m-runtime indices-m kernel-m _m-unused.])
  ([.m-runtime] u64.copies2 [grid-m indices-m-len.])
  ([.tile-size] u64.copies6
    [grid-x-tile grid-y-tile block-x block-y kernel-tile-size _tile-unused.])

  ({([.grid-n] :.forget) ([.grid-x-tile] :.forget)}
    u64.div u64.name [grid-x.])
  ({([.grid-m] :.forget) ([.grid-y-tile] :.forget)}
    u64.div u64.name [grid-y.])

  ([.grid-x] u64.copies2 [launch-grid-x kernel-grid-x.])
  ([.grid-y] u64.copies2 [launch-grid-y kernel-grid-y.])
  ([.k] :.ty [kernel-k k-param.])
  ([.kernel-tile-size] :.ty [kernel-tile-size-value tile-size-param.])
  ([.kernel-grid-x] :.ty [kernel-grid-x-value grid-x-param.])
  ([.kernel-grid-y] :.ty [kernel-grid-y-value grid-y-param.])

  ({[.launch-grid-x] [.launch-grid-y] [.block-x] [.block-y]}
    gpu.launch-config.2d [plan.])
  ([.plan] parallel.plan.root-types [typed-plan worker-type.])
  ([.typed-plan] parallel.schedule [grid-context.])
  ({[.grid-context] [.output-len]}
    parallel.allocate [allocated-context output.])

  ({
    [.allocated-context]
    [.output]
    ({
      ({
        ([.worker-type] name.identity lift)
        ({[.indices-n] [.indices-m] [.indices-m-len]}
          partial.f32.row-major.indices.1)
      } tensor)
      ({
        [.grid-x-param]
        [.grid-y-param]
        [.kernel-n]
        [.k-param]
        [.kernel-m]
        [.tile-size-param]
        [.kernel-n]
        [.kernel-m]
        [.a]
        [.b]
        [.kernel-k]
        [.kernel-tile-size-value]
        [.tile-element-count]
        [.kernel-grid-x-value]
        [.kernel-grid-y-value]
      } partial.gpu.f32.tiled-matmul.cell.kernel.9)
    } compose)
  } parallel.materialize [materialized-context pending-output.])
  ({[.materialized-context] [.pending-output]}
    parallel.await [_grid-context result.])
  [.result]
})
