# GPU memory and kernel interfaces.
#
# Global and shared memory are linear; logical layouts are expressed by views.

(theory type nat {
  # Ranked launch dimensions. These describe execution geometry, not memory.
  (arr 1d : 1 -> 1)
  (arr 2d : 2 -> 1)
  (arr 3d : 3 -> 1)

  # Type-level multiplication used to relate execution extents.
  (arr nat.mul : 2 -> 1)

  # Linear global memory: ownership capability × length × element type.
  (arr gpu.global : 3 -> 1)

  # Linear shared memory: length × element type. It is block-local and has no
  # host-visible ownership capability because it never escapes a launch.
  (arr gpu.shared : 2 -> 1)

  # The physical execution grid: grid shape × block shape.
  (arr gpu.grid : 2 -> 1)

  # Read-only information supplied implicitly to a running kernel. Indexing the
  # environment by its grid contract ties kernel coordinates to the launch.
  (arr gpu.env : 1 -> 1)

  # Linear token used to order effects within a kernel.
  (arr gpu.state : 0 -> 1)

  # Runtime dimension vectors and coordinates indexed by their rank/extent.
  # CUDA/HIP lowers each supported rank to dim3, filling absent axes with one.
  (arr gpu.dimensions : 1 -> 1)
  (arr gpu.coordinate : 1 -> 1)
  (arr gpu.launch_params : 1 -> 1)
})

(theory program type {
  # Index linear global storage.
  (arr gpu.global.ix : {[m n t.]
    ([.n] ix val)
    ({[.m n t]} gpu.global val)
  } -> ([m n t . t] val))

  # Allocate global storage and initialize it from a buffer. The proof
  # transports the actual buffer length p to the requested global length n.
  (arr gpu.global.alloc-from-buf : {[m n p t.]
    ({[.m p t]} buf val)
    ([.n p] = |-)
  } -> ([m n p t.] ({[.m n t]} gpu.global val)))

  # Allocate owned global storage without initializing it. The element type is
  # supplied as an erased type witness because there is no initializer from
  # which it could be inferred.
  (arr gpu.global.alloc : {[n t.]
    ({[.n] u64} :)
    ([.t])
  } -> ([n t.] ({cap.own [.n t]} gpu.global val)))

  # End global use and recover its contents as an owned or borrowed buffer.
  (arr gpu.global.to-buf : {[m n t.]
    ({[.m n t]} gpu.global val)
  } -> ([m n t.] ({[.m n t]} buf val)))

  # Cooperatively materialize a block-local 2D view into linear shared storage.
  # Each block thread supplies the element at its own logical 2D thread index.
  #
  #   cooperative-materialize.2d :
  #     rows × cols × ((Ix rows × Ix cols) => T)
  #       -> shared(rows * cols, T)
  (arr gpu.shared.cooperative-materialize.2d : {[rows cols t.]
    ({[.rows] u64} :)
    ({[.cols] u64} :)
    ({({([.rows] ix val) ([.cols] ix val)} *) ([.t] val)} =>)
  } -> ([rows cols t.]
    ({({[.rows] [.cols]} *) [.t]} gpu.shared val)))

  (arr gpu.shared.end : {[n.]
    ({[.n f32]} gpu.shared val)
  } -> ([n.] [.n]))

  # Construct ranked runtime dimensions.
  (arr gpu.dimensions.1d.intro : {[x.]
    ({[.x] u64} :)
  } -> ([x.] (([.x] 1d) gpu.dimensions val)))

  (arr gpu.dimensions.2d.intro : {[x y.]
    ({[.x] u64} :)
    ({[.y] u64} :)
  } -> ([x y.] (({[.x] [.y]} 2d) gpu.dimensions val)))

  (arr gpu.dimensions.3d.intro : {[x y z.]
    ({[.x] u64} :)
    ({[.y] u64} :)
    ({[.z] u64} :)
  } -> ([x y z.] (({[.x] [.y] [.z]} 3d) gpu.dimensions val)))

  # Grid and block dimensions are constructed independently, so their ranks do
  # not need to match: for example, a 2D grid may launch 1D blocks.
  (arr gpu.launch_params.intro : {[grid-shape block-shape.]
    ([.grid-shape] gpu.dimensions val)
    ([.block-shape] gpu.dimensions val)
  } -> {[grid-shape block-shape.]
    ({[.grid-shape] [.block-shape]} gpu.grid [grid.])
    ([.grid] gpu.launch_params val)
  })

  # Preserve 2D launch parameters while exposing their erased extents for
  # specializing a named kernel.
  (arr gpu.launch_params.2d-2d.params : {[grid-x grid-y block-x block-y.]
    ({
      ({[.grid-x] [.grid-y]} 2d)
      ({[.block-x] [.block-y]} 2d)
    } gpu.grid [grid.])
    ([.grid] gpu.launch_params val)
  } -> {[grid-x grid-y block-x block-y.]
    ({
      ({[.grid-x] [.grid-y]} 2d)
      ({[.block-x] [.block-y]} 2d)
    } gpu.grid [grid.])
    ([.grid] gpu.launch_params val)
    [.grid-x]
    [.grid-y]
    [.block-x]
    [.block-y]
  })

  # Inspect the hardware coordinates of the current kernel invocation.
  #
  # The returned environment preserves this read-only resource for subsequent
  # queries without requiring contraction.
  (arr gpu.env.coordinates : {[grid-shape block-shape.]
    ({[.grid-shape] [.block-shape]} gpu.grid [grid.])
    ([.grid] gpu.env)
  } -> {[grid-shape block-shape.]
    ([.grid] gpu.env)
    ([.grid-shape] gpu.coordinate val)  # block index
    ([.block-shape] gpu.coordinate val) # thread index
    ([.grid-shape] gpu.dimensions val)
    ([.block-shape] gpu.dimensions val)
  })

  (arr gpu.coordinate.1d.elim :
    (([x] 1d) gpu.coordinate val)
    ->
    ([x.] (u64 val)))

  (arr gpu.coordinate.2d.elim :
    (({[x] [y]} 2d) gpu.coordinate val)
    ->
    ([x y.] {(u64 val) (u64 val)}))

  (arr gpu.coordinate.3d.elim :
    (({[x] [y] [z]} 3d) gpu.coordinate val)
    ->
    ([x y z.] {(u64 val) (u64 val) (u64 val)}))

  # General kernel launch.
  #
  #   S is the shared environment found in the kernel signature.
  #   Codegen creates S independently for every block. S is present in the
  #   kernel function but absent from gpu.launch's runtime inputs and outputs.
  #
  #   gpu.launch :
  #     launch_params
  #       × X
  #       × val(env × state × (X × S)
  #             -> state × (Y × S))
  #       -> Y
  (arr gpu.launch : {[grid x y s.]
    ({[.x] [.s]} * [resources.])
    ({gpu.state [.resources]} * [state-resources.])
    ({([.grid] gpu.env) [.state-resources]} * [kernel-args.])

    ({[.y] [.s]} * [next-resources.])
    ({gpu.state [.next-resources]} * [kernel-coargs.])

    ([.grid] gpu.launch_params val)
    ([.x])
    ({[.kernel-args kernel-coargs]} -> val)
  } -> ([grid x y s.y]))

  # Materialize one global element per logical thread index.
  #
  #   gpu.materialize :
  #     launch-params
  #       × (n : u64)
  #       × (Ix n => T) # kernel
  #       -> global(cap.own, n, T)
  (arr gpu.materialize : {[grid n t.]
    ([.grid] gpu.launch_params val)
    ({[.n] u64} :)
    ({([.n] ix val) ([.t] val)} =>)
  } -> ([grid n t.] ({cap.own [.n t]} gpu.global val)))
})
