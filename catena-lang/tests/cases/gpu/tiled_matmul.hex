# tiled-matmul-launch-params :
#
#   (grid-rows × grid-cols × block-rows × block-cols)
#   ->
#   launch-params(
#     grid2d(grid-cols, grid-rows),
#     block2d(block-cols, block-rows))
(def program tiled-matmul-launch-params :
  ([grid-rows grid-cols block-rows block-cols.] {
    ({[.grid-rows] u64} :)
    ({[.grid-cols] u64} :)
    ({[.block-rows] u64} :)
    ({[.block-cols] u64} :)
  })
  ->
  ([grid-rows grid-cols block-rows block-cols.]
    ({
      ({[.grid-cols] [.grid-rows]} 2d)
      ({[.block-cols] [.block-rows]} 2d)
    } gpu.grid [grid.])
    ([.grid] gpu.launch_params val))
= ([grid-rows grid-cols block-rows block-cols.]
  ({[.grid-cols] [.grid-rows]} gpu.dimensions.2d.intro [grid.])
  ({[.block-cols] [.block-rows]} gpu.dimensions.2d.intro [block.])
  ({[.grid] [.block]} gpu.launch_params.intro [params.])
  [.params]
))

# tiled-matmul-via-mem :
#
#   mem.ref A × mem.ref B ×
#   rows × inner × cols ×
#   (rows * inner) × (inner * cols) × (rows * cols) ×
#   grid-rows × grid-cols × block-rows × block-cols
#   ->
#   mem.own C
#
#   rows = grid-rows * block-rows
#   cols = grid-cols * block-cols
#
# A and B initialize global storage after size checks. C is allocated
# uninitialized and returned through the mem ABI.
(def program tiled-matmul-via-mem :
  ([grid-rows grid-cols block-rows block-cols inner.] {
    ({[.grid-rows] [.block-rows]} nat.mul [rows.])
    ({[.grid-cols] [.block-cols]} nat.mul [cols.])

    (cap.ref mem)
    (cap.ref mem)

    ({[.rows] u64} :)
    ({[.inner] u64} :)
    ({[.cols] u64} :)

    ({({[.rows] [.inner]} nat.mul) u64} :)
    ({({[.inner] [.cols]} nat.mul) u64} :)
    ({({[.rows] [.cols]} nat.mul) u64} :)

    ({[.grid-rows] u64} :)
    ({[.grid-cols] u64} :)
    ({[.block-rows] u64} :)
    ({[.block-cols] u64} :)
  })
  ->
  ([grid-rows grid-cols block-rows block-cols inner.] (cap.own mem))
= ([
  a-mem b-mem
  rows inner cols
  a-size b-size c-size
  grid-rows grid-cols
  block-rows block-cols
.]
  ([.grid-rows] u64.copy-param [launch-grid-rows grid-rows-param.])
  ([.grid-cols] u64.copy-param [launch-grid-cols grid-cols-param.])
  ([.block-rows] u64.copy-param [launch-block-rows block-rows-param.])
  ([.block-cols] u64.copy-param [launch-block-cols block-cols-param.])
  ([.inner] u64.copy-param [persistent-inner inner-param.])
  ([.c-size] u64.copies2 [c-alloc-size c-result-size.])

  ([.a-mem] mem.cast.f32 [actual-a-size a-buffer.])
  ([.a-size actual-a-size]
    u64.eq [a-compatible if-a-compatible _if-a-incompatible.])
  ({[.a-compatible] [.if-a-compatible]} assert-then [a-size-proof.])
  ({[.a-buffer] [.a-size-proof]} gpu.global.alloc-from-buf [a.])

  ([.b-mem] mem.cast.f32 [actual-b-size b-buffer.])
  ([.b-size actual-b-size]
    u64.eq [b-compatible if-b-compatible _if-b-incompatible.])
  ({[.b-compatible] [.if-b-compatible]} assert-then [b-size-proof.])
  ({[.b-buffer] [.b-size-proof]} gpu.global.alloc-from-buf [b.])

  ({[.c-alloc-size] f32.type} gpu.global.alloc [c.])

  ({[.persistent-inner] [.cols]} *.intro [inner-cols.])
  ({[.rows] [.inner-cols]} *.intro [dimensions.])
  ({[.c] [.dimensions]} *.intro [c-and-dimensions.])
  ({[.b] [.c-and-dimensions]} *.intro [b-and-rest.])
  ({[.a] [.b-and-rest]} *.intro [persistent.])

  ({
    [.launch-grid-rows]
    [.launch-grid-cols]
    [.launch-block-rows]
    [.launch-block-cols]
  } tiled-matmul-launch-params [params.])

  ({
    [.params]
    [.persistent]
    ({
      [.grid-rows-param]
      [.grid-cols-param]
      [.block-rows-param]
      [.block-cols-param]
      [.inner-param]
    } name.gpu.f32.tiled-matmul)
  } gpu.launch [next-persistent.])

  ([.next-persistent] *.elim [_a next-b-and-rest.])
  ([.next-b-and-rest] *.elim [_b next-c-and-dimensions.])
  ([.next-c-and-dimensions] *.elim [next-c _dimensions.])
  ([.next-c] gpu.global.to-buf [result-buffer.])
  ({[.c-result-size] [.result-buffer]} buf.to-mem [result.])
  [.result]
))
