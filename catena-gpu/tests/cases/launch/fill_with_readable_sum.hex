# Each destination thread owns one destination cell and folds over a borrowed,
# read-only source buffer.

(def program write-readable-sum-in-bounds-branch : {[
  buffer-name buffer-size grid-shape block-shape global-shape global-size
  schedule-name thread-name candidate-index bounds-decision.
]
  ({[.bounds-decision] bool.t} = [bounds-true.])
  ({[.bounds-decision] bool.f} = [bounds-false.])
  ([.candidate-index buffer-size] u64.lt [is-in-bounds.])
  ({
    ([.bounds-true is-in-bounds] ==> |-)
    ({
      ({
        [.buffer-name buffer-size]
        ({[.grid-shape block-shape global-shape global-size]} gpu.grid)
        [.schedule-name]
      } gpu.scheduling val)
      ({
        ({[.buffer-size] u64} :)
        ({
          ({[.candidate-index] u64} :)
          ({
            ({[.bounds-decision] bool} :)
            ({
              ({[.thread-name]
                ({({[.grid-shape block-shape global-shape global-size]} gpu.grid)}
                  gpu.thread)} :)
              ({
                ({[.buffer-name] ({cap.own [.buffer-size] u64} gpu.global)} :)
                (u64 val)
              } *)
            } *)
          } *)
        } *)
      } *)
    } *)
  } *)
} -> {[
  buffer-name buffer-size grid-shape block-shape global-shape global-size
  schedule-name thread-name candidate-index bounds-decision.
]
  ({
    [.buffer-name buffer-size]
    ({[.grid-shape block-shape global-shape global-size]} gpu.grid)
    [.schedule-name]
  } gpu.scheduling val)
} = ([branch-input.]
  ([.branch-input] *.elim [in-bounds-if-true branch-state.])
  ([.branch-state] *.elim [scheduling length-and-tail.])
  ([.length-and-tail] *.elim [length candidate-and-tail.])
  ([.candidate-and-tail] *.elim [candidate bounds-and-tail.])
  ([.bounds-and-tail] *.elim [in-bounds thread-and-tail.])
  ([.thread-and-tail] *.elim [thread buffer-and-value.])
  ([.buffer-and-value] *.elim [buffer value.])
  ({[.in-bounds in-bounds-if-true]} assert-then [is-in-bounds.])
  ({[.candidate length is-in-bounds]} u64.to-ix [named-cell.])
  ([.named-cell] :.forget [cell.])
  ({[.scheduling thread cell]}
    gpu.scheduling.can-own
    [scheduling-after-decision thread-after-decision cell-after-decision
      allowed owns-if-allowed _not-owns-if-denied.])
  ({[.allowed owns-if-allowed]} assert-then [owns-cell.])
  ({[.thread-after-decision buffer cell-after-decision value owns-cell]}
    gpu.global.write)
  [.scheduling-after-decision]
))

(def program skip-readable-sum-out-of-bounds-branch : {[
  buffer-name buffer-size grid-shape block-shape global-shape global-size
  schedule-name thread-name candidate-index bounds-decision.
]
  ({[.bounds-decision] bool.t} = [bounds-true.])
  ({[.bounds-decision] bool.f} = [bounds-false.])
  ([.candidate-index buffer-size] u64.lt [is-in-bounds.])
  ({
    ([.is-in-bounds] {[.bounds-false] not} ==> |-)
    ({
      ({
        [.buffer-name buffer-size]
        ({[.grid-shape block-shape global-shape global-size]} gpu.grid)
        [.schedule-name]
      } gpu.scheduling val)
      ({
        ({[.buffer-size] u64} :)
        ({
          ({[.candidate-index] u64} :)
          ({
            ({[.bounds-decision] bool} :)
            ({
              ({[.thread-name]
                ({({[.grid-shape block-shape global-shape global-size]} gpu.grid)}
                  gpu.thread)} :)
              ({
                ({[.buffer-name] ({cap.own [.buffer-size] u64} gpu.global)} :)
                (u64 val)
              } *)
            } *)
          } *)
        } *)
      } *)
    } *)
  } *)
} -> {[
  buffer-name buffer-size grid-shape block-shape global-shape global-size
  schedule-name thread-name candidate-index bounds-decision.
]
  ({
    [.buffer-name buffer-size]
    ({[.grid-shape block-shape global-shape global-size]} gpu.grid)
    [.schedule-name]
  } gpu.scheduling val)
} = ([branch-input.]
  ([.branch-input] *.elim [_not-in-bounds-if-false branch-state.])
  ([.branch-state] *.elim [scheduling _unused-thread-state.])
  [.scheduling]
))

(def program sum-readable-cell-fold-step : {[source-buffer-name source-size.]
  ({
    ({({[.source-size]} shape.1d)} ix val)
    ({
      ({[.source-buffer-name]
        ({cap.ref [.source-size] u64} gpu.global)} :)
      (u64 val)
    } *)
  } *)
} -> {[source-buffer-name source-size.]
  ({
    ({[.source-buffer-name]
      ({cap.ref [.source-size] u64} gpu.global)} :)
    (u64 val)
  } *)
} = ([fold-input.]
  ([.fold-input] *.elim [cell state.])
  ([.state] *.elim [buffer sum.])
  ({[.buffer cell]} gpu.global.read [buffer-after-read cell-value.])
  ({[.sum cell-value]} u64.add [next-sum.])
  ({[.buffer-after-read next-sum]} *.intro [next-state.])
  [.next-state]
))

(def program fill-with-readable-sum-kernel : {[
  destination-buffer-name destination-size source-buffer-name source-size
  grid-shape block-shape global-shape global-size
  destination-schedule-name.
]
  ({
    ({
      ({[.destination-size] u64} :)
      ({
        ({[.destination-buffer-name]
          ({cap.own [.destination-size] u64} gpu.global)} :)
        ({
          ({
            [.destination-buffer-name destination-size]
            ({[.grid-shape block-shape global-shape global-size]} gpu.grid)
            [.destination-schedule-name]
          } gpu.scheduling val)
          ({
            [.destination-buffer-name]
            ({
              [.grid-shape]
              ({
                [.block-shape]
                ({
                  [.global-shape]
                  ({[.global-size destination-schedule-name]} *)
                } *)
              } *)
            } *)
          } *)
        } *)
      } *)
    } *)
    ({
      ({[.source-size] u64} :)
      ({
        ({[.source-buffer-name] ({cap.ref [.source-size] u64} gpu.global)} :)
        ({[.source-buffer-name] [.source-size]} *)
      } *)
    } *)
  } *)
  ({({[.grid-shape block-shape global-shape global-size]} gpu.grid)}
    gpu.thread val)
} -> {[
  destination-buffer-name destination-size source-buffer-name source-size
  grid-shape block-shape global-shape global-size
  destination-schedule-name.
]
  ({
    [.destination-buffer-name destination-size]
    ({[.grid-shape block-shape global-shape global-size]} gpu.grid)
    [.destination-schedule-name]
  } gpu.scheduling val)
} = ([kernel-arguments thread.]
  ([.kernel-arguments]
    *.elim
    [destination-arguments source-arguments.])
  ([.destination-arguments]
    *.elim
    [destination-length destination-tail.])
  ([.destination-tail]
    *.elim
    [destination-buffer destination-schedule-and-context.])
  ([.destination-schedule-and-context]
    *.elim
    [destination-scheduling destination-context.])
  ([.destination-context]
    *.elim
    [destination-buffer-name grid-context.])
  ([.grid-context] *.elim [grid-shape block-context.])
  ([.block-context] *.elim [block-shape global-shape-context.])
  ([.global-shape-context]
    *.elim
    [global-shape global-size-and-schedule.])
  ([.global-size-and-schedule]
    *.elim
    [global-size destination-schedule-name.])
  ([.source-arguments] *.elim [source-length source-tail.])
  ([.source-tail] *.elim [source-buffer source-context.])
  ([.source-context] *.elim [source-buffer-name source-size.])

  ([.destination-length]
    u64.copies2
    [destination-length-for-check destination-length-for-cell-and-name.])
  ([.destination-length-for-cell-and-name]
    u64.copies2
    [destination-length-for-cell destination-length-for-name.])
  ([.destination-length-for-name] :.param [destination-size-name.])
  ([.thread] gpu.thread.in-grid.index [thread-for-own grid-index.])
  ([.grid-index] ix.to-u64 [_grid-index-after candidate.])
  ([.candidate] u64.name [named-candidate.])
  ([.named-candidate]
    u64.copies2
    [candidate-for-check candidate-for-cell.])
  ({[.candidate-for-check destination-length-for-check]}
    u64.lt
    [destination-in-bounds destination-bounds-true _destination-bounds-false.])
  ([.destination-in-bounds]
    bool.copies2
    [destination-bounds-for-ifc destination-bounds-for-branch.])
  ([.destination-bounds-for-ifc] :.forget [destination-bounds-value.])
  ([.candidate-for-cell] :.ty [destination-candidate-for-state candidate-index.])
  ([.destination-bounds-for-branch]
    :.ty
    [destination-bounds-for-state bounds-decision.])

  ([.thread-for-own] gpu.thread.name [named-thread-for-fold.])
  ([.named-thread-for-fold] :.ty [thread-for-fold thread-name.])

  # The fold carries only the borrowed source buffer and scalar accumulator.
  u64.zero [zero-sum.]
  ({[.source-buffer zero-sum]} *.intro [initial-fold-state.])

  ({
    # loop-carried state
    [.initial-fold-state]
    # one iteration per bounded source index
    [.source-length]
    # direct body specialized to this borrowed buffer
    ({[.source-buffer-name source-size]} name.sum-readable-cell-fold-step)
  } fold [final-fold-state.])
  ([.final-fold-state] *.elim [source-buffer-after-fold sum.])
  ([.source-buffer-after-fold] gpu.global.forget)

  ({[.destination-buffer sum]} *.intro [destination-buffer-and-sum.])
  ({[.thread-for-fold destination-buffer-and-sum]}
    *.intro
    [destination-thread-and-tail.])
  ({[.destination-bounds-for-state destination-thread-and-tail]}
    *.intro
    [destination-bounds-and-tail.])
  ({[.destination-candidate-for-state destination-bounds-and-tail]}
    *.intro
    [destination-candidate-and-tail.])
  ({[.destination-length-for-cell destination-candidate-and-tail]}
    *.intro
    [destination-length-and-tail.])
  ({[.destination-scheduling destination-length-and-tail]}
    *.intro
    [destination-branch-state.])

  ({[.destination-buffer-name destination-size-name grid-shape block-shape global-shape
      global-size destination-schedule-name thread-name candidate-index bounds-decision]}
    name.write-readable-sum-in-bounds-branch
    [destination-true-branch.])
  ({[.destination-buffer-name destination-size-name grid-shape block-shape global-shape
      global-size destination-schedule-name thread-name candidate-index bounds-decision]}
    name.skip-readable-sum-out-of-bounds-branch
    [destination-false-branch.])
  ({[.destination-bounds-true destination-true-branch
      _destination-bounds-false destination-false-branch
      destination-bounds-value destination-branch-state]}
    bool.ifc
    [destination-scheduling-after-bounds.])

  [.destination-scheduling-after-bounds]
))

(def program fill-with-readable-sum :
  {(cap.own mem) (cap.ref mem) (u64 val) (u64 val)}
  ->
  (cap.own mem)
= ([destination-input source-input grid-x-value block-x-value.]
  ([.destination-input]
    mem.cast.u64
    [destination-length named-destination-buffer.])
  ([.named-destination-buffer]
    :.ty
    [destination-buffer destination-buffer-name.])
  ([.source-input] mem.cast.u64 [source-length named-source-buffer.])
  ([.named-source-buffer]
    :.ty
    [source-buffer source-buffer-name.])

  ([.grid-x-value] u64.name [grid-x.])
  ([.block-x-value] u64.name [block-x.])
  ({[.grid-x block-x]}
    gpu.grid.1d.intro
    [grid-shape block-shape global-shape grid global-size.])

  ([.destination-length]
    u64.copies2
    [destination-length-for-launch destination-length-for-check-and-name.])
  ([.destination-length-for-check-and-name]
    u64.copies2
    [destination-length-for-fit destination-length-for-name.])
  ([.destination-length-for-name] :.param [destination-size.])
  ([.global-size]
    u64.copies2
    [global-size-for-fit global-size-for-name.])
  ([.global-size-for-name] :.param [global-size-name.])
  ({[.destination-length-for-fit global-size-for-fit]}
    u64.lte
    [fits-decision fits-if-true.])
  ([.fits-decision] assert [fits-is-true.])
  ({[.fits-is-true fits-if-true]} ax-mp [fits.])
  ({[.destination-buffer-name grid-shape block-shape global-shape fits]}
      gpu.scheduling.own-each
    [destination-schedule-name destination-scheduling.])

  ([.source-length]
    u64.copies2
    [source-length-for-kernel source-length-for-name.])
  ([.source-length-for-name] :.param [source-size.])
  ({[.source-buffer-name source-size]} *.intro [source-context.])
  ({[.source-buffer source-context]} *.intro [source-tail.])
  ({[.source-length-for-kernel source-tail]} *.intro [source-arguments.])

  ({[.global-size-name destination-schedule-name]}
    *.intro
    [global-size-and-destination-schedule.])
  ({[.global-shape global-size-and-destination-schedule]}
    *.intro
    [global-shape-context.])
  ({[.block-shape global-shape-context]} *.intro [block-context.])
  ({[.grid-shape block-context]} *.intro [grid-context.])
  ({[.destination-buffer-name grid-context]} *.intro [destination-context.])
  ({[.destination-scheduling destination-context]}
    *.intro
    [destination-schedule-and-context.])
  ({[.destination-buffer destination-schedule-and-context]}
    *.intro
    [destination-tail.])
  ({[.destination-length-for-launch destination-tail]}
    *.intro
    [destination-arguments.])
  ({[.destination-arguments source-arguments]}
    *.intro
    [kernel-arguments.])

  ({[.destination-buffer-name destination-size source-buffer-name source-size grid-shape block-shape
      global-shape global-size-name destination-schedule-name]}
    name.fill-with-readable-sum-kernel
    [kernel.])
  ({[.grid kernel-arguments kernel]}
    gpu.launch
    [returned-kernel-arguments.])
  ([.returned-kernel-arguments]
    *.elim
    [returned-destination-arguments returned-source-arguments.])
  ([.returned-destination-arguments]
    *.elim
    [destination-length-after-launch returned-destination-tail.])
  ([.returned-destination-tail]
    *.elim
    [destination-buffer-after-launch _returned-destination-schedule-and-context.])
  ({[.destination-length-after-launch destination-buffer-after-launch]}
    gpu.global.to-mem
    [destination-output.])
  [.destination-output]
))
