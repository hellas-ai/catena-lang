# Row-major views over linear GPU global storage.
#
# gpu.f32.tiled-matmul :
#
#   A-view × B-view × dimensions ×
#   (state × ((row × col) × (shared-A × shared-B)))
#   ->
#   state × (C[row,col] × (shared-A × shared-B))
(theory program type {
  # Layout-independent tiled cell producer.
  (def gpu.f32.tiled-matmul : {[rows cols inner tile-size.]
    ({({([.rows] ix val) ([.inner] ix val)} *) (f32 val)} =>)
    ({({([.inner] ix val) ([.cols] ix val)} *) (f32 val)} =>)

    ({[.rows] u64} :)
    ({[.inner] u64} :)
    ({[.cols] u64} :)

    ({([.rows] ix val) ([.cols] ix val)} * [logical-index.])

    ({
      ({[.tile-size] [.tile-size]} nat.mul [shared-len.])
      ({[.shared-len] f32} gpu.shared val)
      ({[.shared-len] f32} gpu.shared val)
    } * [shared.])

    ({[.logical-index] [.shared]} * [resources.])
    ({gpu.state [.resources]} * [kernel-args.])

    ({(f32 val) [.shared]} * [next-resources.])
    ({gpu.state [.next-resources]} * [kernel-coargs.])

    ([.kernel-args])
  } -> ([rows cols inner tile-size.]
    ({
      ({[.tile-size] [.tile-size]} nat.mul [shared-len.])
      ({[.shared-len] f32} gpu.shared val)
      ({[.shared-len] f32} gpu.shared val)
    } * [shared.])

    ({(f32 val) [.shared]} * [next-resources.])
    ({gpu.state [.next-resources]} * [kernel-coargs.])

    ([.kernel-coargs]))
  = ([a-view b-view rows inner cols kernel-args.]
    ([.kernel-args] *.elim [state resources.])
    ([.resources] *.elim [logical-index shared.])

    ([.rows] :.param [row-param.])
    ([.cols] :.param [col-param.])

    ({
      [.row-param]
      [.col-param]
      [.inner]
      [.a-view]
      [.b-view]
      [.logical-index]
    } f32.matmul.cell-dot [value.])

    ({[.value] [.shared]} *.intro [next-resources.])
    ({[.state] [.next-resources]} *.intro)
  ))

  # Map a 2D invocation to logical matrix indices and a flat row-major index.
  (arr gpu.row-major.indexer.2d : {[
    rows cols grid-rows grid-cols tile-size
  .]
    ({
      ({[.grid-cols] [.grid-rows]} 2d)
      ({[.tile-size] [.tile-size]} 2d)
    } gpu.grid [grid.])

    ([.grid] gpu.env)
  } -> {[
    rows cols grid-rows grid-cols tile-size
  .]
    ({
      ({[.grid-cols] [.grid-rows]} 2d)
      ({[.tile-size] [.tile-size]} 2d)
    } gpu.grid [grid.])

    ({([.rows] ix val) ([.cols] ix val)} * [logical-index.])
    ({[.logical-index] (({[.rows] [.cols]} *) ix val)} *)
  })

})

# Divide one named dimension by another and assert that the division is exact.
(def program u64.perfect-div :
  ([n divisor.] {
    ({[.n] u64} :)
    ({[.divisor] u64} :)
  })
  ->
  ([n divisor.] ({({[.n] [.divisor]} nat.div) u64} :))
= ([n divisor.]
  ([.divisor] u64.copies2 [divisor-for-positive divisor-for-div.])
  ([.divisor-for-positive] u64.assert-nz [divisor-positive.])
  ({[.n] [.divisor-for-div] [.divisor-positive]} u64.div [
    quotient exact.
  ])
  ([.exact] assert [_perfect-tiling.])
  [.quotient]
))

# Compute the launch geometry for square, perfectly tiled matrix
# multiplication. All three logical dimensions must be exact multiples.
(def program gpu.tiled-matmul.perfect-launch-params :
  ([rows cols inner tile-size.] {
    ({[.rows] u64} :)
    ({[.cols] u64} :)
    ({[.inner] u64} :)
    ({[.tile-size] u64} :)
  })
  ->
  ([rows cols inner tile-size.]
    {
      ({
        ({
          ({[.cols] [.tile-size]} nat.div)
          ({[.rows] [.tile-size]} nat.div)
        } 2d)
        ({[.tile-size] [.tile-size]} 2d)
      } gpu.grid [grid.])
      ([.grid] gpu.launch_params val)
      ({({[.inner] [.tile-size]} nat.div) u64} :)
    }
  )
= ([rows cols inner tile-size.]
  ([.tile-size] u64.copies5 [
    tile-for-rows
    tile-for-cols
    tile-for-inner
    block-cols
    block-rows.
  ])
  ({[.rows] [.tile-for-rows]} u64.perfect-div [grid-rows.])
  ({[.cols] [.tile-for-cols]} u64.perfect-div [grid-cols.])
  ({[.inner] [.tile-for-inner]} u64.perfect-div [inner-tile-count.])

  ({[.grid-cols] [.grid-rows]}
    gpu.dimensions.2d.intro [grid.])
  ({[.block-cols] [.block-rows]} gpu.dimensions.2d.intro [block.])
  ({[.grid] [.block]} gpu.launch_params.intro [params.])
  {[.params] [.inner-tile-count]}
))

# Read a flat f32 global allocation with the allocation first, so partial
# application produces an indexed flat view.
(def program gpu.f32.global.row-major.flat-at :
  ([rows cols.] {
    ({
      cap.ref
      ({[.rows] [.cols]} *)
      f32
    } gpu.global val)
    (({[.rows] [.cols]} *) ix val)
  })
  ->
  ([rows cols.] (f32 val))
= ([global i.]
  {[.i] [.global]} gpu.global.ix
))

# Adapt linear global storage to the ordinary row-major matrix-view definition.
(def program gpu.f32.global.row-major.view :
  ([rows cols.] {
    ({[.rows] u64} :)
    ({[.cols] u64} :)
    ({
      cap.ref
      ({[.rows] [.cols]} *)
      f32
    } gpu.global val)
  })
  ->
  ([rows cols.]
    ({({([.rows] ix val) ([.cols] ix val)} *) (f32 val)} =>))
= ([rows cols global.]
  ([.rows] u64.copy-param [view-rows rows-param.])
  ([.cols] u64.copy-param [view-cols cols-param.])

  ({
    [.rows-param]
    [.cols-param]
    [.global]
  } partial.gpu.f32.global.row-major.flat-at.1 [flat-view.])

  ({
    [.view-rows]
    [.view-cols]
    [.flat-view]
  } f32.row-major.matrix-view)
))

# gpu.f32.tiled-matmul.row-major.materialize :
#
#   launch-params × A-view × B-view × dimensions
#   ->
#   C-global
(def program gpu.f32.tiled-matmul.row-major.materialize :
  ([rows cols inner tile-size grid-rows grid-cols.] {
    ({
      ({[.grid-cols] [.grid-rows]} 2d)
      ({[.tile-size] [.tile-size]} 2d)
    } gpu.grid [grid.])
    ([.grid] gpu.launch_params val)

    ({({([.rows] ix val) ([.inner] ix val)} *) (f32 val)} =>)
    ({({([.inner] ix val) ([.cols] ix val)} *) (f32 val)} =>)

    ({[.rows] u64} :)
    ({[.inner] u64} :)
    ({[.cols] u64} :)

  })
  ->
  ([rows cols inner tile-size grid-rows grid-cols.]
    ({cap.own ({[.rows] [.cols]} *) f32} gpu.global val))
= ([
  params
  a-view b-view
  rows inner cols
.]
  ([.rows] u64.copies2-param [
    dimensions-rows c-size-rows rows-param.
  ])
  ([.inner] u64.copy-param [dimensions-inner inner-param.])
  ([.cols] u64.copies2-param [
    dimensions-cols c-size-cols cols-param.
  ])
  ({[.c-size-rows] [.c-size-cols]} u64.product [c-size.])

  ([.params] gpu.launch_params.2d-2d.params [
    materialize-params
    grid-cols-param grid-rows-param
    tile-size-param _tile-size-param.
  ])

  (({
    [.rows-param]
    [.cols-param]
    [.grid-rows-param]
    [.grid-cols-param]
    [.tile-size-param]
  } name.gpu.row-major.indexer.2d) lift [indexer.])

  ({
    [.rows-param]
    [.cols-param]
    [.inner-param]
    [.tile-size-param]
    [.a-view]
    [.b-view]
    [.dimensions-rows]
    [.dimensions-inner]
    [.dimensions-cols]
  } partial.gpu.f32.tiled-matmul.5 [producer.])

  ({
    [.materialize-params]
    [.c-size]
    [.indexer]
    [.producer]
  } gpu.materialize)
))
