# Execution contexts and workers
(theory type nat {
  # Shapes describe worker coordinates. `dims s n` pairs an arbitrary shape
  # `s` with its linear cardinality `n`.
  (arr shape.2d : 2 -> 1)
  (arr dims : 2 -> 1)

  # `topo.level l d p` adds custom level `l`, with dimensions `d`, before `p`.
  (arr topo.end : 0 -> 1)
  (arr topo.level : 3 -> 1)

  # `context c p s` identifies execution `c`, complete topology `p`, and the
  # selected topology node `s`.
  (arr context : 3 -> 1)

  # `worker c p s` identifies the current worker in that context.
  (arr worker : 3 -> 1)

  # `parallel.plan c p` describes execution `c` over complete topology `p`.
  (arr parallel.plan : 2 -> 1)
})

(theory program type {
  # Schedule a plan and select the root of its complete topology.
  (arr parallel.schedule :
    ([c p.] ({[.c p]} parallel.plan))
    ->
    ([c p.] ({[.c p p]} context)))

  # Allocate an owned block-local buffer in an execution context.
  (arr parallel.allocate : {[c p s n t.]
    ({[.c p s]} context)
    ({[.n] u64} :)
    ([.t])
  }
  ->
  ([c p s n t.] {
    ({[.c p s]} context)
    ({({[.c p s]} context) ({cap.own [.n t]} buf)} writable val)
  }))

  # Wait until writes into a buffer are visible to the context's workers.
  # The bare buffer no longer records which context made it available.
  (arr parallel.await : {[c p s m n t.]
    ({[.c p s]} context)
    ({({[.c p s]} context) ({[.m n t]} buf)} pending val)
  }
  ->
  ([c p s m n t.] {
    ({[.c p s]} context)
    ({[.m n t]} buf val)
  }))

  # Wait until the context's workers have finished reading a buffer and make
  # it writable again. TODO: because await returns a bare buffer, this type
  # cannot prove that the buffer came from this same context.
  (arr parallel.release : {[c p s m n t.]
    ({[.c p s]} context)
    ({[.m n t]} buf val)
  }
  ->
  ([c p s m n t.] {
    ({[.c p s]} context)
    ({({[.c p s]} context) ({[.m n t]} buf)} writable val)
  }))

  # Synchronize the workers without changing any buffer state.
  (arr parallel.barrier :
    ({[c p s.] [.c p s]} context)
    ->
    ({[c p s.] [.c p s]} context))

  # Select the immediate child topology containing the current worker.
  (arr parallel.scope : {[
    c p
    parent parent-shape parent-size
    child child-shape child-size
    rest.
  ]
    ({
      [.c p]
      ({
        [.parent]
        ({[.parent-shape parent-size]} dims)
        ({
          [.child]
          ({[.child-shape child-size]} dims)
          [.rest]
        } topo.level)
      } topo.level)
    } context)
    ({
      [.c p]
      ({
        [.parent]
        ({[.parent-shape parent-size]} dims)
        ({
          [.child]
          ({[.child-shape child-size]} dims)
          [.rest]
        } topo.level)
      } topo.level)
    } worker)
  }
  ->
  ([
    c p
    parent parent-shape parent-size
    child child-shape child-size
    rest.
  ] {
    ({
      [.c p]
      ({
        [.child]
        ({[.child-shape child-size]} dims)
        [.rest]
      } topo.level)
    } context)
    ({
      [.c p]
      ({
        [.child]
        ({[.child-shape child-size]} dims)
        [.rest]
      } topo.level)
    } worker)
  }))

  # parallel.materialize :
  #   context c p (topo.level l (dims s n) q)
  #   * val(writable (context c p (topo.level l (dims s n) q))
  #                  (buf cap.own n t))
  #   * (context ... * worker ... * val(ix n) => val(t))
  #  -> val(pending (context c p (topo.level l (dims s n) q))
  #                 (buf cap.own n t))
  (arr parallel.materialize : {[c p l s n q t.]
    ({[.c p] ({[.l] ({[.s n]} dims) [.q]} topo.level)} context)
    ({
      ({[.c p] ({[.l] ({[.s n]} dims) [.q]} topo.level)} context)
      ({cap.own [.n t]} buf)
    } writable val)
    ({
      ({
        ({[.c p] ({[.l] ({[.s n]} dims) [.q]} topo.level)} context)
        ({
          ({[.c p] ({[.l] ({[.s n]} dims) [.q]} topo.level)} worker)
          ([.n] ix val)
        } *)
      } *)
      ([.t] val)
    } =>)
  }
  ->
  ([c p l s n q t.] {
    ({[.c p] ({[.l] ({[.s n]} dims) [.q]} topo.level)} context)
    ({
      ({[.c p] ({[.l] ({[.s n]} dims) [.q]} topo.level)} context)
      ({cap.own [.n t]} buf)
    } pending val)
  }))
})
