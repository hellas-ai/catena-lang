# Minimal launch, scheduling, and permission model.

(theory type nat {
  (arr gpu.grid : 3 -> 1)
  (arr gpu.thread : 1 -> 1)
  (arr gpu.block : 2 -> 1)

  # A named slot in a block-local shared allocation. The allocation name is
  # used by barrier permissions; the slot name distinguishes handles within
  # that allocation.
  (arr gpu.shared : 5 -> 1)

  # Shared-memory propositions indexed by the synchronization phase and the
  # exact resources participating in its barrier protocol.
  (arr gpu.shared.owns : 4 -> 1)
  (arr gpu.shared.reads : 3 -> 1)

  # A typed list of shared slots whose runtime value is the total byte size
  # requested for each block at kernel launch.
  (arr gpu.shared.layout : 1 -> 1)
  (arr gpu.shared.empty : 0 -> 1)
  (arr gpu.shared.slot : 4 -> 1)

  # A canonical, type-level description of the barriers remaining in a
  # kernel. Cursors are erased linear witnesses threaded through kernel code.
  (arr gpu.barrier.trace.end : 0 -> 1)
  (arr gpu.barrier.trace.sync : 2 -> 1)
  (arr gpu.barrier.trace.repeat : 3 -> 1)
  (arr gpu.barrier.cursor : 2 -> 1)

  # A barrier definition relates an identity to its trusted pre-proof and
  # post-proof types. Definitions are stored directly in synchronization
  # traces; gpu.sync neither constructs nor interprets either proof.
  (arr gpu.barrier.step : 3 -> 1)

  # A global handle is independent of the thread layout.
  (arr gpu.global : 3 -> 1)

  # The scheduling relates buffer cells to global thread indices.
  (arr gpu.scheduling : 4 -> 1)
  (arr gpu.schedule.owns : 4 -> 1)
  (arr gpu.shared.scheduling : 5 -> 1)
})

(theory program type {
  # Construct a dynamic shared-memory layout. Slots are added on the host;
  # allocation and typed handles inside the kernel are intentionally separate.
  (arr gpu.shared.layout.empty :
    [] -> (gpu.shared.empty gpu.shared.layout val))
  (arr gpu.shared.layout.add : {[slot-name n element-type rest.]
    ({[.n] u64} :)
    ([.element-type] gpu.numeric |-)
    ([.rest] gpu.shared.layout val)
    [.slot-name]
  } -> {[slot-name n element-type rest.]
    ({[.slot-name n element-type rest]} gpu.shared.slot gpu.shared.layout val)
  })

  (arr gpu.shared.layout.with-name : {[shared-slots shared-name.]
    ([.shared-slots] gpu.shared.layout val)
    [.shared-name]
  } -> {[shared-slots shared-name.]
    ({[.shared-name] ([.shared-slots] gpu.shared.layout)} :)
  })

  # Inspect the static description of the first slot without taking it.
  (arr gpu.shared.layout.head : {[
    shared-name slot-name elements element-type rest.
  ]
    ({[.shared-name]
      ({[.slot-name elements element-type rest]}
        gpu.shared.slot gpu.shared.layout)} :)
  } -> {[
    shared-name slot-name elements element-type rest.
  ]
    ({[.shared-name]
      ({[.slot-name elements element-type rest]}
        gpu.shared.slot gpu.shared.layout)} :)
    [.elements]
    [.element-type]
    [.slot-name]
  })

  # Logical dimensionality is preserved in shapes. CUDA's three-dimensional
  # launch values remain a backend detail.
  (arr gpu.grid.1d.intro : {[gx bx.]
    ({[.gx] positive-u32} :)
    ({[.bx] positive-u32} :)
  } -> {[gx bx.]
    ({[.gx]} shape.1d)
    ({[.bx]} shape.1d)
    ({({[.gx bx]} *)} shape.1d)
    ({
      ({[.gx]} shape.1d)
      ({[.bx]} shape.1d)
      ({({[.gx bx]} *)} shape.1d)
    } gpu.grid val)
    ({({[.gx bx]} *) u64} :)
  })

  (arr gpu.grid.2d.intro : {[gx gy bx by.]
    ({[.gx] positive-u32} :)
    ({[.gy] positive-u32} :)
    ({[.bx] positive-u32} :)
    ({[.by] positive-u32} :)
  } -> {[gx gy bx by.]
    ({[.gx gy]} shape.2d)
    ({[.bx by]} shape.2d)
    ({({[.gx bx]} *) ({[.gy by]} *)} shape.2d)
    ({[.gx bx]} *)
    ({[.gy by]} *)
    ({
      ({[.gx gy]} shape.2d)
      ({[.bx by]} shape.2d)
      ({({[.gx bx]} *) ({[.gy by]} *)} shape.2d)
    } gpu.grid val)
  })

  (arr gpu.grid.3d.intro : {[gx gy gz bx by bz.]
    ({[.gx] positive-u32} :)
    ({[.gy] positive-u32} :)
    ({[.gz] positive-u32} :)
    ({[.bx] positive-u32} :)
    ({[.by] positive-u32} :)
    ({[.bz] positive-u32} :)
  } -> {[gx gy gz bx by bz.]
    ({[.gx gy gz]} shape.3d)
    ({[.bx by bz]} shape.3d)
    ({({[.gx bx]} *) ({[.gy by]} *) ({[.gz bz]} *)} shape.3d)
    ({[.gx bx]} *)
    ({[.gy by]} *)
    ({[.gz bz]} *)
    ({
      ({[.gx gy gz]} shape.3d)
      ({[.bx by bz]} shape.3d)
      ({({[.gx bx]} *) ({[.gy by]} *) ({[.gz bz]} *)} shape.3d)
    } gpu.grid val)
  })

  # Coordinates of the thread in the complete launch grid.
  (arr gpu.thread.in-grid.index : {[
    grid-shape block-shape global-shape.
  ]
    ({({[.grid-shape block-shape global-shape]} gpu.grid)}
      gpu.thread val)
  } -> {[grid-shape block-shape global-shape.]
    ({({[.grid-shape block-shape global-shape]} gpu.grid)}
      gpu.thread val)
    ([.global-shape] ix val)
  })

  # Coordinates of the same thread relative to its CUDA block.
  (arr gpu.thread.in-block.index : {[
    grid-shape block-shape global-shape.
  ]
    ({({[.grid-shape block-shape global-shape]} gpu.grid)}
      gpu.thread val)
  } -> {[grid-shape block-shape global-shape.]
    ({({[.grid-shape block-shape global-shape]} gpu.grid)}
      gpu.thread val)
    ([.block-shape] ix val)
  })

  # Flatten the current thread's block-local coordinate into the cell space
  # described by a two-slot shared layout. The shared scheduler below guards
  # the resulting ownership claim.
  (arr gpu.thread.in-block.linear-index : {[
    grid-shape block-shape global-shape tile-elements element-type
    first-name second-name.
  ]
    ({({[.grid-shape block-shape global-shape]} gpu.grid)}
      gpu.thread val)
    ({
      [.first-name tile-elements element-type]
      ({[.second-name tile-elements element-type] gpu.shared.empty} gpu.shared.slot)
    } gpu.shared.slot gpu.shared.layout val)
  } -> {[
    grid-shape block-shape global-shape tile-elements element-type
    first-name second-name.
  ]
    ({({[.grid-shape block-shape global-shape]} gpu.grid)}
      gpu.thread val)
    ({
      [.first-name tile-elements element-type]
      ({[.second-name tile-elements element-type] gpu.shared.empty} gpu.shared.slot)
    } gpu.shared.slot gpu.shared.layout val)
    ({({[.tile-elements]} shape.1d)} ix val)
  })

  # Attach a fresh static name to the current thread so permissions can refer
  # to its stable launch identity.
  (arr gpu.thread.name : {[grid-topology thread-name.]
    ([.grid-topology] gpu.thread val)
  } -> ([grid-topology thread-name.]
    ({[.thread-name] ([.grid-topology] gpu.thread)} :)))

  # Bind the current thread to an identity already supplied by a protocol.
  (arr gpu.thread.with-name : {[grid-topology thread-name.]
    ([.grid-topology] gpu.thread val)
    [.thread-name]
  } -> {[grid-topology thread-name.]
    ({[.thread-name] ([.grid-topology] gpu.thread)} :)
  })

  # Obtain the opaque block containing a thread. The block's own index is
  # available only through gpu.block.index.
  (arr gpu.thread.block : {[grid-topology block-name.]
    ([.grid-topology] gpu.thread val)
  } -> {[grid-topology block-name.]
    ([.grid-topology] gpu.thread val)
    ({[.block-name] ({[.grid-topology block-name]} gpu.block)} :)
  })

  (arr gpu.block.index : {[
    grid-shape block-shape global-shape block-name.
  ]
    ({[.block-name]
      ({({[.grid-shape block-shape global-shape]} gpu.grid) [.block-name]}
        gpu.block)} :)
  } -> {[grid-shape block-shape global-shape block-name.]
    ({[.block-name]
      ({({[.grid-shape block-shape global-shape]} gpu.grid) [.block-name]}
        gpu.block)} :)
    ([.grid-shape] ix val)
  })

  # Take the first named slot from a layout. The size value is threaded so a
  # dynamic layout can advance to the next slot at runtime; its static name
  # must match the size recorded in the layout.
  (arr gpu.shared.take : {[
    grid-topology block-name thread-name shared-name slot-name
    elements element-type rest.
  ]
    ({[.shared-name]
      ({[.slot-name elements element-type rest]}
        gpu.shared.slot gpu.shared.layout)} :)
    ({[.elements] u64} :)
    ({[.thread-name] ([.grid-topology] gpu.thread)} :)
    ({[.block-name]
      ({[.grid-topology block-name]} gpu.block)} :)
  } -> {[
    grid-topology block-name thread-name shared-name slot-name
    elements element-type rest.
  ]
    ({[.shared-name] ([.rest] gpu.shared.layout)} :)
    ({[.elements] u64} :)
    ({[.thread-name] ([.grid-topology] gpu.thread)} :)
    ({[.block-name]
      ({[.grid-topology block-name]} gpu.block)} :)
    ({[.shared-name]
      ({[.shared-name block-name slot-name elements element-type]} gpu.shared)} :)
  })

  # Return a slot to the front of its layout. This is the linear inverse of
  # take and makes it impossible to silently discard a shared handle.
  (arr gpu.shared.put : {[
    block-name shared-name slot-name elements element-type rest.
  ]
    ({[.shared-name] ([.rest] gpu.shared.layout)} :)
    ({[.elements] u64} :)
    ({[.shared-name]
      ({[.shared-name block-name slot-name elements element-type]} gpu.shared)} :)
  } -> {[
    block-name shared-name slot-name elements element-type rest.
  ]
    ({[.shared-name]
      ({[.slot-name elements element-type rest]}
        gpu.shared.slot gpu.shared.layout)} :)
    ({[.elements] u64} :)
  })

  # Close a fully reconstructed layout after the final read-to-write
  # transition. The restored proof ensures the allocation is not abandoned
  # in its read phase.
  (arr gpu.shared.layout.close : {[
    grid-topology block-name thread-name shared-name cell-name slots
    elements phase.
  ]
    ({[.shared-name] ([.slots] gpu.shared.layout)} :)
    ({[.thread-name] ([.grid-topology] gpu.thread)} :)
    ({[.block-name]
      ({[.grid-topology block-name]} gpu.block)} :)
    ({[.cell-name] ({({[.elements]} shape.1d)} ix)} :)
    ({[.phase thread-name cell-name shared-name]} gpu.shared.owns |-)
  } -> {[
    grid-topology block-name thread-name shared-name cell-name slots
    elements phase.
  ]
    ({[.thread-name] ([.grid-topology] gpu.thread)} :)
  })

  # Read one bounded cell while holding this thread's read-phase proof. Every
  # resource and the proof are returned so several slots can be read during
  # the same phase.
  (arr gpu.shared.read : {[
    grid-topology block-name shared-name slot-name buffer-size element-type
    phase thread-name cell-index.
  ]
    ({[.thread-name] ([.grid-topology] gpu.thread)} :)
    ({[.block-name]
      ({[.grid-topology block-name]} gpu.block)} :)
    ({[.shared-name]
      ({[.shared-name block-name slot-name buffer-size element-type]} gpu.shared)} :)
    ({[.cell-index] ({({[.buffer-size]} shape.1d)} ix)} :)
    ({[.phase thread-name shared-name]} gpu.shared.reads |-)
  } -> {[
    grid-topology block-name shared-name slot-name buffer-size element-type
    phase thread-name cell-index.
  ]
    ({[.thread-name] ([.grid-topology] gpu.thread)} :)
    ({[.block-name]
      ({[.grid-topology block-name]} gpu.block)} :)
    ({[.shared-name]
      ({[.shared-name block-name slot-name buffer-size element-type]} gpu.shared)} :)
    ({[.cell-index] ({({[.buffer-size]} shape.1d)} ix)} :)
    ({[.phase thread-name shared-name]} gpu.shared.reads |-)
    ([.element-type] val)
  })

  # Write the exact shared cell owned by the current named thread. Ownership
  # is preserved, allowing the thread to populate both slots before syncing.
  (arr gpu.shared.write : {[
    grid-topology block-name shared-name slot-name buffer-size element-type
    phase thread-name cell-index.
  ]
    ({[.thread-name] ([.grid-topology] gpu.thread)} :)
    ({[.block-name]
      ({[.grid-topology block-name]} gpu.block)} :)
    ({[.shared-name]
      ({[.shared-name block-name slot-name buffer-size element-type]} gpu.shared)} :)
    ({[.cell-index] ({({[.buffer-size]} shape.1d)} ix)} :)
    ([.element-type] val)
    ({[.phase thread-name cell-index shared-name]} gpu.shared.owns |-)
  } -> {[
    grid-topology block-name shared-name slot-name buffer-size element-type
    phase thread-name cell-index.
  ]
    ({[.thread-name] ([.grid-topology] gpu.thread)} :)
    ({[.block-name]
      ({[.grid-topology block-name]} gpu.block)} :)
    ({[.shared-name]
      ({[.shared-name block-name slot-name buffer-size element-type]} gpu.shared)} :)
    ({[.cell-index] ({({[.buffer-size]} shape.1d)} ix)} :)
    ({[.phase thread-name cell-index shared-name]} gpu.shared.owns |-)
  })

  # Synchronize all threads in the exact block represented by this token,
  # consume the named event, and apply its trusted state transition.
  (arr gpu.sync : {[
    grid-topology block-name barrier-name pre-proof post-proof remaining-trace.
  ]
    ({[.block-name]
      ({[.grid-topology block-name]} gpu.block)} :)
    ({
      [.grid-topology]
      ({
        ({[.barrier-name] [.pre-proof] [.post-proof]} gpu.barrier.step)
        [.remaining-trace]
      } gpu.barrier.trace.sync)
    } gpu.barrier.cursor |-)
    ([.pre-proof])
  } -> {[
    grid-topology block-name barrier-name pre-proof post-proof remaining-trace.
  ]
    ({[.block-name]
      ({[.grid-topology block-name]} gpu.block)} :)
    ({[.grid-topology] [.remaining-trace]} gpu.barrier.cursor |-)
    ([.post-proof])
  })

  # Reveal the shared resource identities named by the first barrier of a
  # repeated protocol while preserving its linear cursor.
  (arr gpu.barrier.shared.resources : {[
    grid-topology count barrier-name write-phase read-phase
    thread-name cell-name shared-name body-rest remaining-trace.
  ]
    ({
      [.grid-topology]
      ({
        [.count]
        ({
          ({
            [.barrier-name]
            ({[.write-phase thread-name cell-name shared-name]}
              gpu.shared.owns |-)
            ({[.read-phase thread-name shared-name]} gpu.shared.reads |-)
          } gpu.barrier.step)
          [.body-rest]
        } gpu.barrier.trace.sync)
        [.remaining-trace]
      } gpu.barrier.trace.repeat)
    } gpu.barrier.cursor |-)
  } -> {[
    grid-topology count barrier-name write-phase read-phase
    thread-name cell-name shared-name body-rest remaining-trace.
  ]
    ({
      [.grid-topology]
      ({
        [.count]
        ({
          ({
            [.barrier-name]
            ({[.write-phase thread-name cell-name shared-name]}
              gpu.shared.owns |-)
            ({[.read-phase thread-name shared-name]} gpu.shared.reads |-)
          } gpu.barrier.step)
          [.body-rest]
        } gpu.barrier.trace.sync)
        [.remaining-trace]
      } gpu.barrier.trace.repeat)
    } gpu.barrier.cursor |-)
    [.thread-name]
    [.cell-name]
    [.shared-name]
    [.write-phase]
    [.read-phase]
  })

  # Fold a block-uniform number of times. The body consumes the same complete
  # barrier sub-trace on every iteration; the outer cursor consumes one
  # symbolic repeat node rather than unrolling the trace.
  (arr gpu.fold : {[count state grid-topology body-trace remaining-trace.]
    ([.state])
    ({[.count] u64} :)
    ({
      [.grid-topology]
      ({[.count] [.body-trace] [.remaining-trace]}
        gpu.barrier.trace.repeat)
    } gpu.barrier.cursor |-)
    ({
      ({
        ({({[.count]} shape.1d)} ix val)
        ({
          ([.state])
          ({[.grid-topology] [.body-trace]} gpu.barrier.cursor |-)
        } *)
      } *)
      ({
        ([.state])
        ({[.grid-topology] gpu.barrier.trace.end} gpu.barrier.cursor |-)
      } *)
    } -> val)
  } -> {[count state grid-topology body-trace remaining-trace.]
    ([.state])
    ({[.grid-topology] [.remaining-trace]} gpu.barrier.cursor |-)
  })

  # The fixed linear policy assigns buffer cell i to global thread i. It is
  # race-free by construction. The proof ensures every buffer cell has a
  # corresponding global thread; excess threads simply receive no cell.
  (arr gpu.scheduling.own-each : {[
    buffer-name buffer-size grid-count block-count global-count global-size
    schedule-name.
  ]
    [.buffer-name]
    ({[.grid-count]} shape.1d)
    ({[.block-count]} shape.1d)
    ({[.global-count]} shape.1d)
    ([.buffer-size global-size] u64.lte |-)
  } -> {[
    buffer-name buffer-size grid-count block-count global-count global-size
    schedule-name.
  ]
    [.schedule-name]
    ({
      [.buffer-name buffer-size]
      ({
        ({[.grid-count]} shape.1d)
        ({[.block-count]} shape.1d)
        ({[.global-count]} shape.1d)
      } gpu.grid)
      [.schedule-name]
    } gpu.scheduling val)
  })

  # Assign matrix cell [row, column] to grid thread [column, row]. This policy
  # is race-free by construction; a grid that is too small is safe but does
  # not provide complete functional coverage.
  (arr gpu.scheduling.2d.row-major.own-each : {[
    buffer-name buffer-size matrix-columns
    grid-columns grid-rows block-columns block-rows
    global-columns global-rows schedule-name.
  ]
    [.buffer-name]
    [.buffer-size]
    ({[.matrix-columns] u64} :)
    ({[.grid-columns grid-rows]} shape.2d)
    ({[.block-columns block-rows]} shape.2d)
    ({[.global-columns global-rows]} shape.2d)
  } -> {[
    buffer-name buffer-size matrix-columns
    grid-columns grid-rows block-columns block-rows
    global-columns global-rows schedule-name.
  ]
    [.schedule-name]
    ({
      [.buffer-name buffer-size]
      ({
        ({[.grid-columns grid-rows]} shape.2d)
        ({[.block-columns block-rows]} shape.2d)
        ({[.global-columns global-rows]} shape.2d)
      } gpu.grid)
      [.schedule-name]
    } gpu.scheduling val)
  })

  # The Boolean and its positive/negative proofs stay explicit. The operation
  # receives the actual executing thread; an arbitrary coordinate cannot be
  # used to impersonate another thread.
  (arr gpu.scheduling.can-own : {[
    buffer-name buffer-size grid-topology schedule-name thread-name cell-index
    decision.
  ]
    ({[.buffer-name buffer-size] [.grid-topology] [.schedule-name]}
      gpu.scheduling val)
    ({[.thread-name] ([.grid-topology] gpu.thread)} :)
    ({({[.buffer-size]} shape.1d)} ix val)
  } -> {[
    buffer-name buffer-size grid-topology schedule-name thread-name cell-index
    decision.
  ]
    ({[.decision] bool.t} = [decision-true.])
    ({[.decision] bool.f} = [decision-false.])
    ([.buffer-name schedule-name thread-name cell-index]
      gpu.schedule.owns [owns.])

    ({[.buffer-name buffer-size] [.grid-topology] [.schedule-name]}
      gpu.scheduling val)
    ({[.thread-name] ([.grid-topology] gpu.thread)} :)
    ({[.cell-index] ({({[.buffer-size]} shape.1d)} ix)} :)
    ({[.decision] bool} :)
    ([.decision-true owns] ==> |-)
    ([.owns] {[.decision-false] not} ==> |-)
  })

  # The shared scheduling assigns each named thread its named in-block cell.
  # As with global scheduling, the Boolean result is converted into an actual
  # ownership proof with assert-then at the use site.
  (arr gpu.scheduling.shared.own-each : {[
    shared-name size grid-columns grid-rows block-columns block-rows
    global-columns global-rows phase schedule-name.
  ]
    ({[.size] u64} :)
    [.shared-name]
    ({[.grid-columns grid-rows]} shape.2d)
    ({[.block-columns block-rows]} shape.2d)
    ({[.global-columns global-rows]} shape.2d)
    [.phase]
  } -> {[
    shared-name size grid-columns grid-rows block-columns block-rows
    global-columns global-rows phase schedule-name.
  ]
    [.schedule-name]
    ({
      [.shared-name size]
      ({
        ({[.grid-columns grid-rows]} shape.2d)
        ({[.block-columns block-rows]} shape.2d)
        ({[.global-columns global-rows]} shape.2d)
      } gpu.grid)
      [.phase schedule-name]
    } gpu.shared.scheduling val)
  })

  (arr gpu.schedule.shared.can-own : {[
    shared-name size grid-topology phase schedule-name thread-name
    cell-name decision.
  ]
    ({[.shared-name size grid-topology phase schedule-name]}
      gpu.shared.scheduling val)
    ({[.thread-name] ([.grid-topology] gpu.thread)} :)
    ({[.cell-name] ({({[.size]} shape.1d)} ix)} :)
  } -> {[
    shared-name size grid-topology phase schedule-name thread-name
    cell-name decision.
  ]
    ({[.decision] bool.t} = [decision-true.])
    ({[.decision] bool.f} = [decision-false.])
    ({[.phase thread-name cell-name shared-name]} gpu.shared.owns [owns.])

    ({[.shared-name size grid-topology phase schedule-name]}
      gpu.shared.scheduling val)
    ({[.thread-name] ([.grid-topology] gpu.thread)} :)
    ({[.cell-name] ({({[.size]} shape.1d)} ix)} :)
    ({[.decision] bool} :)
    ([.decision-true owns] ==> |-)
    ([.owns] {[.decision-false] not} ==> |-)
  })

  # Matching names ensure that the proof belongs to the executing thread and
  # to the exact buffer and cell being written. The proof is consumed directly;
  # no separate runtime permission token is needed.
  (arr gpu.global.write : {[
    buffer-name buffer-size element-type
    grid-topology schedule-name thread-name cell-index.
  ]
    ({[.thread-name] ([.grid-topology] gpu.thread)} :)
    ({[.buffer-name] ({cap.own [.buffer-size element-type]} gpu.global)} :)
    ({[.cell-index] ({({[.buffer-size]} shape.1d)} ix)} :)
    ([.element-type] val)
    ([.buffer-name schedule-name thread-name cell-index] gpu.schedule.owns |-)
  } -> ([
    buffer-name buffer-size element-type
    grid-topology schedule-name thread-name cell-index.
  ] []))

  # Borrowed global memory is read-only, so a bounded cell is sufficient to
  # read it. No per-thread scheduling permission is required.
  (arr gpu.global.read : {[buffer-name buffer-size element-type.]
    ({[.buffer-name] ({cap.ref [.buffer-size element-type]} gpu.global)} :)
    ({({[.buffer-size]} shape.1d)} ix val)
  } -> {[buffer-name buffer-size element-type.]
    ({[.buffer-name] ({cap.ref [.buffer-size element-type]} gpu.global)} :)
    ([.element-type] val)
  })

  (arr gpu.global.forget : {[allocation-mode buffer-name buffer-size element-type.]
    ({[.buffer-name]
      ({[.allocation-mode buffer-size element-type]} gpu.global)} :)
  } -> ([allocation-mode buffer-name buffer-size element-type.] []))

  # Preserve the runtime handle while exposing its element type to definitions
  # that specialize a generic kernel name.
  (arr gpu.global.element-type : {[
    allocation-mode buffer-name buffer-size element-type.
  ]
    ({[.buffer-name]
      ({[.allocation-mode buffer-size element-type]} gpu.global)} :)
  } -> {[allocation-mode buffer-name buffer-size element-type.]
    ({[.buffer-name]
      ({[.allocation-mode buffer-size element-type]} gpu.global)} :)
    [.element-type]
  })

  # Launch is generic over the kernel arguments. Their specific structure,
  # including all buffers, lengths, and schedules, is declared by the kernel.
  (arr gpu.launch : {[
    grid-shape block-shape global-shape kernel-arguments kernel-result
    shared-slots barrier-trace.
  ]
    ([.shared-slots] gpu.shared.layout val)
    ({[.grid-shape block-shape global-shape]} gpu.grid val)
    ([.kernel-arguments])
    ({
      ({
        ({
          ([.shared-slots] gpu.shared.layout val)
          ([.kernel-arguments])
        } *)
        ({
          ({({[.grid-shape block-shape global-shape]} gpu.grid)}
            gpu.thread val)
          ({
            ({[.grid-shape block-shape global-shape]} gpu.grid)
            [.barrier-trace]
          } gpu.barrier.cursor |-)
        } *)
      } *)
      ({
        ([.kernel-result])
        ({
          ({[.grid-shape block-shape global-shape]} gpu.grid)
          gpu.barrier.trace.end
        } gpu.barrier.cursor |-)
      } *)
    } -> val)
  } -> {[
    grid-shape block-shape global-shape kernel-arguments kernel-result
    shared-slots barrier-trace.
  ]
    ([.kernel-arguments])
  })
})
