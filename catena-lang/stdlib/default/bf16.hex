 (arr wmma.bf16x16.pack : {(bf16x2 val) (bf16x2 val) (bf16x2 val) (bf16x2 val) (bf16x2 val) (bf16x2 val) (bf16x2 val) (bf16x2 val)} -> (wmma.bf16x16 val))
