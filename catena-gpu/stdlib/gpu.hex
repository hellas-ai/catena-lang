# Minimal launch, scheduling, and permission model.

(theory type nat {
  (arr gpu.grid : 4 -> 1)
  (arr gpu.thread : 1 -> 1)
  (arr gpu.block : 2 -> 1)

  # A global handle is independent of the thread layout.
  (arr gpu.global : 4 -> 1)

  # The scheduling relates buffer cells to global thread indices.
  (arr gpu.scheduling : 4 -> 1)
  (arr gpu.schedule.reads : 4 -> 1)
  (arr gpu.schedule.owns : 4 -> 1)
  (arr gpu.global.read : 4 -> 1)
  (arr gpu.global.own : 4 -> 1)
})

(theory program type {
  # Logical dimensionality is preserved in shapes. CUDA's three-dimensional
  # launch values remain a backend detail.
  (arr gpu.grid.1d.intro : {[gx bx.]
    ({[.gx] u64} :)
    ({[.bx] u64} :)
  } -> {[gx bx.]
    ({[.gx]} shape.1d)
    ({[.bx]} shape.1d)
    ({({[.gx bx]} *)} shape.1d)
    ({
      ({[.gx]} shape.1d)
      ({[.bx]} shape.1d)
      ({({[.gx bx]} *)} shape.1d)
      ({[.gx bx]} *)
    } gpu.grid val)
    ({({[.gx bx]} *) u64} :)
  })

  (arr gpu.grid.2d.intro : {[gx gy bx by.]
    ({[.gx] u64} :)
    ({[.gy] u64} :)
    ({[.bx] u64} :)
    ({[.by] u64} :)
  } -> {[gx gy bx by.]
    ({[.gx gy]} shape.2d)
    ({[.bx by]} shape.2d)
    ({({[.gx bx]} *) ({[.gy by]} *)} shape.2d)
    ({
      ({[.gx gy]} shape.2d)
      ({[.bx by]} shape.2d)
      ({({[.gx bx]} *) ({[.gy by]} *)} shape.2d)
      ({({[.gx bx]} *) ({[.gy by]} *)} *)
    } gpu.grid val)
    ({({({[.gx bx]} *) ({[.gy by]} *)} *) u64} :)
  })

  (arr gpu.grid.3d.intro : {[gx gy gz bx by bz.]
    ({[.gx] u64} :)
    ({[.gy] u64} :)
    ({[.gz] u64} :)
    ({[.bx] u64} :)
    ({[.by] u64} :)
    ({[.bz] u64} :)
  } -> {[gx gy gz bx by bz.]
    ({[.gx gy gz]} shape.3d)
    ({[.bx by bz]} shape.3d)
    ({({[.gx bx]} *) ({[.gy by]} *) ({[.gz bz]} *)} shape.3d)
    ({
      ({[.gx gy gz]} shape.3d)
      ({[.bx by bz]} shape.3d)
      ({({[.gx bx]} *) ({[.gy by]} *) ({[.gz bz]} *)} shape.3d)
      ({({({[.gx bx]} *) ({[.gy by]} *)} *) ({[.gz bz]} *)} *)
    } gpu.grid val)
    ({({({({[.gx bx]} *) ({[.gy by]} *)} *) ({[.gz bz]} *)} *) u64} :)
  })

  # Coordinates of the thread in the complete launch grid.
  (arr gpu.thread.in-grid.index : {[
    grid-shape block-shape global-shape global-size.
  ]
    ({({[.grid-shape block-shape global-shape global-size]} gpu.grid)}
      gpu.thread val)
  } -> {[grid-shape block-shape global-shape global-size.]
    ({({[.grid-shape block-shape global-shape global-size]} gpu.grid)}
      gpu.thread val)
    ([.global-shape] ix val)
  })

  # Coordinates of the same thread relative to its CUDA block.
  (arr gpu.thread.in-block.index : {[
    grid-shape block-shape global-shape global-size.
  ]
    ({({[.grid-shape block-shape global-shape global-size]} gpu.grid)}
      gpu.thread val)
  } -> {[grid-shape block-shape global-shape global-size.]
    ({({[.grid-shape block-shape global-shape global-size]} gpu.grid)}
      gpu.thread val)
    ([.block-shape] ix val)
  })

  # Obtain the opaque block containing a thread. The block's own index is
  # available only through gpu.block.index.
  (arr gpu.thread.block : {[grid-topology block-id.]
    ([.grid-topology] gpu.thread val)
  } -> {[grid-topology block-id.]
    ([.grid-topology] gpu.thread val)
    ({[.block-id] ({[.grid-topology block-id]} gpu.block)} :)
  })

  (arr gpu.block.index : {[
    grid-shape block-shape global-shape global-size block-id.
  ]
    ({[.block-id]
      ({({[.grid-shape block-shape global-shape global-size]} gpu.grid) [.block-id]}
        gpu.block)} :)
  } -> {[grid-shape block-shape global-shape global-size block-id.]
    ({[.block-id]
      ({({[.grid-shape block-shape global-shape global-size]} gpu.grid) [.block-id]}
        gpu.block)} :)
    ([.grid-shape] ix val)
  })

  # The fixed linear policy assigns buffer cell i to global thread i. It is
  # race-free by construction. The proof ensures every buffer cell has a
  # corresponding global thread; excess threads simply receive no cell.
  (arr gpu.scheduling.linear : {[
    buffer-id buffer-size grid-shape block-shape global-shape global-size
    schedule-id.
  ]
    [.buffer-id]
    [.grid-shape]
    [.block-shape]
    [.global-shape]
    ([.buffer-size global-size] u64.lte |-)
  } -> {[
    buffer-id buffer-size grid-shape block-shape global-shape global-size
    schedule-id.
  ]
    [.schedule-id]
    ({
      [.buffer-id buffer-size]
      ({[.grid-shape block-shape global-shape global-size]} gpu.grid)
      [.schedule-id]
    } gpu.scheduling val)
  })

  # The Boolean and its positive/negative proofs stay explicit. The operation
  # receives the actual executing thread; an arbitrary coordinate cannot be
  # used to impersonate another thread.
  (arr gpu.scheduling.can-own : {[
    buffer-id buffer-size grid-topology schedule-id thread-id cell-index
    decision.
  ]
    ({[.buffer-id buffer-size] [.grid-topology] [.schedule-id]}
      gpu.scheduling val)
    ([.grid-topology] gpu.thread val)
    ({({[.buffer-size]} shape.1d)} ix val)
  } -> {[
    buffer-id buffer-size grid-topology schedule-id thread-id cell-index
    decision.
  ]
    ({[.decision] bool.t} = [decision-true.])
    ({[.decision] bool.f} = [decision-false.])
    ([.buffer-id schedule-id thread-id cell-index]
      gpu.schedule.owns [owns.])

    ({[.buffer-id buffer-size] [.grid-topology] [.schedule-id]}
      gpu.scheduling val)
    ({[.thread-id] ([.grid-topology] gpu.thread val)} :)
    ({[.cell-index] ({({[.buffer-size]} shape.1d)} ix)} :)
    ({[.decision] bool} :)
    ([.decision-true owns] ==> |-)
    ([.owns] {[.decision-false] not} ==> |-)
  })

  (arr gpu.scheduling.can-read : {[
    buffer-id buffer-size grid-topology schedule-id thread-id cell-index
    decision.
  ]
    ({[.buffer-id buffer-size] [.grid-topology] [.schedule-id]}
      gpu.scheduling val)
    ([.grid-topology] gpu.thread val)
    ({({[.buffer-size]} shape.1d)} ix val)
  } -> {[
    buffer-id buffer-size grid-topology schedule-id thread-id cell-index
    decision.
  ]
    ({[.decision] bool.t} = [decision-true.])
    ({[.decision] bool.f} = [decision-false.])
    ([.buffer-id schedule-id thread-id cell-index]
      gpu.schedule.reads [reads.])

    ({[.buffer-id buffer-size] [.grid-topology] [.schedule-id]}
      gpu.scheduling val)
    ({[.thread-id] ([.grid-topology] gpu.thread val)} :)
    ({[.cell-index] ({({[.buffer-size]} shape.1d)} ix)} :)
    ({[.decision] bool} :)
    ([.decision-true reads] ==> |-)
    ([.reads] {[.decision-false] not} ==> |-)
  })

  (arr gpu.permissions.grant-read : {[
    buffer-id schedule-id thread-id cell-index.
  ]
    ([.buffer-id schedule-id thread-id cell-index] gpu.schedule.reads |-)
  } -> {[buffer-id schedule-id thread-id cell-index.]
    ([.buffer-id schedule-id thread-id cell-index] gpu.global.read)
  })

  (arr gpu.permissions.grant-own : {[
    buffer-id schedule-id thread-id cell-index.
  ]
    ([.buffer-id schedule-id thread-id cell-index] gpu.schedule.owns |-)
  } -> {[buffer-id schedule-id thread-id cell-index.]
    ([.buffer-id schedule-id thread-id cell-index] gpu.global.own)
  })

  # Matching names ensure that the grant belongs to the executing thread and
  # to the exact buffer being written.
  (arr gpu.global.write : {[
    buffer-id buffer-size grid-topology schedule-id thread-id cell-index.
  ]
    ({[.thread-id] ([.grid-topology] gpu.thread val)} :)
    ({cap.own [.buffer-id buffer-size] u64} gpu.global val)
    ({[.cell-index] ({({[.buffer-size]} shape.1d)} ix)} :)
    (u64 val)
    ([.buffer-id schedule-id thread-id cell-index] gpu.global.own)
  } -> {[
    buffer-id buffer-size grid-topology schedule-id thread-id cell-index.
  ]
    ([.buffer-id schedule-id thread-id cell-index] gpu.global.own)
  })

  (arr gpu.global.own.forget : {[
    buffer-id schedule-id thread-id cell-index.
  ]
    ([.buffer-id schedule-id thread-id cell-index] gpu.global.own)
  } -> ([buffer-id schedule-id thread-id cell-index.] []))

  # Launch connects one concrete grid topology to scheduling over its derived
  # global-thread shape.
  (arr gpu.launch : {[
    buffer-id buffer-size grid-shape block-shape global-shape global-size schedule-id
    kernel-argument.
  ]
    ({[.buffer-size] u64} :)
    ({[.grid-shape block-shape global-shape global-size]} gpu.grid val)
    ({cap.own [.buffer-id buffer-size] u64} gpu.global val)
    ([.kernel-argument])
    [.buffer-id]
    [.grid-shape]
    [.block-shape]
    [.global-shape]
    [.global-size]
    [.schedule-id]
    ({
      [.buffer-id buffer-size]
      ({[.grid-shape block-shape global-shape global-size]} gpu.grid)
      [.schedule-id]
    } gpu.scheduling val)
    ({
      ({
        ({[.buffer-size] u64} :)
        ({
          [.buffer-id]
          ({
            [.grid-shape]
            ({
              [.block-shape]
              ({
                [.global-shape]
                ({
                  [.global-size]
                  ({
                    [.schedule-id]
                    ({
                      ({cap.own [.buffer-id buffer-size] u64} gpu.global val)
                      ({
                        ([.kernel-argument])
                        ({
                          ({({[.grid-shape block-shape global-shape global-size]}
                            gpu.grid)} gpu.thread val)
                          ({
                            [.buffer-id buffer-size]
                            ({[.grid-shape block-shape global-shape global-size]}
                              gpu.grid)
                            [.schedule-id]
                          } gpu.scheduling val)
                        } *)
                      } *)
                    } *)
                  } *)
                } *)
              } *)
            } *)
          } *)
        } *)
      } *)
      ({
        [.buffer-id buffer-size]
        ({[.grid-shape block-shape global-shape global-size]} gpu.grid)
        [.schedule-id]
      } gpu.scheduling val)
    } -> val)
  } -> {[
    buffer-id buffer-size grid-shape block-shape global-shape global-size schedule-id
    kernel-argument.
  ]
    ({cap.own [.buffer-id buffer-size] u64} gpu.global val)
  })
})
