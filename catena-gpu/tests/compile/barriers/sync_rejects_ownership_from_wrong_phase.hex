# The resources match, but ownership belongs to the read phase while the
# write-to-read barrier requires ownership from the write phase.
(def program sync-that-uses-ownership-from-the-wrong-phase : {[
  grid-topology block-name thread cell shared.
]
  ({[.block-name] ({[.grid-topology block-name]} gpu.block)} :)
  ({
    [.grid-topology]
    ({
      ({
        gpu.tiled.wr
        ({gpu.tiled.write [.thread cell shared]} gpu.shared.owns |-)
        ({gpu.tiled.read [.thread shared]} gpu.shared.reads |-)
      } gpu.barrier.step)
      gpu.barrier.trace.end
    } gpu.barrier.trace.sync)
  } gpu.barrier.cursor |-)
  ({gpu.tiled.read [.thread cell shared]} gpu.shared.owns |-)
} -> {[
  grid-topology block-name thread cell shared.
]
  ({[.block-name] ({[.grid-topology block-name]} gpu.block)} :)
  ({[.grid-topology] gpu.barrier.trace.end} gpu.barrier.cursor |-)
  ({gpu.tiled.read [.thread shared]} gpu.shared.reads |-)
} = gpu.sync)
