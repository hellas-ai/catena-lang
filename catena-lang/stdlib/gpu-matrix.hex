# GPU tiled matrix multiplication over logical matrix views.
#
# gpu.f32.tiled-matmul.kernel :
#   A-view × B-view × dimensions × state × (row × col) -> C[row,col]
(theory program type {
  # Map a block-local thread index to the corresponding logical A tile index:
  #
  #   (thread-row, thread-col) ->
  #   (block-row * tile-size + thread-row,
  #    inner-tile-index * tile-size + thread-col)
  (def gpu.tiled-matmul.row-inner-tile-reindex : {[rows inner tile-size.]
    ({[.inner] u64} :)
    ({[.tile-size] u64} :)
    ([.rows] ix val)
    (u64 val)
    ({([.tile-size] ix val) ([.tile-size] ix val)} *)
  } -> ([rows inner tile-size.]
    ({([.rows] ix val) ([.inner] ix val)} *))
  = ([inner tile-size output-row inner-tile-index thread-index.]
    ([.tile-size] u64.copies2 [
      row-tile-size inner-tile-size.
    ])
    ([.thread-index] *.elim [thread-row thread-col.])
    ({
      [.row-tile-size]
      [.output-row]
      [.thread-row]
    } ix.same-tile-coordinate [tile-row.])
    ({
      [.inner]
      [.inner-tile-size]
      [.inner-tile-index]
      [.thread-col]
    } ix.tile-offset-coordinate [tile-inner-col.])
    ({[.tile-row] [.tile-inner-col]} *.intro)
  ))

  # Map a block-local thread index to the corresponding logical B tile index:
  #
  #   (thread-row, thread-col) ->
  #   (inner-tile-index * tile-size + thread-row,
  #    block-col * tile-size + thread-col)
  (def gpu.tiled-matmul.inner-col-tile-reindex : {[cols inner tile-size.]
    ({[.inner] u64} :)
    ({[.tile-size] u64} :)
    ([.cols] ix val)
    (u64 val)
    ({([.tile-size] ix val) ([.tile-size] ix val)} *)
  } -> ([cols inner tile-size.]
    ({([.inner] ix val) ([.cols] ix val)} *))
  = ([inner tile-size output-col inner-tile-index thread-index.]
    ([.tile-size] u64.copies2 [
      inner-tile-size col-tile-size.
    ])
    ([.thread-index] *.elim [thread-row thread-col.])
    ({
      [.inner]
      [.inner-tile-size]
      [.inner-tile-index]
      [.thread-row]
    } ix.tile-offset-coordinate [tile-inner-row.])
    ({
      [.col-tile-size]
      [.output-col]
      [.thread-col]
    } ix.same-tile-coordinate [tile-col.])
    ({[.tile-inner-row] [.tile-col]} *.intro)
  ))

  # Read one element from linear shared storage.
  (def gpu.f32.shared.row-major.flat-at : {[rows cols.]
    ({
      ({[.rows] [.cols]} *)
      f32
    } gpu.shared val)
    (({[.rows] [.cols]} *) ix val)
  } -> ([rows cols.] (f32 val))
  = ([shared i.]
    {[.i] [.shared]} gpu.shared.ix
  ))

  # Present linear shared storage as a row-major matrix.
  (def gpu.f32.shared.row-major.view : {[rows cols.]
    ({[.rows] u64} :)
    ({[.cols] u64} :)
    ({
      ({[.rows] [.cols]} *)
      f32
    } gpu.shared val)
  } -> ([rows cols.]
    ({({([.rows] ix val) ([.cols] ix val)} *) (f32 val)} =>))
  = ([rows cols shared.]
    ([.rows] u64.copy-param [view-rows rows-param.])
    ([.cols] u64.copy-param [view-cols cols-param.])

    ({
      [.rows-param]
      [.cols-param]
      [.shared]
    } partial.gpu.f32.shared.row-major.flat-at.1 [flat-view.])

    ({
      [.view-rows]
      [.view-cols]
      [.flat-view]
    } f32.row-major.matrix-view)
  ))

  # Compute one inner-tile contribution to a logical C cell.
  #
  #   row-inner-tile(thread-row, thread-col) =
  #     row-inner-view(
  #       (output-row / tile-size) * tile-size + thread-row,
  #       inner-tile-index * tile-size + thread-col)
  #
  #   inner-col-tile(thread-row, thread-col) =
  #     inner-col-view(
  #       inner-tile-index * tile-size + thread-row,
  #       (output-col / tile-size) * tile-size + thread-col)
  #
  #   row-inner-shared =
  #     materialize(sync(cooperative-load(row-inner-slot, row-inner-tile)))
  #   inner-col-shared =
  #     materialize(sync(cooperative-load(inner-col-slot, inner-col-tile)))
  #
  #   tile-value = 0
  #   for local-inner in 0 .. tile-size:
  #     tile-value +=
  #       row-inner-shared[thread-row, local-inner] *
  #       inner-col-shared[local-inner, thread-col]
  #
  #   synchronize-block()
  (def gpu.f32.tiled-matmul.tile-dot : {[
    rows cols inner tile-size inner-tile-count
    row-inner-slot inner-col-slot.
  ]
    ({({([.rows] ix val) ([.inner] ix val)} *) (f32 val)} =>)
    ({({([.inner] ix val) ([.cols] ix val)} *) (f32 val)} =>)

    ({[.rows] u64} :)
    ({[.inner] u64} :)
    ({[.cols] u64} :)
    ({[.tile-size] u64} :)
    ({
      ({
        [.inner-col-slot]
        ({
          [.row-inner-slot]
          gpu.initial
        } gpu.shared.allocated)
      } gpu.shared.allocated)
      gpu.initial
    } gpu.state)
    ({
      [.row-inner-slot]
      ({[.tile-size] [.tile-size]} *)
      f32
    } gpu.shared.slot val)
    ({
      [.inner-col-slot]
      ({[.tile-size] [.tile-size]} *)
      f32
    } gpu.shared.slot val)
    ({([.rows] ix val) ([.cols] ix val)} *)
    ([.inner-tile-count] ix val)
  } -> ([
    rows cols inner tile-size inner-tile-count
    row-inner-slot inner-col-slot.
  ] (f32 val))
  = ([
    row-inner-view inner-col-view
    rows inner cols tile-size
    allocated-state row-inner-slot inner-col-slot
    logical-index inner-tile-index.
  ]
    ([.rows] :.param [a-rows-param.])
    ([.inner] u64.copies2 [a-inner-source b-inner-source.])
    ([.a-inner-source] u64.copy-param [a-inner a-inner-param.])
    ([.b-inner-source] u64.copy-param [b-inner b-inner-param.])
    ([.cols] :.param [b-cols-param.])
    ([.tile-size] u64.copies6 [
      a-tile-rows a-tile-cols
      b-tile-rows b-tile-cols
      reindex-tile-size compute-tile-size.
    ])
    ([.reindex-tile-size] u64.copies2 [
      a-reindex-tile b-reindex-tile.
    ])
    ([.a-reindex-tile] u64.copy-param [
      a-reindex-tile-size a-tile-size-param.
    ])
    ([.b-reindex-tile] u64.copy-param [
      b-reindex-tile-size b-tile-size-param.
    ])
    ([.compute-tile-size] u64.copies6 [
      a-shared-rows a-shared-cols
      b-shared-rows b-shared-cols
      local-coordinate-tile-size dot-tile-size.
    ])
    ([.local-coordinate-tile-size] u64.copies2 [
      local-row-tile-size local-col-tile-size.
    ])
    ([.dot-tile-size] u64.copy-params3 [
      dot-inner dot-row-param dot-col-param dot-inner-param.
    ])

    ([.logical-index] *.elim [logical-row logical-col.])
    ([.logical-row] ix.copy [reindex-logical-row local-logical-row.])
    ([.logical-col] ix.copy [reindex-logical-col local-logical-col.])
    ([.inner-tile-index] ix.copy [
      idempotency-key tile-q.
    ])
    ([.tile-q] ix.copy [
      row-inner-tile-index inner-col-tile-index.
    ])
    ([.row-inner-tile-index] ix.to-u64 [row-inner-tile-index-value.])
    ([.inner-col-tile-index] ix.to-u64 [inner-col-tile-index-value.])

    ({
      ({
        [.a-rows-param]
        [.a-inner-param]
        [.a-tile-size-param]
        [.a-inner]
        [.a-reindex-tile-size]
        [.reindex-logical-row]
        [.row-inner-tile-index-value]
      } partial.gpu.tiled-matmul.row-inner-tile-reindex.4)
      [.row-inner-view]
    } compose [row-inner-tile-source.])

    ({
      ({
        [.b-cols-param]
        [.b-inner-param]
        [.b-tile-size-param]
        [.b-inner]
        [.b-reindex-tile-size]
        [.reindex-logical-col]
        [.inner-col-tile-index-value]
      } partial.gpu.tiled-matmul.inner-col-tile-reindex.4)
      [.inner-col-view]
    } compose [inner-col-tile-source.])

    ({
      [.allocated-state]
      [.idempotency-key]
    } gpu.state.admit-keyed [state.])
    ({[.state] [.row-inner-slot]} gpu.shared.admit-allocated-at [
      state-for-row-load row-inner-allocated row-inner-load-slot.
    ])
    ({
      [.state-for-row-load]
      [.row-inner-allocated]
      [.row-inner-load-slot]
      [.a-tile-rows]
      [.a-tile-cols]
      [.row-inner-tile-source]
    } gpu.shared.cooperative-load.row-major [
      row-loaded-state row-loaded-slot.
    ])

    ({
      [.row-loaded-state]
      [.inner-col-slot]
    } gpu.shared.admit-allocated-at [
      state-for-col-load inner-col-allocated inner-col-load-slot.
    ])
    ({
      [.state-for-col-load]
      [.inner-col-allocated]
      [.inner-col-load-slot]
      [.b-tile-rows]
      [.b-tile-cols]
      [.inner-col-tile-source]
    } gpu.shared.cooperative-load.row-major [
      loaded-state col-loaded-slot.
    ])

    ([.loaded-state] gpu.sync [synchronized-state.])

    ({
      [.synchronized-state]
      [.row-loaded-slot]
    } gpu.shared.admit-ready-at [
      state-for-row-materialize row-inner-ready row-inner-ready-slot.
    ])
    ({
      [.state-for-row-materialize]
      [.row-inner-ready]
      [.row-inner-ready-slot]
    } gpu.shared.materialize [
      row-materialized-state row-inner-shared.
    ])

    ({
      [.row-materialized-state]
      [.col-loaded-slot]
    } gpu.shared.admit-ready-at [
      state-for-col-materialize inner-col-ready inner-col-ready-slot.
    ])
    ({
      [.state-for-col-materialize]
      [.inner-col-ready]
      [.inner-col-ready-slot]
    } gpu.shared.materialize [
      materialized-state inner-col-shared.
    ])

    ({
      [.a-shared-rows]
      [.a-shared-cols]
      [.row-inner-shared]
    } gpu.f32.shared.row-major.view [row-inner-shared-view.])
    ({
      [.b-shared-rows]
      [.b-shared-cols]
      [.inner-col-shared]
    } gpu.f32.shared.row-major.view [inner-col-shared-view.])

    ({
      [.local-row-tile-size]
      [.local-logical-row]
    } ix.local-tile-coordinate [local-row.])
    ({
      [.local-col-tile-size]
      [.local-logical-col]
    } ix.local-tile-coordinate [local-col.])
    ({[.local-row] [.local-col]} *.intro [local-index.])

    ({
      [.dot-row-param]
      [.dot-col-param]
      [.dot-inner]
      [.row-inner-shared-view]
      [.inner-col-shared-view]
      [.local-index]
    } f32.matmul.cell-dot [tile-value.])

    ([.materialized-state] gpu.sync [completed-state.])
    ({
      [.completed-state]
      [.tile-value]
    } gpu.state.discard-with-f32)
  ))

  # Compute one logical output cell by accumulating every inner tile:
  #
  #   accumulator = 0
  #   for inner-tile-index in 0 .. inner-tile-count:
  #     accumulator += tile-dot(
  #       row-inner-view,
  #       inner-col-view,
  #       logical-index,
  #       inner-tile-index)
  #   return accumulator
  (def gpu.f32.tiled-matmul.kernel : {[
    rows cols inner tile-size inner-tile-count.
  ]
    ({({([.rows] ix val) ([.inner] ix val)} *) (f32 val)} =>)
    ({({([.inner] ix val) ([.cols] ix val)} *) (f32 val)} =>)

    ({[.rows] u64} :)
    ({[.inner] u64} :)
    ({[.cols] u64} :)
    ({[.tile-size] u64} :)
    ({[.inner-tile-count] u64} :)
    ({gpu.initial gpu.initial} gpu.state)
    ({([.rows] ix val) ([.cols] ix val)} *)
  } -> ([
    rows cols inner tile-size inner-tile-count.
  ] (f32 val))
  = ([
    row-inner-view inner-col-view
    rows inner cols tile-size inner-tile-count
    state logical-index.
  ]
    ([.rows] u64.copy-param [producer-rows rows-param.])
    ([.inner] u64.copy-param [producer-inner inner-param.])
    ([.cols] u64.copy-param [producer-cols cols-param.])
    ([.tile-size] u64.copy-param [tile-size-values tile-size-param.])
    ([.tile-size-values] u64.copies2 [
      producer-tile-size shared-tile-size.
    ])
    ([.shared-tile-size] u64.copies2 [
      shared-tile-rows shared-tile-cols.
    ])
    ({[.shared-tile-rows] [.shared-tile-cols]}
      u64.product [shared-tile-length.])
    ([.shared-tile-length] u64.copies2 [
      row-inner-slot-length inner-col-slot-length.
    ])
    ([.inner-tile-count] u64.copy-param [
      reduce-inner-tile-count inner-tile-count-param.
    ])

    ({
      [.state]
      [.row-inner-slot-length]
    } gpu.shared.alloc [
      row-inner-slot-id row-inner-allocated-state row-inner-slot.
    ])
    ({
      [.row-inner-allocated-state]
      [.inner-col-slot-length]
    } gpu.shared.alloc [
      inner-col-slot-id producer-state inner-col-slot.
    ])

    ({
      (const.u32.0x00000000 u32.bitcast-f32)
      (name.f32.add lift)
      ({
        [.rows-param]
        [.cols-param]
        [.inner-param]
        [.tile-size-param]
        [.inner-tile-count-param]
        [.row-inner-slot-id]
        [.inner-col-slot-id]
        [.row-inner-view]
        [.inner-col-view]
        [.producer-rows]
        [.producer-inner]
        [.producer-cols]
        [.producer-tile-size]
        [.producer-state]
        [.row-inner-slot]
        [.inner-col-slot]
        [.logical-index]
      } partial.gpu.f32.tiled-matmul.tile-dot.10)
      [.reduce-inner-tile-count]
    } reduce [value.])
    [.value]
  ))

})

# Exact dimension division.
(def program u64.perfect-div :
  ([n divisor.] {
    ({[.n] u64} :)
    ({[.divisor] u64} :)
  })
  ->
  ([n divisor.] ({({[.n] [.divisor]} nat.div) u64} :))
= ([n divisor.]
  ([.divisor] u64.copies2 [divisor-for-positive divisor-for-div.])
  ([.divisor-for-positive] u64.assert-nz [divisor-positive.])
  ({[.n] [.divisor-for-div] [.divisor-positive]} u64.div [
    quotient exact.
  ])
  ([.exact] assert [_perfect-tiling.])
  [.quotient]
))

# Launch geometry for square, perfectly tiled matrix multiplication.
(def program gpu.tiled-matmul.perfect-launch-params :
  ([rows cols inner tile-size.] {
    ({[.rows] u64} :)
    ({[.cols] u64} :)
    ({[.inner] u64} :)
    ({[.tile-size] u64} :)
  })
  ->
  ([rows cols inner tile-size.]
    {
      ({
        ({
          ({[.cols] [.tile-size]} nat.div)
          ({[.rows] [.tile-size]} nat.div)
        } 2d)
        ({[.tile-size] [.tile-size]} 2d)
      } gpu.grid [grid.])
      ([.grid] gpu.launch_params val)
      ({({[.inner] [.tile-size]} nat.div) u64} :)
    }
  )
= ([rows cols inner tile-size.]
  ([.tile-size] u64.copies5 [
    tile-for-rows
    tile-for-cols
    tile-for-inner
    block-cols
    block-rows.
  ])
  ({[.rows] [.tile-for-rows]} u64.perfect-div [grid-rows.])
  ({[.cols] [.tile-for-cols]} u64.perfect-div [grid-cols.])
  ({[.inner] [.tile-for-inner]} u64.perfect-div [inner-tile-count.])

  ({[.grid-cols] [.grid-rows]}
    gpu.dimensions.2d.intro [grid.])
  ({[.block-cols] [.block-rows]} gpu.dimensions.2d.intro [block.])
  ({[.grid] [.block]} gpu.launch_params.intro [params.])
  {[.params] [.inner-tile-count]}
))

# Row-major tiled-matmul materialization.
# gpu.f32.tiled-matmul.row-major.materialize :
#   launch-params × A-view × B-view × dimensions
#   ->
#   C-buffer
(def program gpu.f32.tiled-matmul.row-major.materialize :
  ([
    rows cols inner tile-size inner-tile-count grid-rows grid-cols.
  ] {
    ({
      ({[.grid-cols] [.grid-rows]} 2d)
      ({[.tile-size] [.tile-size]} 2d)
    } gpu.grid [grid.])
    ([.grid] gpu.launch_params val)

    ({({([.rows] ix val) ([.inner] ix val)} *) (f32 val)} =>)
    ({({([.inner] ix val) ([.cols] ix val)} *) (f32 val)} =>)

    ({[.rows] u64} :)
    ({[.inner] u64} :)
    ({[.cols] u64} :)
    ({[.tile-size] u64} :)
    ({[.inner-tile-count] u64} :)
  })
  ->
  ([
    rows cols inner tile-size inner-tile-count grid-rows grid-cols.
  ]
    ({cap.own ({[.rows] [.cols]} *) f32} buf val))
= ([
  params
  a-view b-view
  rows inner cols tile-size inner-tile-count
.]
  ([.rows] u64.copies2-param [
    dimensions-rows c-size-rows rows-param.
  ])
  ([.inner] u64.copy-param [dimensions-inner inner-param.])
  ([.cols] u64.copies3 [
    dimensions-cols c-size-cols indices-cols.
  ])
  ([.indices-cols] u64.copy-param [indices-cols-len cols-param.])
  ([.inner-tile-count] u64.copy-param [
    kernel-inner-tile-count inner-tile-count-param.
  ])
  ({[.c-size-rows] [.c-size-cols]} u64.product [c-size.])

  ([.params] gpu.launch_params.2d-2d.params [
    materialize-params
    _grid-cols-param _grid-rows-param
    tile-size-param _tile-size-param.
  ])

  ({
    ({
      (partial.gpu.state.initial.forward.0)
      ({
        [.rows-param]
        [.cols-param]
        [.indices-cols-len]
      } partial.f32.row-major.indices.1)
    } tensor)
    ({
      [.rows-param]
      [.cols-param]
      [.inner-param]
      [.tile-size-param]
      [.inner-tile-count-param]
      [.a-view]
      [.b-view]
      [.dimensions-rows]
      [.dimensions-inner]
      [.dimensions-cols]
      [.tile-size]
      [.kernel-inner-tile-count]
    } partial.gpu.f32.tiled-matmul.kernel.7)
  } compose [kernel.])

  ({
    [.materialize-params]
    [.c-size]
    [.kernel]
  } gpu.materialize)
))
