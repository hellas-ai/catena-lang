# Execution contexts and workers
(theory type nat {
  # Shapes describe worker coordinates. `dims s n` pairs an arbitrary shape
  # `s` with its linear cardinality `n`.
  (arr shape.2d : 2 -> 1)
  (arr dims : 2 -> 1)

  # `topo.level l d p` adds custom level `l`, with dimensions `d`, before `p`.
  (arr topo.end : 0 -> 1)
  (arr topo.level : 3 -> 1)

  # `context p s` identifies complete topology `p` and selected node `s`.
  (arr context : 2 -> 1)

  # `worker p s` identifies the current worker at that topology node.
  (arr worker : 2 -> 1)

  # `parallel.plan p` carries the runtime configuration for topology `p`.
  (arr parallel.plan : 1 -> 1)
})

(theory program type {
  # Reify two named extents as a runtime 2D shape. Its cardinality is fixed
  # by the same type-level extents and cannot be supplied independently.
  (arr shape.2d : {[x y.]
    ({[.x] u64} :)
    ({[.y] u64} :)
  }
  ->
  ([x y.] ({[.x y]} shape.2d val)))

  # Build a runtime plan from the same generic level structure used at the
  # type level. The level value is erased; the 2D shape carries its extents.
  (arr topo.end : [] -> (topo.end parallel.plan))

  (arr topo.level : {[l x y rest.]
    ([.l])
    ({[.x y]} shape.2d val)
    ([.rest] parallel.plan)
  }
  ->
  ([l x y rest.]
    (({[.l] ({({[.x y]} shape.2d) ({[.x y]} *)} dims) [.rest]} topo.level)
      parallel.plan)))

  # Preserve a plan while exposing the root context and worker objects used
  # as erased type arguments to polymorphic structural constructors.
  (arr parallel.plan.root-types :
    ([p.] ([.p] parallel.plan))
    ->
    ([p.] {
      ([.p] parallel.plan)
      ({[.p p]} context)
      ({[.p p]} worker)
    }))

  # Schedule a plan and select the root of its complete topology.
  (arr parallel.schedule :
    ([p.] ([.p] parallel.plan))
    ->
    ([p.] ({[.p p]} context)))

  # Allocate an owned f32 buffer in an execution context.
  (arr parallel.allocate : {[p s n.]
    ({[.p s]} context)
    ({[.n] u64} :)
  }
  ->
  ([p s n.] {
    ({[.p s]} context)
    ({({[.p s]} context) ({cap.own [.n] f32} buf)} writable val)
  }))

  # Wait until writes into a buffer are visible to the context's workers.
  # The bare buffer no longer records which context made it available.
  (arr parallel.await : {[p s m n.]
    ({[.p s]} context)
    ({({[.p s]} context) ({[.m n] f32} buf)} pending val)
  }
  ->
  ([p s m n.] {
    ({[.p s]} context)
    ({[.m n] f32} buf val)
  }))

  # Wait until the context's workers have finished reading a buffer and make
  # it writable again. TODO: because await returns a bare buffer, this type
  # cannot prove that the buffer came from this same context.
  (arr parallel.release : {[p s m n.]
    ({[.p s]} context)
    ({[.m n] f32} buf val)
  }
  ->
  ([p s m n.] {
    ({[.p s]} context)
    ({({[.p s]} context) ({[.m n] f32} buf)} writable val)
  }))

  # Synchronize the workers without changing any buffer state.
  (arr parallel.barrier :
    ({[p s.] [.p s]} context)
    ->
    ({[p s.] [.p s]} context))

  # Select the immediate child topology containing the current worker.
  (arr parallel.scope : {[
    p
    parent parent-shape parent-size
    child child-shape child-size
    rest.
  ]
    ({
      [.p]
      ({
        [.parent]
        ({[.parent-shape parent-size]} dims)
        ({
          [.child]
          ({[.child-shape child-size]} dims)
          [.rest]
        } topo.level)
      } topo.level)
    } context)
    ({
      [.p]
      ({
        [.parent]
        ({[.parent-shape parent-size]} dims)
        ({
          [.child]
          ({[.child-shape child-size]} dims)
          [.rest]
        } topo.level)
      } topo.level)
    } worker)
  }
  ->
  ([
    p
    parent parent-shape parent-size
    child child-shape child-size
    rest.
  ] {
    ({
      [.p]
      ({
        [.child]
        ({[.child-shape child-size]} dims)
        [.rest]
      } topo.level)
    } context)
    ({
      [.p]
      ({
        [.child]
        ({[.child-shape child-size]} dims)
        [.rest]
      } topo.level)
    } worker)
  }))

  # parallel.materialize :
  #   context p (topo.level l (dims worker-shape worker-count) q)
  #   * val(writable (context p ...)
  #                  (buf cap.own output-count f32))
  #   * (context ... * worker ... * val(ix output-count) => val(f32))
  #  -> val(pending (context p ...)
  #                 (buf cap.own output-count f32))
  #
  # `worker-count` is physical; `output-count` is the logical materialized
  # index space. A scheduling policy assigns the latter to the former.
  (arr parallel.materialize : {[
    p l worker-shape worker-count q output-count.
  ]
    ({[.p] ({[.l] ({[.worker-shape worker-count]} dims) [.q]} topo.level)} context)
    ({
      ({[.p] ({[.l] ({[.worker-shape worker-count]} dims) [.q]} topo.level)} context)
      ({cap.own [.output-count] f32} buf)
    } writable val)
    ({
      ({
        ({[.p] ({[.l] ({[.worker-shape worker-count]} dims) [.q]} topo.level)} context)
        ({
          ({[.p] ({[.l] ({[.worker-shape worker-count]} dims) [.q]} topo.level)} worker)
          ([.output-count] ix val)
        } *)
      } *)
      (f32 val)
    } =>)
  }
  ->
  ([p l worker-shape worker-count q output-count.] {
    ({[.p] ({[.l] ({[.worker-shape worker-count]} dims) [.q]} topo.level)} context)
    ({
      ({[.p] ({[.l] ({[.worker-shape worker-count]} dims) [.q]} topo.level)} context)
      ({cap.own [.output-count] f32} buf)
    } pending val)
  }))
})
