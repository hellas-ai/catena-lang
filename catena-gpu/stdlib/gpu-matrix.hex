# Generic row-major matrix access over a global buffer. Matrix indexing and
# permission handling do not depend on the buffer's element type.
(def program gpu.global.matrix.read : {[
  buffer-name buffer-size element-type row-count column-count
  grid-topology schedule-name thread-name.
]
  ({[.buffer-name buffer-size] [.grid-topology] [.schedule-name]}
    gpu.scheduling val)
  ({[.thread-name] ([.grid-topology] gpu.thread)} :)
  ({[.buffer-name] ({cap.own [.buffer-size element-type]} gpu.global)} :)
  ({[.buffer-size] u64} :)
  ({[.column-count] u64} :)
  ({({[.row-count column-count]} shape.2d)} ix val)
} -> {[
  buffer-name buffer-size element-type row-count column-count
  grid-topology schedule-name thread-name.
]
  ({[.buffer-name buffer-size] [.grid-topology] [.schedule-name]}
    gpu.scheduling val)
  ({[.thread-name] ([.grid-topology] gpu.thread)} :)
  ({[.buffer-name] ({cap.own [.buffer-size element-type]} gpu.global)} :)
  ({[.buffer-size] u64} :)
  ({[.column-count] u64} :)
  ([.element-type] val)
} = ([scheduling thread buffer buffer-length column-count-value matrix-index.]
  ([.column-count-value]
    u64.copies2
    [column-count-for-flatten column-count-after-read.])
  ({[.column-count-for-flatten matrix-index]}
    matrix.row-major.flatten
    [flat-index-value.])
  ([.flat-index-value] u64.name [named-flat-index.])
  ([.named-flat-index]
    u64.copies2
    [flat-index-for-check flat-index-for-cell.])
  ([.buffer-length]
    u64.copies2
    [buffer-length-after-read buffer-length-for-check-and-cell.])
  ([.buffer-length-for-check-and-cell]
    u64.copies2
    [buffer-length-for-check buffer-length-for-cell.])
  ({[.flat-index-for-check buffer-length-for-check]}
    u64.lt
    [in-bounds bounds-true _bounds-false.])
  ({[.in-bounds bounds-true]} assert-then [is-in-bounds.])
  ({[.flat-index-for-cell buffer-length-for-cell is-in-bounds]}
    u64.to-ix
    [named-cell.])
  ([.named-cell] :.forget [cell.])
  ({[.scheduling thread cell]}
    gpu.scheduling.can-read
    [scheduling-after-query thread-after-query cell-after-query
      can-read reads-if-allowed _not-readable-if-denied.])
  ({[.can-read reads-if-allowed]} assert-then [reads-cell.])
  ([.reads-cell] gpu.permissions.grant-read [read-grant.])
  ({[.buffer cell-after-query read-grant]}
    gpu.global.read
    [buffer-after-read read-grant-after-read value.])
  ([.read-grant-after-read] gpu.global.read.forget)
  {[.scheduling-after-query thread-after-query buffer-after-read
    buffer-length-after-read column-count-after-read value]}
))

