# Perfectly tiled f32 matrix multiplication.
#
# The physical grid shape is independent of the logical n x m output shape.
# Each block has shape tile-size x tile-size and therefore
# tile-size*tile-size workers.

(theory program type {
  # Expose the erased topology parameters needed by a partially applied fold
  # step. The context itself continues independently into allocation.
  (arr gpu.f32.tiled-matmul.block-params :
    ({[p s z.] [.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} context)
    ->
    ([p s z.] { [.p] [.s] [.z] }))

  # Build the producer for one cooperative load of the current A tile.
  (arr gpu.f32.tiled-matmul.load-a :
    {[p s z n k m tile-size.]
      ({({([.n] ix val) ([.k] ix val)} *) (f32 val)} =>)
      ({([.n] ix val) ([.m] ix val)} *)
      (u64 val)
      ({[.tile-size] u64} :)
      ({[.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} context)
      ({[.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} worker)
    }
    ->
    ([p s z n k m tile-size.]
      ({
        ({
          ({[.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} context)
          ({
            ({[.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} worker)
            ([.z] ix val)
          } *)
        } *)
        (f32 val)
      } =>)))

  # Build the producer for one cooperative load of the current B tile.
  (arr gpu.f32.tiled-matmul.load-b :
    {[p s z n k m tile-size.]
      ({({([.k] ix val) ([.m] ix val)} *) (f32 val)} =>)
      ({([.n] ix val) ([.m] ix val)} *)
      (u64 val)
      ({[.tile-size] u64} :)
      ({[.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} context)
      ({[.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} worker)
    }
    ->
    ([p s z n k m tile-size.]
      ({
        ({
          ({[.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} context)
          ({
            ({[.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} worker)
            ([.z] ix val)
          } *)
        } *)
        (f32 val)
      } =>)))

  # Build the producer for the terms of the logical C cell's dot product.
  (arr gpu.f32.tiled-matmul.tile-product :
    {[p s z n m tile-size.]
      ({cap.own [.z] f32} buf val)
      ({cap.own [.z] f32} buf val)
      ({([.n] ix val) ([.m] ix val)} *)
      ({[.tile-size] u64} :)
      ({[.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} worker)
    }
    ->
    ([p s z n m tile-size.]
      ({([.tile-size] ix val) (f32 val)} =>)))
})

# One k-tile fold iteration. Shared tiles transition from writable to pending,
# then to readable bare buffers, and finally back to writable for reuse.
(def program gpu.f32.tiled-matmul.tile-step :
  ([p s z n k m k-tiles tile-size.] {
    ({({([.n] ix val) ([.k] ix val)} *) (f32 val)} =>)
    ({({([.k] ix val) ([.m] ix val)} *) (f32 val)} =>)
    ({([.n] ix val) ([.m] ix val)} *)
    ({[.tile-size] u64} :)
    ({[.k-tiles] u64} :)
    ({[.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} context)
    ({[.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} worker)
    ({
      ({
        (f32 val)
        ({
          ({
            ({[.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} context)
            ({cap.own [.z] f32} buf)
          } writable val)
          ({
            ({[.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} context)
            ({cap.own [.z] f32} buf)
          } writable val)
        } *)
      } *)
      ([.k-tiles] ix val)
    } *)
  })
  ->
  ([p s z n k m k-tiles tile-size.]
    ({
      (f32 val)
      ({
        ({
          ({[.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} context)
          ({cap.own [.z] f32} buf)
        } writable val)
        ({
          ({[.p] ({gpu.block ({[.s z]} dims) topo.end} topo.level)} context)
          ({cap.own [.z] f32} buf)
        } writable val)
      } *)
    } *))
= {[a b c-index tile-size _k-tiles block-context block-worker arg.]
  ([.arg] *.elim [state k-tile.])
  ([.state] *.elim [acc tiles.])
  ([.tiles] *.elim [a-tile b-tile.])
  ([.k-tile] ix.to-u64 [k-tile-u64.])

  ({
    [.block-context]
    [.a-tile]
    ({
      [.a]
      [.c-index]
      [.k-tile-u64]
      [.tile-size]
      [.block-context]
      [.block-worker]
    }
      gpu.f32.tiled-matmul.load-a)
  } parallel.materialize [block-context-1 pending-a.])
  ({
    [.block-context-1]
    [.b-tile]
    ({
      [.b]
      [.c-index]
      [.k-tile-u64]
      [.tile-size]
      [.block-context-1]
      [.block-worker]
    }
      gpu.f32.tiled-matmul.load-b)
  } parallel.materialize [block-context-2 pending-b.])

  ({[.block-context-2] [.pending-a]}
    parallel.await [block-context-3 a-ready.])
  ({[.block-context-3] [.pending-b]}
    parallel.await [block-context-4 b-ready.])

  ({
    [.acc]
    (name.f32.add lift)
    ({[.a-ready] [.b-ready] [.c-index] [.tile-size] [.block-worker]}
      gpu.f32.tiled-matmul.tile-product)
    [.tile-size]
  } reduce [next-acc.])

  ({[.block-context-4] [.a-ready]}
    parallel.release [block-context-5 next-a-tile.])
  ({[.block-context-5] [.b-ready]}
    parallel.release [_block-context next-b-tile.])
  ({[.next-a-tile] [.next-b-tile]} *.intro [next-tiles.])
  ({[.next-acc] [.next-tiles]} *.intro [next-state.])
  [.next-state]
})

# Evaluate one logical C cell selected independently of the physical worker.
(def program gpu.f32.tiled-matmul.cell.kernel :
  ([grid-x grid-y n k m tile-size.] {
    [.n]
    [.m]
    ({({([.n] ix val) ([.k] ix val)} *) (f32 val)} =>)
    ({({([.k] ix val) ([.m] ix val)} *) (f32 val)} =>)
    ({[.k] u64} :)
    ({[.tile-size] u64} :)
    ({({[.tile-size tile-size]} *) u64} :)
    ({[.grid-x] u64} :)
    ({[.grid-y] u64} :)
    ({
      ({
        ({
          gpu.grid
          ({({[.grid-x grid-y]} shape.2d) ({[.grid-x grid-y]} *)} dims)
          ({gpu.block ({({[.tile-size tile-size]} shape.2d) ({[.tile-size tile-size]} *)} dims) topo.end} topo.level)
        } topo.level)
        ({
          gpu.grid
          ({({[.grid-x grid-y]} shape.2d) ({[.grid-x grid-y]} *)} dims)
          ({gpu.block ({({[.tile-size tile-size]} shape.2d) ({[.tile-size tile-size]} *)} dims) topo.end} topo.level)
        } topo.level)
      } context)
      ({
        ({
          ({
            gpu.grid
            ({({[.grid-x grid-y]} shape.2d) ({[.grid-x grid-y]} *)} dims)
            ({gpu.block ({({[.tile-size tile-size]} shape.2d) ({[.tile-size tile-size]} *)} dims) topo.end} topo.level)
          } topo.level)
          ({
            gpu.grid
            ({({[.grid-x grid-y]} shape.2d) ({[.grid-x grid-y]} *)} dims)
            ({gpu.block ({({[.tile-size tile-size]} shape.2d) ({[.tile-size tile-size]} *)} dims) topo.end} topo.level)
          } topo.level)
        } worker)
        ({([.n] ix val) ([.m] ix val)} *)
      } *)
    } *)
  })
  ->
  ([grid-x grid-y n k m tile-size.] (f32 val))
= {[n-param m-param a b k tile-size tile-element-count _grid-x _grid-y work-item.]
  ([.work-item] *.elim [grid-context assignment.])
  # c-index is the logical 2D index of C. The physical worker index is
  # represented independently by grid-worker.
  ([.assignment] *.elim [grid-worker c-index.])
  ({[.grid-context] [.grid-worker]}
    gpu.current-block [block-context-0 block-worker.])
  ([.block-context-0] gpu.f32.tiled-matmul.block-params
    [p-param block-shape-param block-size-param.])

  ([.k] u64.copy-param [k-value k-param.])
  ([.tile-size] u64.copies2-param
    [k-tile-size step-tile-size tile-size-param.])
  ({([.k-value] :.forget) ([.k-tile-size] :.forget)}
    u64.div u64.name [k-tile-count.])

  ({[.block-context-0] [.tile-element-count]}
    parallel.allocate [block-context-1 a-tile.])
  ({[.block-context-1] [.tile-element-count]}
    parallel.allocate [block-context-2 b-tile.])

  ({[.a-tile] [.b-tile]} *.intro [tiles.])
  (const.u32.0x00000000 u32.bitcast-f32 [zero.])
  ({[.zero] [.tiles]} *.intro [initial-state.])

  ([.k-tile-count] u64.copies2-param
    [step-count fold-count k-tiles-param.])
  ({
    [.initial-state]
    ({
      [.p-param]
      [.block-shape-param]
      [.block-size-param]
      [.n-param]
      [.k-param]
      [.m-param]
      [.k-tiles-param]
      [.tile-size-param]
      [.a]
      [.b]
      [.c-index]
      [.step-tile-size]
      [.step-count]
      [.block-context-2]
      [.block-worker]
    } partial.gpu.f32.tiled-matmul.tile-step.7)
    [.fold-count]
  } fold [final-state.])

  ([.final-state] *.elim [result final-tiles.])
  ([.final-tiles] *.elim [_a-tile _b-tile.])
  [.result]
})

# Materialize C in row-major order. Row-major layout is handled only by the
# first producer in the composition; the tiled kernel receives a logical 2D
# C index and is independent of the output layout.
(def program gpu.f32.tiled-matmul.row-major.materialize :
  ([n m k tile-size.] {
    ({[.n] u64} :)
    ({[.m] u64} :)
    ({[.k] u64} :)
    ({({[.n m]} *) u64} :)
    ({[.tile-size] u64} :)
    ({({[.tile-size tile-size]} *) u64} :)
    ({({([.n] ix val) ([.k] ix val)} *) (f32 val)} =>)
    ({({([.k] ix val) ([.m] ix val)} *) (f32 val)} =>)
  })
  ->
  ([n m k tile-size.] ({cap.own ({[.n m]} *) f32} buf val))
= {[n m k output-len tile-size tile-element-count a b.]
  ([.n] u64.copy-params3 [grid-n indices-n kernel-n _n-unused.])
  ([.m] u64.copy-params3 [m-runtime indices-m kernel-m _m-unused.])
  ([.m-runtime] u64.copies2 [grid-m indices-m-len.])
  ([.tile-size] u64.copies6
    [grid-x-tile grid-y-tile block-x block-y kernel-tile-size _tile-unused.])

  ({([.grid-n] :.forget) ([.grid-x-tile] :.forget)}
    u64.div u64.name [grid-x.])
  ({([.grid-m] :.forget) ([.grid-y-tile] :.forget)}
    u64.div u64.name [grid-y.])

  ([.grid-x] u64.copies2 [launch-grid-x kernel-grid-x.])
  ([.grid-y] u64.copies2 [launch-grid-y kernel-grid-y.])
  ([.k] :.ty [kernel-k k-param.])
  ([.kernel-tile-size] :.ty [kernel-tile-size-value tile-size-param.])
  ([.kernel-grid-x] :.ty [kernel-grid-x-value grid-x-param.])
  ([.kernel-grid-y] :.ty [kernel-grid-y-value grid-y-param.])

  ({[.launch-grid-x] [.launch-grid-y] [.block-x] [.block-y]}
    gpu.launch-config.2d [plan.])
  ([.plan] parallel.plan.root-types [typed-plan context-type worker-type.])
  ([.typed-plan] parallel.schedule [grid-context.])
  ({[.grid-context] [.output-len]}
    parallel.allocate [allocated-context output.])

  ({
    [.allocated-context]
    [.output]
    ({
      ({
        ([.context-type] name.identity lift)
        ({
          ([.worker-type] name.identity lift)
          ({[.indices-n] [.indices-m] [.indices-m-len]}
            partial.f32.row-major.indices.1)
        } tensor)
      } tensor)
      ({
        [.grid-x-param]
        [.grid-y-param]
        [.kernel-n]
        [.k-param]
        [.kernel-m]
        [.tile-size-param]
        [.kernel-n]
        [.kernel-m]
        [.a]
        [.b]
        [.kernel-k]
        [.kernel-tile-size-value]
        [.tile-element-count]
        [.kernel-grid-x-value]
        [.kernel-grid-y-value]
      } partial.gpu.f32.tiled-matmul.cell.kernel.9)
    } compose)
  } parallel.materialize [materialized-context pending-output.])
  ({[.materialized-context] [.pending-output]}
    parallel.await [_grid-context result.])
  [.result]
})
