# Tiled GPU matrix multiplication using execution contexts.
#
# This is deliberately ahead of the stdlib. The worker/index helpers used
# below still need definitions.
#
# The topology tail p is expected to have this form:
#
#   topo.level gpu.block block-dims
#     (topo.level gpu.thread thread-dims topo.end)
#
# The complete topology fixes both the grid worker shape and its size:
#
#   topo.level gpu.grid (dims (shape.2d n m) (n * m)) p

(theory program type {
  # Map one cooperative A-tile load to its source matrix coordinate.
  (arr gpu.tiled-matmul.a-tile-to-matrix-index :
    {[p s z q n k tile-size.]
      ({[.p] ({gpu.block ({[.s z]} dims) [.q]} topo.level)} context)
      ({[.p] ({gpu.block ({[.s z]} dims) [.q]} topo.level)} worker)
      (u64 val) # k tile
      ({[.tile-size] u64} :)
      ([.z] ix val) # cooperative tile index
    }
    ->
    ([p s z q n k tile-size.] {([.n] ix val) ([.k] ix val)} *))

  # Map one cooperative B-tile load to its source matrix coordinate.
  (arr gpu.tiled-matmul.b-tile-to-matrix-index :
    {[p s z q k m tile-size.]
      ({[.p] ({gpu.block ({[.s z]} dims) [.q]} topo.level)} context)
      ({[.p] ({gpu.block ({[.s z]} dims) [.q]} topo.level)} worker)
      (u64 val) # k tile
      ({[.tile-size] u64} :)
      ([.z] ix val) # cooperative tile index
    }
    ->
    ([p s z q k m tile-size.] {([.k] ix val) ([.m] ix val)} *))
})

# Load one element of A into the current block's shared tile.
(def program gpu.tiled-matmul.load-a :
  ([p s z q n k tile-size.] {
    ({({([.n] ix val) ([.k] ix val)} *) (f32 val)} =>)
    (u64 val) # k tile
    ({[.tile-size] u64} :)
    ({[.p] ({gpu.block ({[.s z]} dims) [.q]} topo.level)} context)
    ({[.p] ({gpu.block ({[.s z]} dims) [.q]} topo.level)} worker)
    ([.z] ix val)
  })
  ->
  ([p s z q n k tile-size.] (f32 val))
= ([a k-tile tile-size block-context worker tile-index.]
  ({
    ({
      [.block-context]
      [.worker]
      [.k-tile]
      [.tile-size]
    }
    partial.gpu.tiled-matmul.a-tile-to-matrix-index.4)
    [.a]
  }
  compose
  [a-tile-view.])
  ({[.tile-index] [.a-tile-view]} eval)
))

# Load one element of B into the current block's shared tile.
(def program gpu.tiled-matmul.load-b :
  ([p s z q k m tile-size.] {
    ({({([.k] ix val) ([.m] ix val)} *) (f32 val)} =>)
    (u64 val) # k tile
    ({[.tile-size] u64} :)
    ({[.p] ({gpu.block ({[.s z]} dims) [.q]} topo.level)} context)
    ({[.p] ({gpu.block ({[.s z]} dims) [.q]} topo.level)} worker)
    ([.z] ix val)
  })
  ->
  ([p s z q k m tile-size.] (f32 val))
= ([b k-tile tile-size block-context worker tile-index.]
  ({
    ({
      [.block-context]
      [.worker]
      [.k-tile]
      [.tile-size]
    }
    partial.gpu.tiled-matmul.b-tile-to-matrix-index.4)
    [.b]
  }
  compose
  [b-tile-view.])
  ({[.tile-index] [.b-tile-view]} eval)
))

# Produce one product in the dot product for the current output worker.
(def program gpu.tiled-matmul.tile-product-at :
  ([p s z q tile-size.] {
    ({cap.own [.z] f32} buf val)
    ({cap.own [.z] f32} buf val)
    ({[.p] ({gpu.block ({[.s z]} dims) [.q]} topo.level)} worker)
    ({[.tile-size] u64} :)
    ([.tile-size] ix val)
  })
  ->
  ([p s z q tile-size.] (f32 val))
= ([a-tile b-tile block-worker tile-size j.]
  ({[.block-worker] [.j] [.tile-size]}
    gpu.tiled-matmul.tile-indices
    [a-index b-index.])
  ({[.a-index] [.a-tile]} ix [a-value.])
  ({[.b-index] [.b-tile]} ix [b-value.])
  ({[.a-value b-value]} f32.mul)
))

# Produce one k-tile contribution with captured shared buffers.
(def program gpu.tiled-matmul.tile-step :
  ([p s z q n k m k-tiles tile-size.] {
    ({({([.n] ix val) ([.k] ix val)} *) (f32 val)} =>)
    ({({([.k] ix val) ([.m] ix val)} *) (f32 val)} =>)
    ({[.tile-size] u64} :)
    ({[.p] ({gpu.block ({[.s z]} dims) [.q]} topo.level)} context)
    ({[.p] ({gpu.block ({[.s z]} dims) [.q]} topo.level)} worker)
    ({
      ({[.p] ({gpu.block ({[.s z]} dims) [.q]} topo.level)} context)
      ({cap.own [.z] f32} buf)
    } writable val)
    ({
      ({[.p] ({gpu.block ({[.s z]} dims) [.q]} topo.level)} context)
      ({cap.own [.z] f32} buf)
    } writable val)
    ([.k-tiles] ix val)
  })
  ->
  ([p s z q n k m k-tiles tile-size.] (f32 val))
= {[a b tile-size block-context block-worker a-tile b-tile k-tile.]
  ([.k-tile] ix.to-u64 [k-tile-u64.])

  {
    [.block-context]
    [.a-tile]
    {
      [.a]
      [.k-tile-u64]
      [.tile-size]
    }
    partial.gpu.tiled-matmul.load-a.3
  }
  parallel.materialize
  [block-context pending-a.]

  {
    [.block-context]
    [.b-tile]
    {
      [.b]
      [.k-tile-u64]
      [.tile-size]
    }
    partial.gpu.tiled-matmul.load-b.3
  }
  parallel.materialize
  [block-context pending-b.]

  ({[.block-context] [.pending-a]}
    parallel.await
    [block-context a-ready.])
  ({[.block-context] [.pending-b]}
    parallel.await
    [block-context b-ready.])

  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    (name.f32.add lift)
    ({
      [.a-ready]
      [.b-ready]
      [.block-worker]
      [.tile-size]
    }
    partial.gpu.tiled-matmul.tile-product-at.4)
    [.tile-size]
  }
  reduce
  [tile-result.])

  # This second synchronization restores both captured tiles to writable, but
  # standard reduce does not currently enforce that invariant in its types.
  ({[.block-context] [.a-ready]}
    parallel.release
    [block-context _next-a-tile.])
  ({[.block-context] [.b-ready]}
    parallel.release
    [_block-context _next-b-tile.])
  [.tile-result]
})

# Compute one output cell on one grid worker.
(def program gpu.tiled-matmul.cell.kernel :
  ([q n k m k-tiles tile-size.] {
    ({({([.n] ix val) ([.k] ix val)} *) (f32 val)} =>)
    ({({([.k] ix val) ([.m] ix val)} *) (f32 val)} =>)
    ({({[.tile-size tile-size]} *) u64} :) # tile element count
    ({[.k-tiles] u64} :)
    ({[.tile-size] u64} :)
    ({
      ({
        ({
          gpu.grid
          ({({[.n m]} shape.2d) ({[.n m]} *)} dims)
          ({gpu.block ({({[.tile-size tile-size]} shape.2d) ({[.tile-size tile-size]} *)} dims) [.q]} topo.level)
        } topo.level)
        ({
          gpu.grid
          ({({[.n m]} shape.2d) ({[.n m]} *)} dims)
          ({gpu.block ({({[.tile-size tile-size]} shape.2d) ({[.tile-size tile-size]} *)} dims) [.q]} topo.level)
        } topo.level)
      } context)
      ({
        ({
          ({
            gpu.grid
            ({({[.n m]} shape.2d) ({[.n m]} *)} dims)
            ({gpu.block ({({[.tile-size tile-size]} shape.2d) ({[.tile-size tile-size]} *)} dims) [.q]} topo.level)
          } topo.level)
          ({
            gpu.grid
            ({({[.n m]} shape.2d) ({[.n m]} *)} dims)
            ({gpu.block ({({[.tile-size tile-size]} shape.2d) ({[.tile-size tile-size]} *)} dims) [.q]} topo.level)
          } topo.level)
        } worker)
        (({[.n m]} *) ix val)
      } *)
    } *)
  })
  ->
  ([q n k m k-tiles tile-size.] (f32 val))
= {[a b tile-count k-tiles tile-size task.]
  ([.task] *.elim [_grid-context worker-and-index.])
  ([.worker-and-index] *.elim [grid-worker output-index.])
  ([.grid-worker]
    gpu.scope-worker-to-block [block-worker-0.])
  ([.block-worker-0]
    parallel.worker-context [block-context block-worker.])

  ({[.block-context] [.tile-count]}
    parallel.allocate
    [block-context a-tile.])

  ({[.block-context] [.tile-count]}
    parallel.allocate
    [block-context b-tile.])

  ({
    (const.u32.0x00000000 u32.bitcast-f32)
    (name.f32.add lift)
    ({
      [.a]
      [.b]
      [.tile-size]
      [.block-context]
      [.block-worker]
      [.a-tile]
      [.b-tile]
    }
    partial.gpu.tiled-matmul.tile-step.7)
    [.k-tiles]
  }
  reduce
  [result.])
  [.result]
})

# Schedule the grid, allocate C, materialize its cells, then wait for the grid.
(def program gpu.tiled-matmul :
  ([n k m k-tiles tile-size.] {
    ({({([.n] ix val) ([.k] ix val)} *) (f32 val)} =>)
    ({({([.k] ix val) ([.m] ix val)} *) (f32 val)} =>)
    ({({[.n m]} *) u64} :)
    ({({[.tile-size tile-size]} *) u64} :) # tile element count
    ({[.k-tiles] u64} :)
    ({[.tile-size] u64} :)
    ({[.n] u64} :) # physical grid x
    ({[.m] u64} :) # physical grid y
  })
  ->
  ([n k m k-tiles tile-size.]
    ({cap.own ({[.n m]} *) f32} buf val))
= {[a b output-len tile-count k-tiles tile-size
    grid-x grid-y.]
  ([.tile-size] u64.copies3 [kernel-tile-size block-x block-y.])
  ({[.grid-x] [.grid-y] [.block-x] [.block-y]}
    gpu.launch-config.2d [plan.])

  ([.plan] parallel.schedule [launch-context.])

  ({
    [.a]
    [.b]
    [.tile-count]
    [.k-tiles]
    [.kernel-tile-size]
  }
  partial.gpu.tiled-matmul.cell.kernel.5
  [cell-kernel.])

  ({[.launch-context] [.output-len]}
    parallel.allocate
    [launch-context c-buffer.])

  {
    [.launch-context]
    [.c-buffer]
    [.cell-kernel]
  }
    parallel.materialize
    [launch-context pending-c.]

  ({[.launch-context] [.pending-c]}
    parallel.await
    [_launch-context c-ready.])
  [.c-ready]
})
