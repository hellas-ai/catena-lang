# Row-major views over linear GPU global storage.
#
# gpu.f32.tiled-matmul :
#
#   A-view × B-view × dimensions ×
#   (state × ((row × col) × (shared-A × shared-B)))
#   ->
#   state × (C[row,col] × (shared-A × shared-B))
(theory program type {
  # Layout-independent tiled cell producer.
  (def gpu.f32.tiled-matmul : {[
    grid-rows grid-cols
    block-rows block-cols
    inner
  .]
    ({[.grid-rows] [.block-rows]} nat.mul [rows.])
    ({[.grid-cols] [.block-cols]} nat.mul [cols.])

    ({({([.rows] ix val) ([.inner] ix val)} *) (f32 val)} =>)
    ({({([.inner] ix val) ([.cols] ix val)} *) (f32 val)} =>)

    ({[.rows] u64} :)
    ({[.inner] u64} :)
    ({[.cols] u64} :)

    ({([.rows] ix val) ([.cols] ix val)} * [logical-index.])

    ({
      ({[.block-rows] [.block-cols]} nat.mul [shared-len.])
      ({[.shared-len] f32} gpu.shared val)
      ({[.shared-len] f32} gpu.shared val)
    } * [shared.])

    ({[.logical-index] [.shared]} * [resources.])
    ({gpu.state [.resources]} * [kernel-args.])

    ({(f32 val) [.shared]} * [next-resources.])
    ({gpu.state [.next-resources]} * [kernel-coargs.])

    ([.kernel-args])
  } -> ([
    grid-rows grid-cols
    block-rows block-cols
    inner
  .]
    ({
      ({[.block-rows] [.block-cols]} nat.mul [shared-len.])
      ({[.shared-len] f32} gpu.shared val)
      ({[.shared-len] f32} gpu.shared val)
    } * [shared.])

    ({(f32 val) [.shared]} * [next-resources.])
    ({gpu.state [.next-resources]} * [kernel-coargs.])

    ([.kernel-coargs]))
  = ([a-view b-view rows inner cols kernel-args.]
    ([.kernel-args] *.elim [state resources.])
    ([.resources] *.elim [logical-index shared.])

    ([.rows] :.param [row-param.])
    ([.cols] :.param [col-param.])

    ({
      [.row-param]
      [.col-param]
      [.inner]
      [.a-view]
      [.b-view]
      [.logical-index]
    } f32.matmul.cell-dot [value.])

    ({[.value] [.shared]} *.intro [next-resources.])
    ({[.state] [.next-resources]} *.intro)
  ))

  # Map a 2D invocation to logical matrix indices and a flat row-major index.
  (arr gpu.row-major.indexer.2d : {[grid-rows grid-cols block-rows block-cols.]
    ({[.grid-rows] [.block-rows]} nat.mul [rows.])
    ({[.grid-cols] [.block-cols]} nat.mul [cols.])

    ({
      ({[.grid-cols] [.grid-rows]} 2d)
      ({[.block-cols] [.block-rows]} 2d)
    } gpu.grid [grid.])

    ([.grid] gpu.env)
  } -> {[grid-rows grid-cols block-rows block-cols.]
    ({[.grid-rows] [.block-rows]} nat.mul [rows.])
    ({[.grid-cols] [.block-cols]} nat.mul [cols.])

    ({
      ({[.grid-cols] [.grid-rows]} 2d)
      ({[.block-cols] [.block-rows]} 2d)
    } gpu.grid [grid.])

    ({([.rows] ix val) ([.cols] ix val)} * [logical-index.])
    ({[.logical-index] (({[.rows] [.cols]} *) ix val)} *)
  })
})

# Read a flat f32 global allocation with the allocation first, so partial
# application produces an indexed flat view.
(def program gpu.f32.global.row-major.flat-at :
  ([rows cols.] {
    ({
      cap.ref
      ({[.rows] [.cols]} *)
      f32
    } gpu.global val)
    (({[.rows] [.cols]} *) ix val)
  })
  ->
  ([rows cols.] (f32 val))
= ([global i.]
  {[.i] [.global]} gpu.global.ix
))

# Adapt linear global storage to the ordinary row-major matrix-view definition.
(def program gpu.f32.global.row-major.view :
  ([rows cols.] {
    ({[.rows] u64} :)
    ({[.cols] u64} :)
    ({
      cap.ref
      ({[.rows] [.cols]} *)
      f32
    } gpu.global val)
  })
  ->
  ([rows cols.]
    ({({([.rows] ix val) ([.cols] ix val)} *) (f32 val)} =>))
= ([rows cols global.]
  ([.rows] u64.copy-param [view-rows rows-param.])
  ([.cols] u64.copy-param [view-cols cols-param.])

  ({
    [.rows-param]
    [.cols-param]
    [.global]
  } partial.gpu.f32.global.row-major.flat-at.1 [flat-view.])

  ({
    [.view-rows]
    [.view-cols]
    [.flat-view]
  } f32.row-major.matrix-view)
))

# gpu.f32.tiled-matmul.row-major.materialize :
#
#   launch-params × A-view × B-view × dimensions
#   ->
#   C-global
(def program gpu.f32.tiled-matmul.row-major.materialize :
  ([grid-rows grid-cols block-rows block-cols inner.] {
    ({[.grid-rows] [.block-rows]} nat.mul [rows.])
    ({[.grid-cols] [.block-cols]} nat.mul [cols.])

    ({
      ({[.grid-cols] [.grid-rows]} 2d)
      ({[.block-cols] [.block-rows]} 2d)
    } gpu.grid [grid.])
    ([.grid] gpu.launch_params val)

    ({({([.rows] ix val) ([.inner] ix val)} *) (f32 val)} =>)
    ({({([.inner] ix val) ([.cols] ix val)} *) (f32 val)} =>)

    ({[.rows] u64} :)
    ({[.inner] u64} :)
    ({[.cols] u64} :)
    ({({[.rows] [.cols]} *) u64} :)

  })
  ->
  ([grid-rows grid-cols block-rows block-cols inner.]
    ({
      cap.own
      ({
        ({[.grid-rows] [.block-rows]} nat.mul)
        ({[.grid-cols] [.block-cols]} nat.mul)
      } *)
      f32
    } gpu.global val))
= ([
  params
  a-view b-view
  rows inner cols c-size
.]
  ([.inner] u64.copy-param [dimensions-inner inner-param.])

  ([.params] gpu.launch_params.2d-2d.params [
    materialize-params
    grid-cols-param grid-rows-param
    block-cols-param block-rows-param.
  ])

  (({
    [.grid-rows-param]
    [.grid-cols-param]
    [.block-rows-param]
    [.block-cols-param]
  } name.gpu.row-major.indexer.2d) lift [indexer.])

  ({
    [.grid-rows-param]
    [.grid-cols-param]
    [.block-rows-param]
    [.block-cols-param]
    [.inner-param]
    [.a-view]
    [.b-view]
    [.rows]
    [.dimensions-inner]
    [.cols]
  } partial.gpu.f32.tiled-matmul.5 [producer.])

  ({
    [.materialize-params]
    [.c-size]
    [.indexer]
    [.producer]
  } gpu.materialize)
))
