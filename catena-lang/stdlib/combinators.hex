# Program-level combinators.
(theory program type {
  # Reduce over indices with a zero value, an accumulator closure, and an
  # index-to-value closure.
  #
  #   reduce : A ● (A * A => A) ● (ix n => A) ● (n : u64) -> A
  (arr reduce : {[a n.]
    ([.a])
    ([.a a] {* [.a]} =>)
    ({([.n] ix val) ([.a])} =>)
    ({[.n] u64} :)
  } -> ([a n . a]))

  # Closure-converted reduce.
  #
  #   reducec : A ● X ● (X * (A * A) -> A) ● Y ● (Y * ix n -> A) ● (n : u64) -> A
  (arr reducec : {[x y a n.]
    ([.a])
    ([.x])
    {([.a a] * [aa.]) ([.x aa] * [xaa.]) ([.xaa a] -> val)}
    ([.y])
    {({([.y]) ([.n] ix val)} * [yi.]) ([.yi a] -> val)}
    ({[.n] u64} :)
  } -> ([x y a n . a]))

  # Fold an index space while carrying state between iterations.
  #
  #   fold : S ● (S * ix n => S) ● (n : u64) -> S
  (arr fold : {[s n.]
    ([.s])
    ({({[.s] ([.n] ix val)} *) [.s]} =>)
    ({[.n] u64} :)
  } -> ([s n . s]))

  # Closure-converted fold.
  #
  #   foldc : S ● X ● (X * (S * ix n) -> S) ● (n : u64) -> S
  (arr foldc : {[x s n.]
    ([.s])
    ([.x])
    {
      ({[.s] ([.n] ix val)} * [si.])
      ({[.x si]} * [xsi.])
      ([.xsi s] -> val)
    }
    ({[.n] u64} :)
  } -> ([x s n . s]))
})
