# Cooperative thread execution primitives

(theory type nat {
  # Nominal GPU levels. Their dimensions let lowering distinguish kernel
  # launch from block-local cooperative execution.
  (arr gpu.grid.2d : 4 -> 1)
  (arr gpu.block.2d : 2 -> 1)

  # the read-only *environment* available to a GPU kernel.
  # Consists of:
  #   - Thread ID
  #   - Block sizes
  (arr gpu.env : 0 -> 1)

  # A unique type which allows us to force ordering.
  # This of this as a resource which may not ever be consumed or copied.
  (arr gpu.state : 0 -> 1)

  # TODO: add lengths!
  (arr gpu.buf : 1 -> 1)

  # Kernel launch parameters: grid dim and block dim (for now)
  (arr gpu.3d : 0 -> 1)
  (arr gpu.launch_params : 0 -> 1)
})

(theory program type {
  # Reify the GPU-specific root level. This is the only domain-specific value
  # needed by generic plan construction.
  (arr gpu.grid.2d : {[
    grid-x grid-y block-x block-y.
  ]
    ({[.grid-x] u64} :)
    ({[.grid-y] u64} :)
    ({[.block-x] u64} :)
    ({[.block-y] u64} :)
  }
  ->
  ([grid-x grid-y block-x block-y.]
    ({[.grid-x grid-y block-x block-y]} gpu.grid.2d val)))

  # Build a physical 2D GPU plan. The grid context contains every thread and
  # groups them by block. Runtime plan construction uses only generic parallel
  # shape and plan primitives.
  (def gpu.launch-config.2d : {[
    grid-x grid-y block-x block-y.
  ]
    ({[.grid-x] u64} :)
    ({[.grid-y] u64} :)
    ({[.block-x] u64} :)
    ({[.block-y] u64} :)
  }
  ->
  ([grid-x grid-y block-x block-y.]
    ({
      ({[.grid-x grid-y block-x block-y]} gpu.grid.2d)
      ({({[.grid-x grid-y]} *) ({[.block-x block-y]} *)} *)
      ({[.grid-x grid-y]} *)
    } parallel.plan))
  = ([grid-x grid-y block-x block-y.]
    ([.grid-x] u64.copies2 [level-grid-x shape-grid-x.]
      ([.grid-y] u64.copies2 [level-grid-y shape-grid-y.]
        ([.block-x] u64.copies2 [level-block-x shape-block-x.]
          ([.block-y] u64.copies2 [level-block-y shape-block-y.]
            ({
              [.level-grid-x]
              [.level-grid-y]
              [.level-block-x]
              [.level-block-y]
            } gpu.grid.2d [level.]
              ({[.shape-grid-x] [.shape-grid-y]} shape.2d [grid-shape.]
                ({[.shape-block-x] [.shape-block-y]} shape.2d [block-shape.]
                  ({[.level] [.grid-shape] [.block-shape]} parallel.plan)
                )
              )
            )
          )
        )
      )
    )
  ))

  # Scope a grid worker to its containing block.
  (arr gpu.current-block : {[
    grid-x grid-y block-x block-y.
  ]
    ({
      ({[.grid-x grid-y block-x block-y]} gpu.grid.2d)
      ({({[.grid-x grid-y]} *) ({[.block-x block-y]} *)} *)
      ({[.grid-x grid-y]} *)
    } context)
    ({
      ({[.grid-x grid-y block-x block-y]} gpu.grid.2d)
      ({({[.grid-x grid-y]} *) ({[.block-x block-y]} *)} *)
      ({[.grid-x grid-y]} *)
    } worker)
  }
  ->
  ([grid-x grid-y block-x block-y.] {
    ({
      ({[.block-x block-y]} gpu.block.2d)
      ({[.block-x block-y]} *)
      1
    } context)
    ({
      ({[.block-x block-y]} gpu.block.2d)
      ({[.block-x block-y]} *)
      1
    } worker)
  }))

  # Launch parameter construction
  (arr gpu.3d.intro : (u64 val [x . x x x]) -> gpu.3d)
  (arr gpu.launch_params.intro : (gpu.3d val [x . x x]) -> (gpu.launch_params val))

  # store a value to global memory
  #(arr gpu.global.store : gpu.state -> gpu.state)

  # Materialize a buffer by cooperative execution of a kernel `k`,
  # where k is a function pointer of the following type
  #
  #   k : gpu.env × gpu.state × X → gpu.state × B
  #
  # Where `X` is the explicitly-passed *environment* of the kernel (common to
  # all threads).
  #
  # gpu.materialize : gpu.launch_params × (gpu.env × gpu.state × X -> gpu.state × B) -> gpu.buf B
  (arr gpu.materialize : {[x b.]
    ({gpu.state [.x]} * [args_tail.])
    ({gpu.env [.args_tail]} * [args.])

    ({gpu.state [.b]} * [coargs.])

    (gpu.launch_params val)
    ([.args coargs] ->)
  }
  ->
  ([x b.b] gpu.buf val))
})
