# GPU tiled matrix multiplication over logical matrix views.
#
# gpu.f32.tiled-matmul.kernel :
#   A-view × B-view × dimensions ×
#   (row × col)
#   ->
#   C[row,col]
(theory program type {
  # Compute one logical C cell.
  (def gpu.f32.tiled-matmul.kernel : {[rows cols inner tile-size.]
    ({({([.rows] ix val) ([.inner] ix val)} *) (f32 val)} =>)
    ({({([.inner] ix val) ([.cols] ix val)} *) (f32 val)} =>)

    ({[.rows] u64} :)
    ({[.inner] u64} :)
    ({[.cols] u64} :)
    ({[.tile-size] u64} :)
    ({([.rows] ix val) ([.cols] ix val)} *)
  } -> ([rows cols inner tile-size.] (f32 val))
  = ([a-view b-view rows inner cols tile-size logical-index.]
    ([.tile-size] u64.copies2 [tile-rows tile-cols.])
    ({[.tile-rows] [.tile-cols]} u64.product [shared-len.])
    ([.shared-len] u64.copies2 [a-shared-len b-shared-len.])

    ([.a-shared-len] gpu.shared.alloc [a-shared.])
    ([.b-shared-len] gpu.shared.alloc [b-shared.])

    ([.rows] :.param [row-param.])
    ([.cols] :.param [col-param.])

    ({
      [.row-param]
      [.col-param]
      [.inner]
      [.a-view]
      [.b-view]
      [.logical-index]
    } f32.matmul.cell-dot [value.])

    ([.b-shared] gpu.shared.end [_b-shared-len-param.])
    ([.a-shared] gpu.shared.end [_a-shared-len-param.])
    [.value]
  ))

})

# Exact dimension division.
(def program u64.perfect-div :
  ([n divisor.] {
    ({[.n] u64} :)
    ({[.divisor] u64} :)
  })
  ->
  ([n divisor.] ({({[.n] [.divisor]} nat.div) u64} :))
= ([n divisor.]
  ([.divisor] u64.copies2 [divisor-for-positive divisor-for-div.])
  ([.divisor-for-positive] u64.assert-nz [divisor-positive.])
  ({[.n] [.divisor-for-div] [.divisor-positive]} u64.div [
    quotient exact.
  ])
  ([.exact] assert [_perfect-tiling.])
  [.quotient]
))

# Launch geometry for square, perfectly tiled matrix multiplication.
(def program gpu.tiled-matmul.perfect-launch-params :
  ([rows cols inner tile-size.] {
    ({[.rows] u64} :)
    ({[.cols] u64} :)
    ({[.inner] u64} :)
    ({[.tile-size] u64} :)
  })
  ->
  ([rows cols inner tile-size.]
    {
      ({
        ({
          ({[.cols] [.tile-size]} nat.div)
          ({[.rows] [.tile-size]} nat.div)
        } 2d)
        ({[.tile-size] [.tile-size]} 2d)
      } gpu.grid [grid.])
      ([.grid] gpu.launch_params val)
      ({({[.inner] [.tile-size]} nat.div) u64} :)
    }
  )
= ([rows cols inner tile-size.]
  ([.tile-size] u64.copies5 [
    tile-for-rows
    tile-for-cols
    tile-for-inner
    block-cols
    block-rows.
  ])
  ({[.rows] [.tile-for-rows]} u64.perfect-div [grid-rows.])
  ({[.cols] [.tile-for-cols]} u64.perfect-div [grid-cols.])
  ({[.inner] [.tile-for-inner]} u64.perfect-div [inner-tile-count.])

  ({[.grid-cols] [.grid-rows]}
    gpu.dimensions.2d.intro [grid.])
  ({[.block-cols] [.block-rows]} gpu.dimensions.2d.intro [block.])
  ({[.grid] [.block]} gpu.launch_params.intro [params.])
  {[.params] [.inner-tile-count]}
))

# Row-major global views.

# Read one element from linear global storage.
(def program gpu.f32.global.row-major.flat-at :
  ([rows cols.] {
    ({
      cap.ref
      ({[.rows] [.cols]} *)
      f32
    } gpu.global val)
    (({[.rows] [.cols]} *) ix val)
  })
  ->
  ([rows cols.] (f32 val))
= ([global i.]
  {[.i] [.global]} gpu.global.ix
))

# Present linear global storage as a row-major matrix.
(def program gpu.f32.global.row-major.view :
  ([rows cols.] {
    ({[.rows] u64} :)
    ({[.cols] u64} :)
    ({
      cap.ref
      ({[.rows] [.cols]} *)
      f32
    } gpu.global val)
  })
  ->
  ([rows cols.]
    ({({([.rows] ix val) ([.cols] ix val)} *) (f32 val)} =>))
= ([rows cols global.]
  ([.rows] u64.copy-param [view-rows rows-param.])
  ([.cols] u64.copy-param [view-cols cols-param.])

  ({
    [.rows-param]
    [.cols-param]
    [.global]
  } partial.gpu.f32.global.row-major.flat-at.1 [flat-view.])

  ({
    [.view-rows]
    [.view-cols]
    [.flat-view]
  } f32.row-major.matrix-view)
))

# Row-major tiled-matmul materialization.
# gpu.f32.tiled-matmul.row-major.materialize :
#   launch-params × A-view × B-view × dimensions
#   ->
#   C-global
(def program gpu.f32.tiled-matmul.row-major.materialize :
  ([rows cols inner tile-size grid-rows grid-cols.] {
    ({
      ({[.grid-cols] [.grid-rows]} 2d)
      ({[.tile-size] [.tile-size]} 2d)
    } gpu.grid [grid.])
    ([.grid] gpu.launch_params val)

    ({({([.rows] ix val) ([.inner] ix val)} *) (f32 val)} =>)
    ({({([.inner] ix val) ([.cols] ix val)} *) (f32 val)} =>)

    ({[.rows] u64} :)
    ({[.inner] u64} :)
    ({[.cols] u64} :)
    ({[.tile-size] u64} :)

  })
  ->
  ([rows cols inner tile-size grid-rows grid-cols.]
    ({cap.own ({[.rows] [.cols]} *) f32} gpu.global val))
= ([
  params
  a-view b-view
  rows inner cols tile-size
.]
  ([.rows] u64.copies2-param [
    dimensions-rows c-size-rows rows-param.
  ])
  ([.inner] u64.copy-param [dimensions-inner inner-param.])
  ([.cols] u64.copies3 [
    dimensions-cols c-size-cols indices-cols.
  ])
  ([.indices-cols] u64.copy-param [indices-cols-len cols-param.])
  ({[.c-size-rows] [.c-size-cols]} u64.product [c-size.])

  ([.params] gpu.launch_params.2d-2d.params [
    materialize-params
    _grid-cols-param _grid-rows-param
    tile-size-param _tile-size-param.
  ])

  ({
    ({
      [.rows-param]
      [.cols-param]
      [.indices-cols-len]
    } partial.f32.row-major.indices.1)
    ({
      [.rows-param]
      [.cols-param]
      [.inner-param]
      [.tile-size-param]
      [.a-view]
      [.b-view]
      [.dimensions-rows]
      [.dimensions-inner]
      [.dimensions-cols]
      [.tile-size]
    } partial.gpu.f32.tiled-matmul.kernel.6)
  } compose [kernel.])

  ({
    [.materialize-params]
    [.c-size]
    [.kernel]
  } gpu.materialize)
))
