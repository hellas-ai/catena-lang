# Same shape as post-eval-product-escape, but with the partial application
# expanded by hand from ordinary CMC operations. There is no `partial` here.

(def program post-eval-product-body :
  {({1 (bool val)} =>) (bool val) (bool val)}
  ->
  (bool val)
= {[closed result input.]
  ([.closed] run [_closed-result.])
  ([.input] bool.not [_ignored.])
  [.result]
})

# Typed structural helpers for the pair carried while the first captured value
# is prepended. They are the concrete identity and left unitor used by the
# generated partial expansion, written here without invoking `partial`.
(def program bool-pair-id :
  ({(bool val) (bool val)} *)
  ->
  ({(bool val) (bool val)} *)
= [pair])

(def program bool-pair-li :
  ({(bool val) (bool val)} *)
  ->
  {1 ({(bool val) (bool val)} *)}
= ([pair.]
  {unit.intro [.pair]}
))

(def program manual-post-eval-product-escape :
  []
  ->
  (bool val)
= (
  # First build input => (result * input).
  (bool.f defer [deferred-result.])
  ({[.deferred-result] (name.bool.id lift)} tensor [prepend-result.])
  ({(name.bool.li lift) [.prepend-result]} compose [result-and-input.])

  # Then build (result * input) => (closed * (result * input)).
  (bool.t defer [closed.])
  ([.closed] defer [deferred-closed.])
  ({[.deferred-closed] (name.bool-pair-id lift)} tensor [prepend-closed.])
  ({(name.bool-pair-li lift) [.prepend-closed]} compose [add-closed.])

  # Compose the captured arguments with the original three-argument body.
  ({[.result-and-input] [.add-closed]} compose [captured-inputs.])
  ({[.captured-inputs] (name.post-eval-product-body lift)} compose [outer.])

  # The manually built closure remains the second branch of the only bool.if.
  ({(name.bool.id lift) [.outer] bool.t bool.f} bool.if)
))
