(theory type nat {
  (arr bool : 0 -> 1)
  (arr bool.t : 0 -> 1)
  (arr bool.f : 0 -> 1)
  (arr u64 : 0 -> 1)
  (arr u64.lt : 2 -> 1)
  (arr u64.lte : 2 -> 1)
  (arr u32 : 0 -> 1)
  (arr f32 : 0 -> 1)
})

(theory program type {
  # Convert a true runtime predicate into logical evidence. This operation is
  # partial: a false predicate stops the current execution.
  (arr assert : ({[b] bool} :) -> ({[b] bool.t} = |-))

  (def assert-then : {[b p.]
    ({[.b] bool} :)
    ({({[.b] bool.t} =) [.p]} ==> |-)
  } -> ([b p . p] |-) = ({assert [is-true]} ax-mp))

  (arr bool.t : [] -> (bool val))
  (arr bool.f : [] -> (bool val))
  (arr bool.not : (bool val) -> (bool val))
  (arr bool.or : {(bool val) (bool val)} -> (bool val))
  (arr bool.and : {(bool val) (bool val)} -> (bool val))
  (arr bool.select : {(bool val) (bool val) (bool val)} -> (bool val))
  (arr bool.name : {[x.] (bool val)} -> ([x.] ({[.x] bool} :)))

  # Arithmetic used by element-polymorphic definitions. Concrete generated
  # code instantiates these operations for the selected element type.
  (arr scalar.zero : {[element-type.] [.element-type]}
    -> ([element-type.] [.element-type] val))
  (arr scalar.add : {[element-type.]
    ([.element-type] val)
    ([.element-type] val)
  } -> ([element-type.] [.element-type] val))
  (arr scalar.mul : {[element-type.]
    ([.element-type] val)
    ([.element-type] val)
  } -> ([element-type.] [.element-type] val))

  # First-order conditional over already-converted branches. Environments and
  # function names are explicit; source closures and closure conversion remain
  # outside this minimal compiler.
  (arr bool.ifc : {[x y a b.]
    ([.x])
    ([.x a] {* [.b]} -> val)
    ([.y])
    ([.y a] {* [.b]} -> val)
    (bool val)
    ([.a])
  } -> ([x y a b . b]))

  (arr u64.zero : [] -> (u64 val))
  (arr u64.one : [] -> (u64 val))
  (arr u64.add : {(u64 val) (u64 val)} -> (u64 val))
  (arr u64.sub : {(u64 val) (u64 val)} -> (u64 val))
  (arr u64.ne : {(u64 val) (u64 val)} -> (bool val))
  (arr u64.lt : {[x y decision.]
    ({[.x] u64} :)
    ({[.y] u64} :)
  } -> {[x y decision.]
    ({[.decision] bool.t} = [decision-true.])
    ({[.decision] bool.f} = [decision-false.])
    ([.x y] u64.lt [is-less.])
    ({[.decision] bool} :)
    ([.decision-true is-less] ==> |-)
    ([.is-less] {[.decision-false] not} ==> |-)
  })
  (arr u64.lte : {[x y decision.]
    ({[.x] u64} :)
    ({[.y] u64} :)
  } -> {[x y decision.]
    ({[.decision] bool.t} = [decision-true.])
    ([.x y] u64.lte [fits.])
    ({[.decision] bool} :)
    ([.decision-true fits] ==> |-)
  })
  (arr u64.gte : {(u64 val) (u64 val)} -> (bool val))
  (arr u64.mul : {(u64 val) (u64 val)} -> (u64 val))
  (arr u64.div : {(u64 val) (u64 val)} -> (u64 val))
  (arr u64.rem : {(u64 val) (u64 val)} -> (u64 val))
  (arr u64.name : {[x.] (u64 val)} -> ([x.] ({[.x] u64} :)))
  (arr u64.copies2 : {[x.]
    ({[.x] u64} :)
  } -> {[x.]
    ({[.x] u64} :)
    ({[.x] u64} :)
  })
  (arr u64.select : {(bool val) (u64 val) (u64 val)} -> (u64 val))
  (arr u64.to-f32 : (u64 val) -> (f32 val))

  (arr u32.zero : [] -> (u32 val))
  (arr u32.one : [] -> (u32 val))
  (arr u32.add : {(u32 val) (u32 val)} -> (u32 val))
  (arr u32.sub : {(u32 val) (u32 val)} -> (u32 val))
  (arr u32.and : {(u32 val) (u32 val)} -> (u32 val))
  (arr u32.or : {(u32 val) (u32 val)} -> (u32 val))
  (arr u32.xor : {(u32 val) (u32 val)} -> (u32 val))
  (arr u32.not : (u32 val) -> (u32 val))
  (arr u32.eq : {(u32 val) (u32 val)} -> (bool val))
  (arr u32.ne : {(u32 val) (u32 val)} -> (bool val))
  (arr u32.lt : {(u32 val) (u32 val)} -> (bool val))
  (arr u32.gt : {(u32 val) (u32 val)} -> (bool val))
  (arr u32.lte : {(u32 val) (u32 val)} -> (bool val))
  (arr u32.gte : {(u32 val) (u32 val)} -> (bool val))
  (arr u32.mul : {(u32 val) (u32 val)} -> (u32 val))
  (arr u32.shl : {(u32 val) (u32 val)} -> (u32 val))
  (arr u32.shr : {(u32 val) (u32 val)} -> (u32 val))
  (arr u32.select : {(bool val) (u32 val) (u32 val)} -> (u32 val))
  (arr u32.to-f32 : (u32 val) -> (f32 val))
  (arr u32.bitcast-f32 : (u32 val) -> (f32 val))

  (arr f32.one : [] -> (f32 val))
  (arr f32.add : {(f32 val) (f32 val)} -> (f32 val))
  (arr f32.sub : {(f32 val) (f32 val)} -> (f32 val))
  (arr f32.neg : (f32 val) -> (f32 val))
  (arr f32.mul : {(f32 val) (f32 val)} -> (f32 val))
  (arr f32.fma : {(f32 val) (f32 val) (f32 val)} -> (f32 val))
  (arr f32.div : {(f32 val) (f32 val)} -> (f32 val))
  (arr f32.lt : {(f32 val) (f32 val)} -> (bool val))
  (arr f32.eq : {(f32 val) (f32 val)} -> (bool val))
  (arr f32.ne : {(f32 val) (f32 val)} -> (bool val))
  (arr f32.gt : {(f32 val) (f32 val)} -> (bool val))
  (arr f32.lte : {(f32 val) (f32 val)} -> (bool val))
  (arr f32.gte : {(f32 val) (f32 val)} -> (bool val))
  (arr f32.select : {(bool val) (f32 val) (f32 val)} -> (f32 val))
  (arr f32.round-to-u32 : (f32 val) -> (u32 val))
  (arr f32.bitcast-u32 : (f32 val) -> (u32 val))

})
