# Tiled matrix multiplication kernel scaffold. The arithmetic still forwards
# to the naive kernel, while this fold establishes the synchronization shape
# that the shared-memory implementation will use.

(theory type nat {
  (arr gpu.tiled.wr : 0 -> 1)
  (arr gpu.tiled.rw : 0 -> 1)
})

(def program gpu.global.matrix.tiled-matmul.barrier-fold-step : {[
  count grid-shape block-shape global-shape thread cell shared.
]
  ({({[.count]} shape.1d)} ix val)
  ({
    ({({
      [.grid-shape]
      [.block-shape]
      [.global-shape]
    } gpu.grid)} gpu.thread val)
    ({[.thread cell shared]} gpu.shared.owns |-)
  } *)
  ({
    ({
      [.grid-shape]
      [.block-shape]
      [.global-shape]
    } gpu.grid)
    ({
      ({
        gpu.tiled.wr
        ({[.thread cell shared]} gpu.shared.owns |-)
        ({[.thread shared]} gpu.shared.reads |-)
      } gpu.barrier.step)
      ({
        ({
          gpu.tiled.rw
          ({[.thread shared]} gpu.shared.reads |-)
          ({[.thread cell shared]} gpu.shared.owns |-)
        } gpu.barrier.step)
        gpu.barrier.trace.end
      } gpu.barrier.trace.sync)
    }
      gpu.barrier.trace.sync)
  } gpu.barrier.cursor |-)
} -> {[
  count grid-shape block-shape global-shape thread cell shared.
]
  ({
    ({({
      [.grid-shape]
      [.block-shape]
      [.global-shape]
    } gpu.grid)} gpu.thread val)
    ({[.thread cell shared]} gpu.shared.owns |-)
  } *)
  ({
    ({
      [.grid-shape]
      [.block-shape]
      [.global-shape]
    } gpu.grid)
    gpu.barrier.trace.end
  } gpu.barrier.cursor |-)
} = ([iteration-index state barriers.]
  ([.iteration-index] ix.forget)

  ([.state] *.elim [thread own.])
  ([.thread] gpu.thread.block [thread-after-block block.])

  # write -> read
  ({
    [.block]
    [.barriers]
    [.own]
  } gpu.sync [
    block-after-wr
    barriers-after-wr
    read.
  ])

  # read -> write
  ({
    [.block-after-wr]
    [.barriers-after-wr]
    [.read]
  } gpu.sync [
    _block-after-rw
    barriers-after-rw
    own-again.
  ])

  ({[.thread-after-block own-again]} *.intro [state-after-rw.])
  [.state-after-rw barriers-after-rw]
))

(def program gpu.global.matrix.tiled-matmul.kernel : {[
  element-type c-buffer-name c-size a-buffer-name a-size b-buffer-name b-size
  grid-shape block-shape global-columns global-rows
  c-schedule-name
  output-rows shared-size output-columns tile-elements
  thread-name cell-name shared-name.
]
  ({
    ({
      [.tile-elements element-type]
      ({[.tile-elements element-type] gpu.shared.empty} gpu.shared.slot)
    } gpu.shared.slot gpu.shared.layout val)
    ({
    ({
      ({[.c-size] u64} :)
      ({
        ({[.c-buffer-name]
          ({cap.own [.c-size element-type]} gpu.global)} :)
        ({
          ({
            [.c-buffer-name c-size]
            ({
              [.grid-shape]
              [.block-shape]
              ({[.global-columns global-rows]} shape.2d)
            } gpu.grid)
            [.c-schedule-name]
          } gpu.scheduling val)
          ({
            [.c-buffer-name]
            ({[.element-type]
              ({
                ([.element-type] gpu.numeric |-)
                ({[.grid-shape]
                  ({[.block-shape]
                    ({({[.global-columns global-rows]} shape.2d)
                      [.c-schedule-name]} *)} *)} *)
              } *)} *)
          } *)
        } *)
      } *)
    } *)
    ({
      ({
        ({[.a-size] u64} :)
        ({
          ({[.a-buffer-name]
            ({cap.ref [.a-size element-type]} gpu.global)} :)
          ({[.a-buffer-name] [.a-size]} *)
        } *)
      } *)
      ({
        ({
          ({[.b-size] u64} :)
          ({
            ({[.b-buffer-name]
              ({cap.ref [.b-size element-type]} gpu.global)} :)
            ({[.b-buffer-name] [.b-size]} *)
          } *)
        } *)
        ({
          ({[.output-rows] u64} :)
          ({({[.shared-size] u64} :) ({[.output-columns] u64} :)} *)
        } *)
      } *)
    } *)
    } *)
  } *)
  ({({
    [.grid-shape]
    [.block-shape]
    ({[.global-columns global-rows]} shape.2d)
  } gpu.grid)} gpu.thread val)
  ({
    ({
      [.grid-shape]
      [.block-shape]
      ({[.global-columns global-rows]} shape.2d)
    } gpu.grid)
    ({
      [.shared-size]
      ({
        ({
          gpu.tiled.wr
          ({[.thread-name cell-name shared-name]} gpu.shared.owns |-)
          ({[.thread-name shared-name]} gpu.shared.reads |-)
        } gpu.barrier.step)
        ({
          ({
            gpu.tiled.rw
            ({[.thread-name shared-name]} gpu.shared.reads |-)
            ({[.thread-name cell-name shared-name]} gpu.shared.owns |-)
          } gpu.barrier.step)
          gpu.barrier.trace.end
        } gpu.barrier.trace.sync)
      } gpu.barrier.trace.sync)
      gpu.barrier.trace.end
    } gpu.barrier.trace.repeat)
  } gpu.barrier.cursor |-)
} -> {[
  element-type c-buffer-name c-size a-buffer-name a-size b-buffer-name b-size
  grid-shape block-shape global-columns global-rows
  c-schedule-name
  output-rows shared-size output-columns tile-elements
  thread-name cell-name shared-name.
]
  ({
    [.c-buffer-name c-size]
    ({
      [.grid-shape]
      [.block-shape]
      ({[.global-columns global-rows]} shape.2d)
    } gpu.grid)
    [.c-schedule-name]
  } gpu.scheduling val)
  ({
    ({
      [.grid-shape]
      [.block-shape]
      ({[.global-columns global-rows]} shape.2d)
    } gpu.grid)
    gpu.barrier.trace.end
  } gpu.barrier.cursor |-)
} = ([layout-and-kernel-arguments thread barriers.]
  ([.layout-and-kernel-arguments]
    *.elim
    [shared-layout kernel-arguments.])
  # shared-size is a scalar kernel argument and therefore block-uniform.
  ([.kernel-arguments] *.elim [c-arguments a-b-and-dimensions.])
  ([.c-arguments] *.elim [_c-length c-tail.])
  ([.c-tail] *.elim [_c-buffer c-schedule-and-context.])
  ([.c-schedule-and-context] *.elim [_c-scheduling c-context.])
  ([.c-context] *.elim [_c-buffer-name element-and-grid-context.])
  ([.element-and-grid-context] *.elim [_element-type numeric-and-grid-context.])
  ([.numeric-and-grid-context] *.elim [_numeric-proof grid-context.])
  ([.grid-context] *.elim [grid-shape-value block-context.])
  ([.block-context] *.elim [block-shape-value global-context.])
  ([.global-context] *.elim [global-shape-value _schedule-name.])
  ([.a-b-and-dimensions] *.elim [_a-arguments b-and-dimensions.])
  ([.b-and-dimensions] *.elim [_b-arguments dimensions.])
  ([.dimensions] *.elim [_output-rows shared-and-columns.])
  ([.shared-and-columns] *.elim [shared-size _output-columns.])
  ([.shared-size] u64.copies2 [shared-size-for-fold shared-size-for-name.])
  ([.shared-size-for-name] :.param [shared-size-name.])

  # Bind the runtime resources to the identities declared by the trace, then
  # obtain the actual initial ownership proof from the shared schedule.
  ([.barriers]
    gpu.barrier.shared.resources
    [barriers-for-fold thread-name-for-bind cell-name-for-bind
      shared-name-for-bind.])
  ([.thread] gpu.thread.in-block.index [thread-for-name cell.])
  ({[.cell cell-name-for-bind]} ix.with-name [named-cell.])
  ({[.thread-for-name thread-name-for-bind]}
    gpu.thread.with-name
    [named-thread.])
  ({[.shared-layout shared-name-for-bind]}
    gpu.shared.layout.with-name
    [named-shared.])
  ({[.named-shared named-thread named-cell]}
    gpu.schedule.shared.can-own
    [named-shared-after-schedule named-thread-after-schedule
      named-cell-after-schedule allowed owns-if-allowed
      _not-owns-if-denied.])
  ({[.allowed owns-if-allowed]} assert-then [own.])

  ([.named-thread-after-schedule]
    :.ty
    [thread-for-forget thread-name.])
  ([.thread-for-forget] :.forget [thread-for-fold.])
  ([.named-cell-after-schedule] :.ty [_cell-after-schedule cell-name.])
  ([.named-shared-after-schedule]
    :.ty
    [_shared-after-schedule shared-name.])

  ({[.thread-for-fold own]} *.intro [fold-state.])
  ({
    [.fold-state]
    [.shared-size-for-fold]
    [.barriers-for-fold]
    ({[
      .shared-size-name grid-shape-value block-shape-value global-shape-value
      thread-name cell-name shared-name
    ]}
      name.gpu.global.matrix.tiled-matmul.barrier-fold-step)
  } gpu.fold [fold-state-after-fold barriers-after-fold.])
  ([.fold-state-after-fold] *.elim [thread-after-fold _own-after-fold.])
  (gpu.shared.layout.empty [empty-shared-layout.])
  ({[.empty-shared-layout kernel-arguments]}
    *.intro
    [naive-layout-and-kernel-arguments.])
  ({[.naive-layout-and-kernel-arguments thread-after-fold barriers-after-fold]}
    gpu.global.matrix.matmul.kernel
    [scheduling barriers-after-naive.])
  [.scheduling barriers-after-naive]
))
