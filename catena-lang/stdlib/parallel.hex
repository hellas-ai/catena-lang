# Execution contexts and workers
(theory type nat {
  # A context describes one execution level, its total worker count, and the
  # number of groups at the next scope. Lowering interprets the nominal level.
  (arr context : 3 -> 1)
  (arr worker : 3 -> 1)
})

(theory program type {
  # Build an execution context from topology-specific metadata and runtime
  # parameters. The metadata is type-level and erases before codegen.
  (arr parallel.context : {[
    level workers groups parameters.
  ]
    [.level]
    [.workers]
    [.groups]
    [.parameters]
  }
  ->
  ([level workers groups parameters.]
    ({[.level workers groups]} context)))

  # Expose the context associated with a worker while preserving the worker
  # for indexing and domain-specific scoping.
  (arr parallel.worker-context :
    ({[level workers groups.] [.level workers groups]} worker)
    ->
    ([level workers groups.] {
      ({[.level workers groups]} context)
      ({[.level workers groups]} worker)
    }))

  # Return the current worker's flat physical index in this context.
  (arr parallel.worker-index : {[level workers groups.]
    ({[.level workers groups]} context)
    ({[.level workers groups]} worker)
  }
  ->
  ([level workers groups.] ([.workers] ix val)))

  # Allocate an owned f32 buffer in an execution context. Its size is
  # independent of the context's worker and group counts.
  (arr parallel.allocate : {[level workers groups n.]
    ({[.level workers groups]} context)
    ({[.n] u64} :)
  }
  ->
  ([level workers groups n.] {
    ({[.level workers groups]} context)
    ({
      ({[.level workers groups]} context)
      ({cap.own [.n] f32} buf)
    } writable val)
  }))

  # Synchronize after writes, making a pending buffer visible to this
  # context's workers. The bare buffer loses its context association.
  (arr parallel.await : {[level workers groups m n.]
    ({[.level workers groups]} context)
    ({
      ({[.level workers groups]} context)
      ({[.m n] f32} buf)
    } pending val)
  }
  ->
  ([level workers groups m n.] {
    ({[.level workers groups]} context)
    ({[.m n] f32} buf val)
  }))

  # Synchronize after reads. This must wait for slower readers before another
  # iteration writes into shared storage. TODO: track the released buffers in
  # the type once buffer ownership is threaded back out of reader closures.
  (arr parallel.release :
    ({[level workers groups.] [.level workers groups]} context)
    ->
    ({[level workers groups.] [.level workers groups]} context))

  # Synchronize workers in one context without changing buffer state.
  (arr parallel.barrier :
    ({[level workers groups.] [.level workers groups]} context)
    ->
    ({[level workers groups.] [.level workers groups]} context))

  # Materialize a logical output space on a physical context. The worker count
  # and output count are intentionally independent; the scheduling policy maps
  # logical work items to physical workers.
  (arr parallel.materialize : {[
    level workers groups output-count.
  ]
    ({[.level workers groups]} context)
    ({
      ({[.level workers groups]} context)
      ({cap.own [.output-count] f32} buf)
    } writable val)
    ({
      ({
        ({[.level workers groups]} worker)
        ([.output-count] ix val)
      } *)
      (f32 val)
    } =>)
  }
  ->
  ([level workers groups output-count.] {
    ({[.level workers groups]} context)
    ({
      ({[.level workers groups]} context)
      ({cap.own [.output-count] f32} buf)
    } pending val)
  }))

  # Closure-converted form of parallel.materialize. The producer's captured
  # environment and function pointer replace its source-level closure value.
  (arr parallel.materializec : {[
    environment level workers groups output-count.
  ]
    ({[.level workers groups]} context)
    ({
      ({[.level workers groups]} context)
      ({cap.own [.output-count] f32} buf)
    } writable val)
    ([.environment])
    ({
      ({
        ([.environment])
        ({
          ({[.level workers groups]} worker)
          ([.output-count] ix val)
        } *)
      } *)
      (f32 val)
    } -> val)
  }
  ->
  ([environment level workers groups output-count.] {
    ({[.level workers groups]} context)
    ({
      ({[.level workers groups]} context)
      ({cap.own [.output-count] f32} buf)
    } pending val)
  }))
})
